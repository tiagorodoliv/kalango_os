// Painel rápido (canto direito da barra, como o menu do sistema do Ubuntu):
// volume, brilho, Wi-Fi, estilo escuro, bateria, Configurações, bloquear e
// desligar/reiniciar/suspender/sair. Só o que funciona de verdade: o brilho
// aparece só com tela ajustável e o Wi-Fi só com placa de Wi-Fi.
//
// Na sessão real é um processo próprio (`--quick-settings`, tela cheia e
// transparente, por cima dos apps); no protótipo, uma camada da área de
// trabalho. Clicar fora do card ou Esc fecha.

import { Theme, ThemeMode } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Shell } from "../globals.slint";
import { Device } from "../device.slint";
import { SliderBar, LinkText } from "../components/widgets.slint";
import { WifiList } from "../components/wifi_list.slint";
import { BatteryIcon } from "../components/battery_icon.slint";

/// Botão redondo com ícone (linha de cima do painel).
component RoundButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <color> hover-color: Theme.text;
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: self.height / 2;
    background: root.active ? Theme.accent.with-alpha(0.22) : touch.has-hover ? Theme.tile-hover : Theme.tile;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    animate background { duration: Theme.anim; }

    Image {
        source: root.icon;
        colorize: root.active ? Theme.accent : touch.has-hover ? root.hover-color : Theme.text;
        width: 17px;
        height: 17px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Linha de slider com o ícone à esquerda (volume, brilho).
component SliderRow inherits Rectangle {
    in property <image> icon;
    in-out property <float> value;
    /// Ícone clicável (o do volume liga/desliga o mudo).
    in property <bool> icon-clickable: false;
    /// Setinha à direita (volume: escolher a saída de som).
    in property <bool> has-details: false;
    in property <bool> details-open: false;
    callback icon-clicked();
    callback changed(float);
    callback details();

    height: 40px;
    Rectangle {
        x: 0;
        width: 36px;
        height: 36px;
        border-radius: self.height / 2;
        background: root.icon-clickable && icon-touch.has-hover ? Theme.tile-hover : transparent;
        Image {
            source: root.icon;
            colorize: Theme.text;
            width: 18px;
            height: 18px;
        }
        icon-touch := TouchArea {
            enabled: root.icon-clickable;
            mouse-cursor: root.icon-clickable ? pointer : default;
            clicked => { root.icon-clicked(); }
        }
    }
    SliderBar {
        x: 46px;
        width: parent.width - 52px - (root.has-details ? 40px : 0);
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
    if root.has-details: Rectangle {
        x: parent.width - 36px;
        width: 36px;
        height: 36px;
        border-radius: self.height / 2;
        background: root.details-open ? Theme.accent-soft : details-touch.has-hover ? Theme.tile-hover : transparent;
        Image {
            source: root.details-open ? Icons.chevron-down : Icons.chevron-right;
            colorize: root.details-open ? Theme.accent : Theme.text;
            width: 16px;
            height: 16px;
        }
        details-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.details(); }
        }
    }
}

/// Botão grande liga/desliga (Wi-Fi, estilo escuro). A setinha à direita,
/// quando há, abre a página das Configurações sobre o assunto.
component Tile inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> on: false;
    in property <bool> has-details: false;
    /// O detalhe está aberto (a setinha aponta para baixo).
    in property <bool> details-open: false;
    callback toggled();
    callback details();

    height: 56px;
    border-radius: 28px;
    background: root.on ? Theme.accent : main-touch.has-hover ? Theme.tile-hover : Theme.tile;
    border-width: root.on ? 0 : 1px;
    border-color: Theme.border;
    animate background { duration: Theme.anim; }
    property <color> fg: root.on ? Theme.on-accent : Theme.text;

    main-touch := TouchArea {
        width: root.has-details ? parent.width - 44px : parent.width;
        x: 0;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    Image {
        x: 16px;
        source: root.icon;
        colorize: root.fg;
        width: 18px;
        height: 18px;
    }
    VerticalLayout {
        x: 46px;
        width: parent.width - 46px - (root.has-details ? 44px : 12px);
        alignment: center;
        Text {
            text: root.title;
            color: root.fg;
            font-size: 13.5px;
            font-weight: 600;
            overflow: elide;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: root.on ? Theme.on-accent.with-alpha(0.8) : Theme.text-muted;
            font-size: 11.5px;
            overflow: elide;
        }
    }
    if root.has-details: Rectangle {
        x: parent.width - 44px;
        width: 44px;
        // Divisória entre a parte que liga/desliga e a setinha.
        Rectangle {
            x: 0;
            width: 1px;
            height: 26px;
            background: root.fg.with-alpha(0.25);
        }
        Image {
            source: root.details-open ? Icons.chevron-down : Icons.chevron-right;
            colorize: details-touch.has-hover ? (root.on ? Theme.on-accent : Theme.accent) : root.fg;
            width: 16px;
            height: 16px;
        }
        details-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.details(); }
        }
    }
}

/// Item do submenu de energia.
component PowerItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();

    height: 38px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.tile-hover : transparent;
    Image {
        x: 12px;
        source: root.icon;
        colorize: root.danger && touch.has-hover ? Theme.danger : Theme.text;
        width: 16px;
        height: 16px;
    }
    Text {
        x: 40px;
        text: root.text;
        color: root.danger && touch.has-hover ? Theme.danger : Theme.text;
        font-size: 13.5px;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Uma conexão salva nas listas do painel (cabo, VPN): clique liga/desliga.
component ConnRow inherits Rectangle {
    in property <image> icon;
    in property <string> name;
    in property <string> detail;
    in property <bool> active: false;
    /// Texto à direita do item ativo.
    in property <string> active-text: @tr("Connected");
    callback clicked();

    height: 38px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.tile-hover : transparent;
    Image {
        x: 12px;
        source: root.icon;
        colorize: root.active ? Theme.accent : Theme.text-muted;
        width: 16px;
        height: 16px;
    }
    Text {
        x: 40px;
        width: parent.width - 40px - 90px;
        text: root.name;
        color: Theme.text;
        font-size: 13.5px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - self.width - 12px;
        text: root.active ? root.active-text : root.detail;
        color: root.active ? Theme.accent : Theme.text-muted;
        font-size: 11.5px;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// O painel: ocupa a janela inteira (o fundo transparente fecha ao clicar)
/// e desenha o card no canto superior direito, logo abaixo da barra.
export component QuickSettings inherits Rectangle {
    /// Fecha o painel (sessão real: encerra o processo).
    callback close();
    /// Abre as Configurações numa página (0 = Rede, 5 = Som, 6 = Energia).
    callback open-settings(int);
    /// Bloqueia a tela.
    callback lock();
    /// Encerra a sessão (volta para a tela de login).
    callback logout();

    /// Submenu de energia aberto.
    property <bool> power-open: false;
    /// Lista de redes Wi-Fi aberta (setinha do botão do Wi-Fi).
    in-out property <bool> wifi-open: false;
    /// Rede escolhida na lista, esperando a senha.
    in-out property <string> wifi-selected: "";
    /// Lista aberta pela setinha de outro bloco: "wired", "vpn" ou "".
    property <string> open-list: "";

    // Blocos do painel em sequência, dois por linha; `c-*` = posição em que
    // cada um termina (0 ou 1 bloco de cada tipo).
    property <bool> show-network: !Device.wired-present && !Device.wifi-present;
    property <int> c-wired: Device.wired-present ? 1 : 0;
    property <int> c-wifi: root.c-wired + (Device.wifi-present ? 1 : 0);
    property <int> c-net: root.c-wifi + (root.show-network ? 1 : 0);
    property <int> c-vpn: root.c-net + (Device.vpns.length > 0 ? 1 : 0);
    property <int> c-bt: root.c-vpn + (Device.bt-available ? 1 : 0);
    property <int> c-dark: root.c-bt + 1;
    property <int> rows: Math.ceil(root.c-dark / 2);

    /// Qual bloco fica na posição `i` ("" = nenhum).
    pure function slot(i: int) -> string {
        return i < root.c-wired ? "wired" : i < root.c-wifi ? "wifi" : i < root.c-net ? "network"
            : i < root.c-vpn ? "vpn" : i < root.c-bt ? "bt" : i < root.c-dark ? "dark" : "";
    }
    pure function tile-icon(k: string) -> image {
        return k == "wired" ? (Device.wired-connected ? Icons.ethernet : Icons.ethernet-off)
            : k == "wifi" ? (Device.wifi-enabled ? Icons.wifi : Icons.wifi-off)
            : k == "network" ? Icons.globe
            : k == "vpn" ? Icons.shield
            : k == "bt" ? Icons.bluetooth
            : Icons.moon;
    }
    pure function tile-title(k: string) -> string {
        return k == "wired" ? @tr("Wired") : k == "wifi" ? "Wi-Fi" : k == "network" ? @tr("Network")
            : k == "vpn" ? "VPN" : k == "bt" ? "Bluetooth" : @tr("Dark style");
    }
    pure function tile-subtitle(k: string) -> string {
        return k == "wired" ? (!Device.network-ready ? "" : Device.wired-connected ? Device.wired-name
                : Device.wired-unplugged ? @tr("Cable unplugged") : @tr("Disconnected"))
            : k == "wifi" ? (!Device.network-ready ? "" : !Device.wifi-enabled ? @tr("Off")
                : Device.wifi-name != "" ? Device.wifi-name : @tr("Not connected"))
            : k == "network" ? (Device.network-available ? Device.network-status : "")
            : k == "vpn" ? (Device.vpn-active != "" ? Device.vpn-active : @tr("Off"))
            : k == "bt" ? (!Device.bt-powered ? @tr("Off") : Device.bt-connected != "" ? Device.bt-connected : @tr("On"))
            : "";
    }
    pure function tile-on(k: string) -> bool {
        return k == "wired" ? Device.wired-connected : k == "wifi" ? Device.wifi-enabled
            : k == "network" ? Device.network-available : k == "vpn" ? Device.vpn-active != ""
            : k == "bt" ? Device.bt-powered : !Theme.is-light;
    }
    pure function tile-has-details(k: string) -> bool {
        return k == "wired" || k == "wifi" || k == "vpn" || k == "bt";
    }
    pure function tile-open(k: string) -> bool {
        return k == "wifi" ? root.wifi-open : (k == "wired" || k == "vpn") && root.open-list == k;
    }
    function tile-toggled(k: string) {
        if (k == "wired") {
            // Sem cabo não há o que ligar: leva às Configurações de rede.
            if (Device.wired-unplugged) {
                root.open-settings(0);
            } else {
                Device.set-wired(!Device.wired-connected);
            }
        } else if (k == "wifi") {
            Device.wifi-enabled = !Device.wifi-enabled;
            Device.set-wifi(Device.wifi-enabled);
        } else if (k == "network") {
            root.open-settings(0);
        } else if (k == "vpn") {
            // Liga a primeira VPN salva ou desliga a que está ligada.
            if (Device.vpn-active != "") {
                Device.connection-set(Device.vpn-active, false);
            } else if (Device.vpns.length > 0) {
                Device.connection-set(Device.vpns[0].name, true);
            }
        } else if (k == "bt") {
            Device.bt-powered = !Device.bt-powered;
            Device.set-bt(Device.bt-powered);
        } else {
            Theme.mode = Theme.is-light ? ThemeMode.glass : ThemeMode.light;
        }
    }
    function tile-details(k: string) {
        Device.network-message = "";
        if (k == "wifi") {
            root.open-list = "";
            root.wifi-open = !root.wifi-open;
            root.wifi-selected = "";
            if (root.wifi-open && Device.wifi-enabled) {
                Device.rescan();
            }
        } else if (k == "wired" || k == "vpn") {
            root.wifi-open = false;
            root.open-list = root.open-list == k ? "" : k;
        } else if (k == "bt") {
            root.open-settings(1);
        }
    }

    // Clique fora do card fecha.
    TouchArea {
        clicked => { root.close(); }
    }

    card := Rectangle {
        width: 360px;
        height: content.preferred-height;
        x: parent.width - self.width - 10px;
        y: Theme.bar-height + 8px;
        border-radius: 18px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 6px;

        // Engole os cliques no card (para não fechar pelo fundo).
        TouchArea { }

        content := VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // --- Linha de cima: bateria + Configurações, bloquear, energia ---
            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                if Shell.battery != "--": HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 25px;
                        BatteryIcon {
                            level: Shell.battery-level;
                            charging: Shell.battery-charging;
                        }
                    }
                    Text {
                        text: Shell.battery-charging ? Shell.battery + " · " + @tr("charging") : Shell.battery;
                        color: Theme.text;
                        font-family: Theme.mono;
                        font-size: 12.5px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                RoundButton {
                    icon: Icons.settings;
                    clicked => { root.open-settings(2); }
                }
                RoundButton {
                    icon: Icons.lock;
                    clicked => { root.lock(); }
                }
                RoundButton {
                    icon: Icons.power;
                    active: root.power-open;
                    hover-color: Theme.danger;
                    clicked => { root.power-open = !root.power-open; }
                }
            }

            // --- Submenu de energia ---
            if root.power-open: Rectangle {
                height: power-list.preferred-height;
                border-radius: 12px;
                background: Theme.tile;
                border-width: 1px;
                border-color: Theme.border;
                power-list := VerticalLayout {
                    padding: 4px;
                    PowerItem {
                        icon: Icons.moon;
                        text: @tr("Suspend");
                        clicked => {
                            Device.power-action("suspend");
                            root.close();
                        }
                    }
                    PowerItem {
                        icon: Icons.rotate-ccw;
                        text: @tr("Restart");
                        clicked => { Device.power-action("reboot"); }
                    }
                    PowerItem {
                        icon: Icons.power;
                        text: @tr("Power off");
                        danger: true;
                        clicked => { Shell.power-off(); }
                    }
                    Rectangle {
                        height: 9px;
                        Rectangle { height: 1px; background: Theme.border; }
                    }
                    // Bloqueia esta sessão e abre a tela de login (sem fechar
                    // os apps): kalango-trocar-usuario.
                    if Shell.native: PowerItem {
                        icon: Icons.user;
                        text: @tr("Switch user");
                        clicked => {
                            Shell.open-app("switch-user");
                            root.close();
                        }
                    }
                    PowerItem {
                        icon: Icons.log-out;
                        text: @tr("Log out");
                        clicked => { root.logout(); }
                    }
                }
            }

            // --- Volume e brilho ---
            if Device.sound-available: SliderRow {
                icon: Device.muted || Device.volume <= 0.001 ? Icons.volume-x : Icons.volume;
                icon-clickable: true;
                has-details: Device.sound-outputs.length > 1;
                details-open: root.open-list == "sound";
                details => { root.open-list = root.open-list == "sound" ? "" : "sound"; }
                value: Device.volume;
                icon-clicked => {
                    Device.muted = !Device.muted;
                    Device.set-muted(Device.muted);
                }
                changed(v) => {
                    Device.volume = v;
                    if (Device.muted && v > 0) {
                        Device.muted = false;
                        Device.set-muted(false);
                    }
                    Device.set-volume(v);
                }
            }
            // --- Saídas de som (setinha do volume), como no Ubuntu ---
            if root.open-list == "sound": VerticalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Sound output");
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                Rectangle {
                    height: sound-list.preferred-height;
                    border-radius: 12px;
                    background: Theme.tile;
                    border-width: 1px;
                    border-color: Theme.border;
                    sound-list := VerticalLayout {
                        padding: 4px;
                        for o in Device.sound-outputs: ConnRow {
                            icon: o.hdmi ? Icons.monitor : Icons.volume;
                            name: o.name;
                            active: o.active;
                            active-text: @tr("In use");
                            clicked => { if (!o.active) { Device.set-sound-default(o.id); } }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    LinkText {
                        text: @tr("Sound settings...");
                        clicked => { root.open-settings(5); }
                    }
                }
            }
            if Device.brightness-available: SliderRow {
                icon: Icons.sun;
                value: Device.brightness;
                changed(v) => {
                    Device.brightness = v;
                    Device.set-brightness(v);
                }
            }

            // --- Botões liga/desliga, como no Ubuntu: dois por linha, só os
            // que existem nesta máquina (ver `slot`). ---
            for r in root.rows: HorizontalLayout {
                spacing: 10px;
                Tile {
                    horizontal-stretch: 1;
                    icon: root.tile-icon(root.slot(r * 2));
                    title: root.tile-title(root.slot(r * 2));
                    subtitle: root.tile-subtitle(root.slot(r * 2));
                    on: root.tile-on(root.slot(r * 2));
                    has-details: root.tile-has-details(root.slot(r * 2));
                    details-open: root.tile-open(root.slot(r * 2));
                    toggled => { root.tile-toggled(root.slot(r * 2)); }
                    details => { root.tile-details(root.slot(r * 2)); }
                }
                if root.slot(r * 2 + 1) != "": Tile {
                    horizontal-stretch: 1;
                    icon: root.tile-icon(root.slot(r * 2 + 1));
                    title: root.tile-title(root.slot(r * 2 + 1));
                    subtitle: root.tile-subtitle(root.slot(r * 2 + 1));
                    on: root.tile-on(root.slot(r * 2 + 1));
                    has-details: root.tile-has-details(root.slot(r * 2 + 1));
                    details-open: root.tile-open(root.slot(r * 2 + 1));
                    toggled => { root.tile-toggled(root.slot(r * 2 + 1)); }
                    details => { root.tile-details(root.slot(r * 2 + 1)); }
                }
                if root.slot(r * 2 + 1) == "": Rectangle { horizontal-stretch: 1; }
            }

            // --- Conexões cabeadas salvas (setinha do bloco "Cabeada") ---
            if root.open-list == "wired": VerticalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Wired connections");
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                Rectangle {
                    height: wired-list.preferred-height;
                    border-radius: 12px;
                    background: Theme.tile;
                    border-width: 1px;
                    border-color: Theme.border;
                    wired-list := VerticalLayout {
                        padding: 4px;
                        // Só as de cabo (a lista também tem as de Wi-Fi).
                        for c in Device.connections: Rectangle {
                            height: c.kind == "ethernet" ? 38px : 0;
                            if c.kind == "ethernet": ConnRow {
                                icon: Icons.ethernet;
                                name: c.name;
                                active: c.active;
                                clicked => { Device.connection-set(c.name, !c.active); }
                            }
                        }
                    }
                }
                if Device.network-message != "": Text {
                    text: Device.network-message;
                    color: Theme.text-muted;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    LinkText {
                        text: @tr("Network settings...");
                        clicked => { root.open-settings(0); }
                    }
                }
            }

            // --- VPNs salvas (setinha do bloco "VPN") ---
            if root.open-list == "vpn": VerticalLayout {
                spacing: 8px;
                Text {
                    text: "VPN";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-weight: 600;
                }
                Rectangle {
                    height: vpn-list.preferred-height;
                    border-radius: 12px;
                    background: Theme.tile;
                    border-width: 1px;
                    border-color: Theme.border;
                    vpn-list := VerticalLayout {
                        padding: 4px;
                        for v in Device.vpns: ConnRow {
                            icon: Icons.shield;
                            name: v.name;
                            detail: v.kind;
                            active: v.active;
                            clicked => { Device.connection-set(v.name, !v.active); }
                        }
                    }
                }
                if Device.network-message != "": Text {
                    text: Device.network-message;
                    color: Theme.text-muted;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    LinkText {
                        text: @tr("VPN settings...");
                        clicked => { root.open-settings(0); }
                    }
                }
            }

            // --- Redes Wi-Fi (como o menu do Wi-Fi do macOS) ---
            if root.wifi-open && Device.wifi-present: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    height: 20px;
                    Text {
                        text: @tr("Wi-Fi networks");
                        color: Theme.text-muted;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if Device.network-busy: Text {
                        text: @tr("Please wait...");
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                if !Device.wifi-enabled: Text {
                    text: @tr("Wi-Fi is off.");
                    color: Theme.text-muted;
                    font-size: 13px;
                }
                if Device.wifi-enabled: Rectangle {
                    height: wifi-list.height + 8px;
                    border-radius: 12px;
                    background: Theme.tile;
                    border-width: 1px;
                    border-color: Theme.border;
                    wifi-list := WifiList {
                        y: 4px;
                        compact: true;
                        selected <=> root.wifi-selected;
                    }
                }
                if Device.network-message != "": Text {
                    text: Device.network-message;
                    color: Theme.text-muted;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    LinkText {
                        text: @tr("Wi-Fi settings...");
                        clicked => { root.open-settings(0); }
                    }
                }
            }
        }
    }
}
