        SectionLabel { text: @tr("SHUT DOWN"); }
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            PillButton {
                text: @tr("Suspend");
                clicked => { Device.power-action("suspend"); }
            }
            PillButton {
                text: @tr("Restart");
                clicked => { Device.power-action("reboot"); }
            }
            PillButton {
                text: @tr("Shut down");
                danger: true;
                clicked => { Shell.power-off(); }
            }
        }
    }
}

