export component SoundPage inherits Rectangle {
    VerticalLayout {
        x: 0;
        y: Page.top;
        width: min(Page.max-width, parent.width);
        alignment: start;
        spacing: 16px;

        if !Device.sound-available: EmptyNotice {
            icon: Icons.volume;
            title: @tr("No sound output");
            text: @tr("The sound server (PipeWire) found no speakers or headphones.");
        }

        if Device.sound-available: Panel {
            height: 3 * 67px;
            VerticalLayout {
                Row {
                    title: @tr("Output");
                    divider: false;
                    value: Device.sound-output;
                }
                Row {
                    title: "Volume";
                    SliderBar {
                        x: parent.width - self.width - 72px;
                        width: clamp(parent.width * 0.3, 100px, 240px);
                        value <=> Device.volume;
                        changed(v) => { Device.set-volume(v); }
                    }
                    Text {
                        x: parent.width - self.width - 20px;
                        width: 42px;
                        text: Device.muted ? @tr("muted") : round(Device.volume * 100) + "%";
                        color: Theme.text;
                        font-family: Theme.mono;
                        font-size: 13px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Row {
                    title: @tr("Mute");
                    subtitle: @tr("Silences the default output");
                    Toggle {
                        x: parent.width - self.width - 20px;
                        checked <=> Device.muted;
                        toggled(on) => { Device.set-muted(on); }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            PillButton {
                text: @tr("More sound options");
                clicked => { Shell.open-app("sound"); }
            }
        }
    }
}

