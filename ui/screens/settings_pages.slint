export component RegionPage inherits Rectangle {
    VerticalLayout {
        x: 0;
        y: Page.top;
        width: min(Page.max-width, parent.width);
        alignment: start;
        spacing: 16px;

        Panel {
            height: 2 * 67px;
            VerticalLayout {
                Row {
                    title: @tr("Language");
                    subtitle: @tr("Menus, settings and apps");
                    divider: false;
                    Dropdown {
                        // Encolhe em janela estreita.
                        width: clamp(parent.width * 0.4, 150px, 250px);
                        x: parent.width - self.width - 20px;
                        options: Device.languages;
                        selected: Device.language-index;
                        chosen(i) => { Device.set-language(i); }
                    }
                }
                Row {
                    title: @tr("Keyboard");
                    subtitle: Device.keyboard-message != "" ? Device.keyboard-message : @tr("Layout of the keys");
                    Dropdown {
                        // Encolhe em janela estreita.
                        width: clamp(parent.width * 0.4, 150px, 250px);
                        x: parent.width - self.width - 20px;
                        options: Device.keyboard-layouts;
                        selected: Device.keyboard-index;
                        chosen(i) => { Device.set-keyboard(i); }
                    }
                }
            }
        }

        if Device.language-pending: Panel {
            height: 67px;
            Row {
                title: @tr("Sign out to change the language");
                subtitle: @tr("Open apps keep the current language until then");
                divider: false;
                PillButton {
                    x: parent.width - self.width - 20px;
                    text: @tr("Log out");
                    primary: true;
                    clicked => { Shell.open-app("logout"); }
                }
            }
        }
    }
}

