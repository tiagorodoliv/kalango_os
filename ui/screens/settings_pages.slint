// Páginas das Configurações com dados reais do sistema (global `Device`,
// preenchido por `src/settings/device.rs` e `src/settings/displays.rs`): Rede e Wi-Fi,
// Bluetooth, Monitores, Som, Energia, Usuários, Atualizações e Sobre o
// sistema. Também a Barra de tarefas (global `Theme`, gravada com a
// aparência). A Aparência fica em `settings.slint`.
//
// Cada página ocupa a área de conteúdo inteira; o título já é desenhado pela
// tela das Configurações, então o conteúdo começa em y = 110px.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Shell, Apps } from "../globals.slint";
import { Device, InfoItem, WifiNetwork, DisplayOutput, DisplayResolution, BtDevice, Power, Accounts, UserAccount, Printers, Printer, PrinterDevice, Updates, UpdateItem } from "../device.slint";
import { SectionLabel, Toggle, SliderBar, Avatar } from "../components/widgets.slint";
import { KalangoLogo, KalangoIcon } from "../brand.slint";
import { WifiList, ForgetLink } from "../components/wifi_list.slint";

/// Onde o conteúdo das páginas começa (abaixo do título).
global Page {
    out property <length> top: 110px;
    out property <length> max-width: 721px;
}

/// Botão com texto. `primary` usa a cor de destaque; `danger`, o vermelho.
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    width: label.preferred-width + 36px;
    height: 38px;
    border-radius: Theme.radius-small;
    opacity: root.enabled ? 1 : 0.5;
    background: root.primary
        ? (touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent)
        : (touch.has-hover ? Theme.tile-hover : Theme.tile);
    border-width: root.primary ? 0 : 1px;
    border-color: root.danger ? Theme.danger.with-alpha(0.6) : Theme.border;
    animate background { duration: Theme.anim; }

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.text;
        font-family: Theme.sans;
        font-size: 14px;
        font-weight: 600;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Painel de fundo das listas de opções.
component Panel inherits Rectangle {
    border-radius: Theme.radius;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
}

/// Linha de painel: título e descrição à esquerda, controle (filho) à direita.
component Row inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> divider: true;
    /// Valor à direita (sem controle filho).
    in property <string> value;
    /// Valor em destaque (texto normal e fonte mono).
    in property <bool> value-strong: false;

    height: 67px;

    if root.divider: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        x: 20px;
        width: parent.width * 0.5;
        alignment: center;
        spacing: 3px;
        Text { text: root.title; color: Theme.text; font-family: Theme.sans; font-size: 14.5px; font-weight: 600; overflow: elide; }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.text-muted; font-family: Theme.sans; font-size: 13.5px; overflow: elide; }
    }
    if root.value != "": Text {
        x: root.width - self.width - 20px;
        width: root.width * 0.4;
        text: root.value;
        color: root.value-strong ? Theme.text : Theme.text-muted;
        font-family: root.value-strong ? Theme.mono : Theme.sans;
        font-size: 14px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}

/// Lista suspensa: mostra a opção escolhida e abre a lista ao clicar.
component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    callback chosen(int);

    width: 250px;
    height: 38px;
    border-radius: Theme.radius-small;
    background: touch.has-hover && root.enabled ? Theme.tile-hover : Theme.tile;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.5;

    Text {
        x: 14px;
        width: parent.width - 44px;
        text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 30px;
        source: Icons.chevron-down;
        colorize: Theme.text-muted;
        width: 16px;
        height: 16px;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.options.length * 34px + 10px, 290px);
        Rectangle {
            border-radius: Theme.radius-small;
            background: Theme.panel-solid;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;
            Flickable {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                content-height: root.options.length * 34px;
                for opt[i] in root.options: Rectangle {
                    y: i * 34px;
                    height: 34px;
                    border-radius: 6px;
                    background: i == root.selected ? Theme.accent-soft : item-touch.has-hover ? Theme.tile : transparent;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: opt;
                        color: i == root.selected ? Theme.accent : Theme.text;
                        font-family: Theme.sans;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.chosen(i); }
                    }
                }
            }
        }
    }
}

/// Seletor de uma opção entre poucas, lado a lado (ex.: tamanho da dock).
/// Modelo pronto da dock (Barra de tarefas → MODELO): miniatura e nome.
/// Escolher um modelo troca estilo, ícones, cantos e transparências de uma
/// vez; depois cada opção continua ajustável sozinha.
component DockModelCard inherits Rectangle {
    in property <int> model;
    in property <string> label;
    callback chosen();

    // Valores de cada modelo: Kalango, Vidro 3D, Ladrilhos, Barra, Mínima.
    property <int> m-style: [0, 0, 0, 1, 0][root.model];
    property <int> m-icons: [0, 1, 2, 0, 0][root.model];
    property <int> m-corners: [1, 2, 1, 0, 0][root.model];
    property <float> m-transparency: [0, 0.4, 0.2, 0.1, 0.6][root.model];
    property <float> m-icon-transparency: [0, 0, 0, 0, 0.25][root.model];
    out property <bool> selected: Theme.dock-style == root.m-style && Theme.dock-icon-style == root.m-icons
        && Theme.dock-corners == root.m-corners && abs(Theme.dock-transparency - root.m-transparency) < 0.01
        && abs(Theme.dock-icon-transparency - root.m-icon-transparency) < 0.01;

    height: 104px;
    border-radius: Theme.radius-small;
    background: card-touch.has-hover ? Theme.tile-hover : Theme.tile;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border;

    // "Tela" com a dock embaixo.
    screen := Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 64px;
        border-radius: 6px;
        clip: true;
        background: Theme.accent.darker(0.7).with-alpha(0.35);

        property <length> t: 20px;
        property <length> r: root.m-style == 1 || root.m-corners == 0 ? 0 : root.m-corners == 2 ? self.t / 2 : 5px;
        Rectangle {
            width: root.m-style == 1 ? parent.width : 5 * 15px + 6px;
            height: parent.t;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height;
            border-top-left-radius: parent.r;
            border-top-right-radius: parent.r;
            background: Theme.panel-solid.with-alpha(1 - root.m-transparency);
            border-width: root.m-style == 1 ? 0 : 1px;
            border-color: Theme.border;

            for c[i] in [Theme.accent, #f28b95, #7ea6f7, #5fd38d, #e8b04b]: Rectangle {
                property <length> side: 12px;
                x: (parent.width - 5 * 15px) / 2 + i * 15px + 1px;
                y: (parent.height - self.side) / 2;
                width: self.side;
                height: self.side;
                border-radius: root.m-corners == 0 ? 1px : root.m-corners == 2 ? self.side / 2 : 3px;
                background: root.m-icons == 1 ? Theme.tile.brighter(0.5)
                    : root.m-icons == 2 ? c.with-alpha(0.25) : transparent;
                border-width: root.m-icons == 0 ? 0 : 1px;
                border-color: root.m-icons == 2 ? c.with-alpha(0.6) : Theme.border;
                Rectangle {
                    width: root.m-icons == 0 ? 9px : 6px;
                    height: self.width;
                    border-radius: root.m-corners == 2 ? self.width / 2 : 2px;
                    background: c;
                    opacity: 1 - root.m-icon-transparency;
                }
            }
        }
    }
    Text {
        y: screen.y + screen.height + 6px;
        width: parent.width;
        horizontal-alignment: center;
        text: root.label;
        color: root.selected ? Theme.text : Theme.text-muted;
        font-family: Theme.sans;
        font-size: 12.5px;
        font-weight: root.selected ? 600 : 400;
    }
    card-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Theme.dock-style = root.m-style;
            Theme.dock-icon-style = root.m-icons;
            Theme.dock-corners = root.m-corners;
            Theme.dock-transparency = root.m-transparency;
            Theme.dock-icon-transparency = root.m-icon-transparency;
            root.chosen();
        }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback chosen(int);

    width: row.preferred-width;
    height: 36px;
    border-radius: Theme.radius-small;
    background: Theme.sunken;
    border-width: 1px;
    border-color: Theme.border;

    row := HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for opt[i] in root.options: Rectangle {
            // 82 px, ou mais se o texto não couber ("Automático (DHCP)").
            width: max(82px, seg-label.preferred-width + 24px);
            border-radius: 6px;
            background: i == root.selected ? Theme.accent : seg-touch.has-hover ? Theme.tile-hover : transparent;
            animate background { duration: Theme.anim; }
            seg-label := Text {
                text: opt;
                color: i == root.selected ? Theme.on-accent : Theme.text;
                font-family: Theme.sans;
                font-size: 13.5px;
                font-weight: i == root.selected ? 600 : 400;
            }
            seg-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chosen(i); }
            }
        }
    }
}

/// Aviso de seção sem recurso (ícone + texto).
component EmptyNotice inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> text;

    height: 150px;
    border-radius: Theme.radius;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding-left: 20px;
        padding-right: 20px;
        Image {
            source: root.icon;
            colorize: Theme.text-muted;
            height: 28px;
            image-fit: contain;
        }
        Text { text: root.title; color: Theme.text; font-family: Theme.sans; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
        Text { text: root.text; color: Theme.text-muted; font-family: Theme.sans; font-size: 13.5px; horizontal-alignment: center; wrap: word-wrap; }
    }
}

// ---------------------------------------------------------------------------
// Rede e Wi-Fi
// ---------------------------------------------------------------------------

/// Campo de texto com rótulo à esquerda (formulários de IP e VPN).
component Field inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    callback edited(string);

    height: 46px;
    property <length> label-w: min(170px, self.width * 0.36);
    Text {
        x: 20px;
        width: root.label-w - 10px;
        text: root.label;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: 20px + root.label-w;
        width: parent.width - self.x - 20px;
        height: 36px;
        border-radius: Theme.radius-small;
        background: Theme.sunken;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        if input.text == "": Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.placeholder;
            color: Theme.text-muted;
            font-family: Theme.sans;
            font-size: 13.5px;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            vertical-alignment: center;
            text <=> root.text;
            input-type: root.password ? InputType.password : InputType.text;
            color: Theme.text;
            font-family: Theme.sans;
            font-size: 13.5px;
            single-line: true;
            edited => { root.edited(self.text); }
        }
    }
}

/// Campo de arquivo: o caminho escolhido e o botão "Escolher...".
component FileField inherits Rectangle {
    in property <string> label;
    in property <string> path;
    callback choose();

    height: 46px;
    property <length> label-w: min(170px, self.width * 0.36);
    Text {
        x: 20px;
        width: root.label-w - 10px;
        text: root.label;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 20px + root.label-w;
        width: parent.width - self.x - 20px - choose-btn.width - 10px;
        text: root.path != "" ? root.path : @tr("No file chosen");
        color: root.path != "" ? Theme.text : Theme.text-muted;
        font-family: Theme.sans;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    choose-btn := PillButton {
        x: parent.width - self.width - 20px;
        height: 34px;
        text: @tr("Choose...");
        clicked => { root.choose(); }
    }
}

/// Linha de formulário com um controle à direita (filho).
component FormRow inherits Rectangle {
    in property <string> label;
    height: 46px;
    Text {
        x: 20px;
        text: root.label;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 14px;
        vertical-alignment: center;
    }
    @children
}

/// Título de um painel de formulário.
component FormTitle inherits Rectangle {
    in property <string> text;
    height: 34px;
    Text {
        x: 20px;
        width: parent.width - 40px;
        text: root.text;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// Linha só de leitura: rótulo à esquerda e valor à direita (detalhes da conexão).
component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 30px;
    Text {
        x: 20px;
        width: min(170px, root.width * 0.36) - 10px;
        text: root.label;
        color: Theme.text-muted;
        font-family: Theme.sans;
        font-size: 13.5px;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 20px + min(170px, root.width * 0.36);
        width: root.width - self.x - 20px;
        text: root.value;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 13.5px;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// Linha com título, explicação embaixo e um controle à direita (filho).
component OptionRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    height: root.hint != "" ? 58px : 46px;
    VerticalLayout {
        x: 20px;
        width: root.width - 110px;
        alignment: center;
        spacing: 2px;
        Text { text: root.title; color: Theme.text; font-family: Theme.sans; font-size: 14px; overflow: elide; }
        if root.hint != "": Text { text: root.hint; color: Theme.text-muted; font-family: Theme.sans; font-size: 12.5px; overflow: elide; }
    }
    @children
}

/// Botões Cancelar e Salvar, à direita.
component FormButtons inherits HorizontalLayout {
    in property <bool> busy: false;
    callback cancel();
    callback save();
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 6px;
    spacing: 10px;
    alignment: end;
    height: 44px;
    PillButton { text: @tr("Cancel"); clicked => { root.cancel(); } }
    PillButton { text: @tr("Save"); primary: true; enabled: !root.busy; clicked => { root.save(); } }
}

export component NetworkPage inherits Rectangle {
    /// "Esquecer rede" pede confirmação no segundo clique.
    property <bool> confirm-forget: false;
    /// Formulário de rede oculta aberto.
    property <bool> show-hidden: false;
    property <string> hidden-ssid;
    property <string> hidden-pass;
    // Formulários de VPN (os valores só vão para o Rust ao salvar).
    property <string> login-user;
    property <string> login-pass;
    property <string> vpn-name;
    property <string> ov-server;
    property <string> ov-port;
    property <bool> ov-tcp: false;
    property <int> ov-auth: 1;
    property <string> ov-ca;
    property <string> ov-cert;
    property <string> ov-key;
    property <string> ov-user;
    property <string> ov-pass;
    property <string> wg-address;
    property <string> wg-dns;
    property <string> wg-peer;
    property <string> wg-endpoint;
    property <string> wg-allowed: "0.0.0.0/0";
    // Arquivo escolhido na janela do zenity (Device.pick-file).
    property <int> picked: Device.picked-serial;
    changed picked => {
        if (Device.picked-purpose == "ca") {
            root.ov-ca = Device.picked-path;
        } else if (Device.picked-purpose == "cert") {
            root.ov-cert = Device.picked-path;
        } else if (Device.picked-purpose == "key") {
            root.ov-key = Device.picked-path;
        }
    }
    // Com rolagem: com muitas redes por perto, a lista e o campo de senha da
    // rede escolhida passam da altura da janela.
    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: network-col.preferred-height + 36px;
    network-col := VerticalLayout {
        x: 0;
        y: 12px;
        width: min(Page.max-width, parent.width);
        alignment: start;
        spacing: 16px;

        // Só depois da primeira leitura (antes dela, "indisponível" assustava).
        if Device.network-ready && !Device.network-available: EmptyNotice {
            icon: Icons.wifi;
            title: @tr("Network manager unavailable");
            text: @tr("NetworkManager did not respond. Check that the service is running.");
        }

        if Device.network-available: Panel {
            height: Device.wifi-present ? 2 * 67px : 67px;
            VerticalLayout {
                Row {
                    title: @tr("Connection");
                    subtitle: Device.network-status;
                    divider: false;
                    PillButton {
                        x: parent.width - self.width - 20px;
                        text: @tr("Advanced");
                        clicked => { Shell.open-app("network"); }
                    }
                }
                if Device.wifi-present: Row {
                    title: "Wi-Fi";
                    subtitle: Device.wifi-enabled ? @tr("On") : @tr("Off");
                    Toggle {
                        x: parent.width - self.width - 20px;
                        checked <=> Device.wifi-enabled;
                        toggled(on) => { Device.set-wifi(on); }
                    }
                }
            }
        }

        if Device.network-available && !Device.wifi-present: Text {
            text: @tr("No Wi-Fi adapter was found on this computer.");
            color: Theme.text-muted;
            font-family: Theme.sans;
            font-size: 13.5px;
        }

        // --- Lista de redes ---
        if Device.network-available && Device.wifi-present && Device.wifi-enabled: HorizontalLayout {
            height: 24px;
            spacing: 8px;
            SectionLabel { text: @tr("AVAILABLE NETWORKS"); vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            PillButton {
                height: 24px;
                text: @tr("Hidden network...");
                clicked => { root.show-hidden = !root.show-hidden; }
            }
            PillButton {
                height: 24px;
                text: Device.network-busy ? @tr("Please wait...") : @tr("Refresh");
                enabled: !Device.network-busy;
                clicked => { Device.rescan(); }
            }
        }

        if Device.network-available && Device.wifi-present && Device.wifi-enabled: Panel {
            height: wifi-list.height;
            wifi-list := WifiList { }
        }

        if Device.network-available && Device.wifi-present && Device.wifi-enabled && root.show-hidden: Panel {
            height: hidden-col.preferred-height;
            hidden-col := VerticalLayout {
                padding-top: 10px;
                padding-bottom: 12px;
                FormTitle { text: @tr("Connect to a hidden network"); }
                Field { label: @tr("Network name"); text <=> root.hidden-ssid; placeholder: @tr("Exactly as set on the router"); }
                Field { label: @tr("Password"); text <=> root.hidden-pass; password: true; placeholder: @tr("Leave empty for an open network"); }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 6px;
                    spacing: 10px;
                    alignment: end;
                    height: 44px;
                    PillButton {
                        text: @tr("Cancel");
                        clicked => {
                            root.show-hidden = false;
                            root.hidden-pass = "";
                        }
                    }
                    PillButton {
                        text: @tr("Connect");
                        primary: true;
                        enabled: root.hidden-ssid != "" && !Device.network-busy;
                        clicked => {
                            Device.connect-hidden(root.hidden-ssid, root.hidden-pass);
                            root.show-hidden = false;
                            root.hidden-pass = "";
                        }
                    }
                }
            }
        }

        if Device.network-message != "": Text {
            text: Device.network-message;
            color: Theme.text-muted;
            font-family: Theme.sans;
            font-size: 13.5px;
        }

        // --- Conexões salvas e IP fixo ---
        if Device.network-available && Device.connections.length > 0: SectionLabel { text: @tr("CONNECTIONS"); }
        if Device.network-available && Device.connections.length > 0: Panel {
            height: Device.connections.length * 52px;
            for c[i] in Device.connections: Rectangle {
                y: i * 52px;
                height: 52px;
                if i > 0: Rectangle { x: 20px; y: 0; width: parent.width - 40px; height: 1px; background: Theme.border; }
                Image {
                    x: 20px;
                    source: c.kind == "wifi" ? Icons.wifi : Icons.globe;
                    colorize: c.active ? Theme.accent : Theme.text-muted;
                    width: 18px;
                    height: 18px;
                }
                Text {
                    x: 54px;
                    width: parent.width - self.x - ip-btn.width - 110px;
                    text: c.name;
                    color: Theme.text;
                    font-family: Theme.sans;
                    font-size: 14.5px;
                    font-weight: c.active ? 600 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if c.active: Text {
                    x: ip-btn.x - self.width - 12px;
                    text: @tr("Active");
                    color: Theme.accent;
                    font-family: Theme.sans;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                ip-btn := PillButton {
                    x: parent.width - self.width - 20px;
                    height: 32px;
                    text: Device.ip-for == c.name ? @tr("Close") : @tr("Details");
                    clicked => {
                        root.confirm-forget = false;
                        if (Device.ip-for == c.name) {
                            Device.ip-for = "";
                        } else {
                            Device.ip-edit(c.name);
                        }
                    }
                }
            }
        }
        if Device.ip-for != "": Panel {
            height: ip-col.preferred-height;
            ip-col := VerticalLayout {
                padding-top: 10px;
                padding-bottom: 12px;
                FormTitle { text: Device.ip-for; }
                if !Device.conn-active: DetailRow {
                    label: @tr("Status");
                    value: @tr("Not connected now");
                }
                for item in Device.conn-details: DetailRow { label: item.label; value: item.value; }

                // --- Opções ---
                Rectangle { height: 10px; }
                Rectangle { height: 1px; background: Theme.border; }
                OptionRow {
                    title: @tr("Connect automatically");
                    hint: Device.conn-kind == "wifi" ? @tr("Join this network whenever it is in range.") : @tr("Connect as soon as the cable is plugged in.");
                    Toggle {
                        x: parent.width - self.width - 20px;
                        checked <=> Device.conn-autoconnect;
                    }
                }
                OptionRow {
                    title: @tr("Metered connection");
                    hint: @tr("Mobile data or phone hotspot: avoid large downloads in the background.");
                    Toggle {
                        x: parent.width - self.width - 20px;
                        checked <=> Device.conn-metered;
                    }
                }
                if Device.conn-secured: FormRow {
                    label: @tr("Password");
                    Text {
                        x: parent.width * 0.36;
                        width: parent.width - self.x - show-btn.width - 30px;
                        text: Device.conn-password != "" ? Device.conn-password : "••••••••";
                        color: Theme.text;
                        font-family: Device.conn-password != "" ? Theme.mono : Theme.sans;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    show-btn := PillButton {
                        x: parent.width - self.width - 20px;
                        height: 32px;
                        text: Device.conn-password != "" ? @tr("Hide") : @tr("Show");
                        clicked => {
                            if (Device.conn-password != "") {
                                Device.conn-password = "";
                            } else {
                                Device.conn-show-password(Device.ip-for);
                            }
                        }
                    }
                }

                // --- IPv4 ---
                Rectangle { height: 1px; background: Theme.border; }
                FormRow {
                    label: "IPv4";
                    Segmented {
                        x: parent.width - self.width - 20px;
                        options: [@tr("Automatic (DHCP)"), @tr("Manual")];
                        selected: Device.ip-manual ? 1 : 0;
                        chosen(i) => { Device.ip-manual = i == 1; }
                    }
                }
                if !Device.ip-manual: DetailRow {
                    label: "";
                    value: @tr("The router assigns the address.");
                }
                if Device.ip-manual: Field { label: @tr("Address"); text <=> Device.ip-address; placeholder: "192.168.1.50"; }
                if Device.ip-manual: Field { label: @tr("Subnet mask"); text <=> Device.ip-mask; placeholder: "255.255.255.0 " + @tr("or") + " 24"; }
                if Device.ip-manual: Field { label: "Gateway"; text <=> Device.ip-gateway; placeholder: "192.168.1.1"; }
                if Device.ip-manual: Field { label: "DNS"; text <=> Device.ip-dns; placeholder: "8.8.8.8, 1.1.1.1"; }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 10px;
                    spacing: 10px;
                    height: 48px;
                    PillButton {
                        text: root.confirm-forget ? @tr("Yes, forget it") : (Device.conn-kind == "wifi" ? @tr("Forget network") : @tr("Remove connection"));
                        danger: true;
                        clicked => {
                            if (root.confirm-forget) {
                                root.confirm-forget = false;
                                Device.conn-forget(Device.ip-for);
                            } else {
                                root.confirm-forget = true;
                            }
                        }
                    }
                    if root.confirm-forget: Text {
                        text: Device.conn-kind == "wifi" ? @tr("The saved password will be erased.") : @tr("Its settings will be erased.");
                        color: Theme.text-muted;
                        font-family: Theme.sans;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        text: @tr("Cancel");
                        clicked => {
                            root.confirm-forget = false;
                            Device.ip-for = "";
                            Device.ip-message = "";
                        }
                    }
                    PillButton {
                        text: @tr("Save");
                        primary: true;
                        clicked => {
                            root.confirm-forget = false;
                            Device.ip-apply(Device.ip-for, Device.ip-manual, Device.ip-address, Device.ip-mask, Device.ip-gateway, Device.ip-dns, Device.conn-autoconnect, Device.conn-metered);
                        }
                    }
                }
            }
        }
        if Device.ip-message != "": Text {
            text: Device.ip-message;
            color: Theme.text;
            font-family: Theme.sans;
            font-size: 13.5px;
            wrap: word-wrap;
        }

        // --- VPN ---
        if Device.vpn-available: HorizontalLayout {
            height: 26px;
            spacing: 8px;
            SectionLabel { text: "VPN"; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            PillButton {
                height: 26px;
                text: @tr("Import file...");
                clicked => {
                    Device.vpn-message = "";
                    Device.vpn-import();
                }
            }
            PillButton {
                height: 26px;
                text: @tr("Add VPN");
                clicked => {
                    Device.vpn-message = "";
                    Device.vpn-form = Device.vpn-form != 0 ? 0 : Device.openvpn-available ? 1 : 2;
                }
            }
        }
        if Device.vpn-available: Panel {
            height: max(1, Device.vpns.length) * 56px;
            if Device.vpns.length == 0: Text {
                x: 20px;
                width: parent.width - 40px;
                text: @tr("No VPN yet. Import an OpenVPN (.ovpn) or WireGuard (.conf) file, or add one by hand.");
                color: Theme.text-muted;
                font-family: Theme.sans;
                font-size: 13.5px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            for v[i] in Device.vpns: Rectangle {
                y: i * 56px;
                height: 56px;
                if i > 0: Rectangle { x: 20px; y: 0; width: parent.width - 40px; height: 1px; background: Theme.border; }
                Image {
                    x: 20px;
                    source: Icons.lock;
                    colorize: v.active ? Theme.accent : Theme.text-muted;
                    width: 17px;
                    height: 17px;
                }
                VerticalLayout {
                    x: 54px;
                    width: parent.width - self.x - 190px;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: v.name;
                        color: Theme.text;
                        font-family: Theme.sans;
                        font-size: 14.5px;
                        font-weight: v.active ? 600 : 400;
                        overflow: elide;
                    }
                    Text {
                        text: Device.vpn-busy == v.name ? @tr("Please wait...") : v.active ? v.kind + " · " + @tr("Connected") : v.kind;
                        color: v.active ? Theme.accent : Theme.text-muted;
                        font-family: Theme.sans;
                        font-size: 12.5px;
                        overflow: elide;
                    }
                }
                remove := ForgetLink {
                    x: vpn-toggle.x - self.width - 14px;
                    height: 30px;
                    text: @tr("Remove");
                    font-size: 12.5px;
                    clicked => { Device.vpn-remove(v.name); }
                }
                vpn-toggle := Toggle {
                    x: parent.width - self.width - 20px;
                    checked: v.active;
                    toggled(on) => {
                        Device.vpn-message = "";
                        Device.vpn-set(v.name, on);
                    }
                }
            }
        }

        // Usuário e senha de uma VPN OpenVPN (depois de importar, ou quando
        // ligar pediu).
        if Device.vpn-login-for != "": Panel {
            height: login-col.preferred-height;
            login-col := VerticalLayout {
                padding-top: 10px;
                padding-bottom: 12px;
                FormTitle { text: @tr("Sign in to {}", Device.vpn-login-for); }
                Field { label: @tr("Username"); text <=> root.login-user; }
                Field { label: @tr("Password"); text <=> root.login-pass; password: true; }
                FormButtons {
                    cancel => { Device.vpn-login-for = ""; root.login-pass = ""; }
                    save => {
                        Device.vpn-set-login(Device.vpn-login-for, root.login-user, root.login-pass);
                        root.login-pass = "";
                    }
                }
            }
        }

        // Formulário de VPN nova (OpenVPN ou WireGuard).
        if Device.vpn-form != 0: Panel {
            height: form-col.preferred-height;
            form-col := VerticalLayout {
                padding-top: 10px;
                padding-bottom: 12px;
                FormTitle { text: @tr("New VPN"); }
                FormRow {
                    label: @tr("Type");
                    Segmented {
                        x: parent.width - self.width - 20px;
                        options: ["OpenVPN", "WireGuard"];
                        selected: Device.vpn-form - 1;
                        chosen(i) => { Device.vpn-form = i + 1; }
                    }
                }
                Field { label: @tr("Name"); text <=> root.vpn-name; placeholder: @tr("Work"); }

                if Device.vpn-form == 1 && !Device.openvpn-available: FormTitle {
                    text: @tr("OpenVPN support is not installed (network-manager-openvpn).");
                }
                if Device.vpn-form == 1: Field { label: @tr("Server"); text <=> root.ov-server; placeholder: "vpn.example.com"; }
                if Device.vpn-form == 1: Field { label: @tr("Port"); text <=> root.ov-port; placeholder: "1194"; }
                if Device.vpn-form == 1: FormRow {
                    label: @tr("Protocol");
                    Segmented {
                        x: parent.width - self.width - 20px;
                        options: ["UDP", "TCP"];
                        selected: root.ov-tcp ? 1 : 0;
                        chosen(i) => { root.ov-tcp = i == 1; }
                    }
                }
                if Device.vpn-form == 1: FormRow {
                    label: @tr("Authentication");
                    Dropdown {
                        width: clamp(parent.width * 0.5, 170px, 280px);
                        x: parent.width - self.width - 20px;
                        options: [@tr("Certificates"), @tr("Password"), @tr("Password and certificates")];
                        selected: root.ov-auth;
                        chosen(i) => { root.ov-auth = i; }
                    }
                }
                if Device.vpn-form == 1: FileField {
                    label: @tr("CA certificate");
                    path: root.ov-ca;
                    choose => { Device.pick-file("ca"); }
                }
                if Device.vpn-form == 1 && root.ov-auth != 1: FileField {
                    label: @tr("User certificate");
                    path: root.ov-cert;
                    choose => { Device.pick-file("cert"); }
                }
                if Device.vpn-form == 1 && root.ov-auth != 1: FileField {
                    label: @tr("Private key");
                    path: root.ov-key;
                    choose => { Device.pick-file("key"); }
                }
                if Device.vpn-form == 1 && root.ov-auth != 0: Field { label: @tr("Username"); text <=> root.ov-user; }
                if Device.vpn-form == 1 && root.ov-auth != 0: Field { label: @tr("Password"); text <=> root.ov-pass; password: true; }

                if Device.vpn-form == 2: Field { label: @tr("Address"); text <=> root.wg-address; placeholder: "10.0.0.2/24"; }
                if Device.vpn-form == 2: Field {
                    label: @tr("Private key");
                    text <=> Device.wg-private-key;
                    password: true;
                    edited(k) => { Device.wg-public-of(k); }
                }
                if Device.vpn-form == 2: HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 10px;
                    height: 40px;
                    PillButton {
                        height: 32px;
                        text: @tr("Generate keys");
                        clicked => { Device.wg-generate-key(); }
                    }
                    // Só leitura, mas dá para selecionar e copiar.
                    TextInput {
                        horizontal-stretch: 1;
                        read-only: true;
                        vertical-alignment: center;
                        text: Device.wg-public-key != "" ? @tr("Your public key: {}", Device.wg-public-key) : "";
                        color: Theme.text-muted;
                        font-family: Theme.mono;
                        font-size: 12px;
                    }
                }
                if Device.vpn-form == 2: Field { label: "DNS"; text <=> root.wg-dns; placeholder: "1.1.1.1"; }
                if Device.vpn-form == 2: Field { label: @tr("Server public key"); text <=> root.wg-peer; }
                if Device.vpn-form == 2: Field { label: @tr("Server"); text <=> root.wg-endpoint; placeholder: "vpn.example.com:51820"; }
                if Device.vpn-form == 2: Field { label: @tr("Allowed IPs"); text <=> root.wg-allowed; placeholder: "0.0.0.0/0"; }

                FormButtons {
                    cancel => { Device.vpn-form = 0; }
                    save => {
                        Device.vpn-message = "";
                        if (Device.vpn-form == 1) {
                            Device.vpn-add-openvpn(root.vpn-name, root.ov-server, root.ov-port, root.ov-tcp, root.ov-auth,
                                root.ov-ca, root.ov-cert, root.ov-key, root.ov-user, root.ov-pass);
                        } else {
                            Device.vpn-add-wireguard(root.vpn-name, root.wg-address, Device.wg-private-key, root.wg-dns,
                                root.wg-peer, root.wg-endpoint, root.wg-allowed);
                        }
                    }
                }
            }
        }
        if Device.vpn-message != "": Text {
            text: Device.vpn-message;
            color: Theme.text;
            font-family: Theme.sans;
            font-size: 13.5px;
            wrap: word-wrap;
        }
    }
    }
}

// ---------------------------------------------------------------------------
// Som
// ---------------------------------------------------------------------------

export component SoundPage inherits Rectangle {
    VerticalLayout {
        x: 0;
        y: Page.top;
        width: min(Page.max-width, parent.width);
        alignment: start;
        spacing: 16px;

        if !Device.sound-available: EmptyNotice {
            icon: Icons.volume;
            title: @tr("No sound output");
            text: @tr("The sound server (PipeWire) found no speakers or headphones.");
        }

        if Device.sound-available: Panel {
            height: 3 * 67px;
            VerticalLayout {
                Row {
                    title: @tr("Output");
                    divider: false;
                    value: Device.sound-output;
                }
                Row {
                    title: "Volume";
                    SliderBar {
                        x: parent.width - self.width - 72px;
                        width: clamp(parent.width * 0.3, 100px, 240px);
                        value <=> Device.volume;
                        changed(v) => { Device.set-volume(v); }
                    }
                    Text {
                        x: parent.width - self.width - 20px;
                        width: 42px;
                        text: Device.muted ? @tr("muted") : round(Device.volume * 100) + "%";
                        color: Theme.text;
                        font-family: Theme.mono;
                        font-size: 13px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
                Row {
                    title: @tr("Mute");
                    subtitle: @tr("Silences the default output");
                    Toggle {
                        x: parent.width - self.width - 20px;
                        checked <=> Device.muted;
                        toggled(on) => { Device.set-muted(on); }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            PillButton {
                text: @tr("More sound options");
                clicked => { Shell.open-app("sound"); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Energia
// ---------------------------------------------------------------------------

export component PowerPage inherits Rectangle {
    property <[string]> blank-options: [@tr("Never"), @tr("1 minute"), @tr("2 minutes"), @tr("3 minutes"),
        @tr("5 minutes"), @tr("10 minutes"), @tr("15 minutes"), @tr("30 minutes")];
    property <[string]> suspend-options: [@tr("Never"), @tr("5 minutes"), @tr("10 minutes"), @tr("15 minutes"),
        @tr("20 minutes"), @tr("30 minutes"), @tr("45 minutes"), @tr("1 hour")];
    property <[string]> lid-options: [@tr("Suspend"), @tr("Lock the screen"), @tr("Do nothing"), @tr("Shut down")];
    property <[string]> button-options: [@tr("Shut down"), @tr("Suspend"), @tr("Do nothing")];
    property <length> control: min(250px, self.width * 0.42);

    // Com rolagem: a página é mais alta que a janela.
    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: power-col.preferred-height + 36px;
        power-col := VerticalLayout {
            x: 0;
            y: 12px;
            width: min(Page.max-width, parent.width);
            alignment: start;
            spacing: 12px;

            Panel {
                height: 67px;
                Row {
                    title: @tr("Battery");
                    subtitle: Device.battery == @tr("No battery") ? @tr("Computer running on AC power")
                        : Device.charging ? @tr("Charging") : @tr("On battery");
                    divider: false;
                    value: Device.battery;
                    value-strong: true;
                }
            }

            if Power.profiles-available: SectionLabel { text: @tr("POWER MODE"); }
            if Power.profiles-available: Panel {
                height: 67px;
                Row {
                    title: Power.profile == 0 ? @tr("Power saver") : Power.profile == 2 ? @tr("Performance") : @tr("Balanced");
                    subtitle: Power.profile == 0 ? @tr("Less performance, more battery life")
                        : Power.profile == 2 ? @tr("Fastest, uses more power and heat")
                        : @tr("Performance and power use in balance");
                    divider: false;
                    Segmented {
                        x: parent.width - self.width - 20px;
                        options: Power.has-performance ? [@tr("Saver"), @tr("Balanced"), @tr("Performance")]
                            : [@tr("Saver"), @tr("Balanced")];
                        selected: Power.profile;
                        chosen(i) => { Power.set-profile(i); }
                    }
                }
            }

            SectionLabel { text: @tr("SAVING"); }
            Panel {
                height: (Power.has-battery ? 4 : 3) * 67px;
                VerticalLayout {
                    Row {
                        title: @tr("Turn off the screen");
                        subtitle: @tr("When the computer is not used for");
                        divider: false;
                        Dropdown {
                            x: parent.width - self.width - 20px;
                            width: root.control;
                            options: root.blank-options;
                            selected: Power.blank;
                            chosen(i) => { Power.blank = i; Power.save(); }
                        }
                    }
                    Row {
                        title: @tr("Lock the screen");
                        subtitle: @tr("When the screen turns off and before suspending");
                        Toggle {
                            x: parent.width - self.width - 20px;
                            checked <=> Power.lock-on-blank;
                            toggled(v) => { Power.save(); }
                        }
                    }
                    if Power.has-battery: Row {
                        title: @tr("Suspend on battery");
                        subtitle: @tr("Automatic suspend when not in use");
                        Dropdown {
                            x: parent.width - self.width - 20px;
                            width: root.control;
                            options: root.suspend-options;
                            selected: Power.suspend-battery;
                            chosen(i) => { Power.suspend-battery = i; Power.save(); }
                        }
                    }
                    Row {
                        title: Power.has-battery ? @tr("Suspend when plugged in") : @tr("Automatic suspend");
                        subtitle: @tr("Automatic suspend when not in use");
                        Dropdown {
                            x: parent.width - self.width - 20px;
                            width: root.control;
                            options: root.suspend-options;
                            selected: Power.suspend-ac;
                            chosen(i) => { Power.suspend-ac = i; Power.save(); }
                        }
                    }
                }
            }

            SectionLabel { text: @tr("BUTTONS AND LID"); }
            Panel {
                height: (Power.has-lid ? 3 : 1) * 67px;
                VerticalLayout {
                    if Power.has-lid: Row {
                        title: @tr("Closing the lid on battery");
                        divider: false;
                        Dropdown {
                            x: parent.width - self.width - 20px;
                            width: root.control;
                            enabled: !Power.system-busy;
                            options: root.lid-options;
                            selected: Power.lid-battery;
                            chosen(i) => { Power.lid-battery = i; Power.save-system(); }
                        }
                    }
                    if Power.has-lid: Row {
                        title: @tr("Closing the lid when plugged in");
                        Dropdown {
                            x: parent.width - self.width - 20px;
                            width: root.control;
                            enabled: !Power.system-busy;
                            options: root.lid-options;
                            selected: Power.lid-ac;
                            chosen(i) => { Power.lid-ac = i; Power.save-system(); }
                        }
                    }
                    Row {
                        title: @tr("Power button");
                        divider: Power.has-lid;
                        Dropdown {
                            x: parent.width - self.width - 20px;
                            width: root.control;
                            enabled: !Power.system-busy;
                            options: root.button-options;
                            selected: Power.power-button;
                            chosen(i) => { Power.power-button = i; Power.save-system(); }
                        }
                    }
                }
            }
            if Power.message != "": Text {
                text: Power.message;
                color: Theme.text-muted;
                font-family: Theme.sans;
                font-size: 13px;
            }

            SectionLabel { text: @tr("SHUT DOWN"); }
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                PillButton {
                    text: @tr("Suspend");
                    clicked => { Device.power-action("suspend"); }
                }
                PillButton {
                    text: @tr("Restart");
                    clicked => { Device.power-action("reboot"); }
                }
                PillButton {
                    text: @tr("Shut down");
                    danger: true;
                    clicked => { Shell.power-off(); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Usuários
// ---------------------------------------------------------------------------

/// Uma conta na lista de Usuários: avatar, nome e login/tipo.
component AccountRow inherits Rectangle {
    in property <UserAccount> account;
    in property <bool> divider: true;
    in property <bool> clickable: false;
    in property <bool> selected: false;
    callback clicked();
    height: 64px;
    background: root.selected ? Theme.accent-soft : touch.has-hover && root.clickable ? Theme.tile-hover : transparent;
    if root.divider: Rectangle { y: 0; height: 1px; background: Theme.border; }
    Avatar {
        x: 20px;
        width: 40px;
        height: 40px;
        letter: root.account.initial;
        filled: root.account.me;
    }
    VerticalLayout {
        x: 76px;
        width: parent.width - self.x - 56px;
        alignment: center;
        spacing: 3px;
        Text { text: root.account.name; color: Theme.text; font-family: Theme.sans; font-size: 14.5px; font-weight: 600; overflow: elide; }
        Text {
            text: root.account.login + " · " + (root.account.admin ? @tr("Administrator") : @tr("Standard"))
                + (root.account.signed-in && !root.account.me ? " · " + @tr("signed in") : "");
            color: Theme.text-muted;
            font-family: Theme.sans;
            font-size: 13px;
            overflow: elide;
        }
    }
    if root.clickable: Image {
        x: parent.width - 36px;
        width: 16px;
        height: 16px;
        source: root.selected ? Icons.chevron-down : Icons.chevron-right;
        colorize: Theme.text-muted;
    }
    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

/// Aviso de validação dentro de um formulário.
component FormHint inherits Rectangle {
    in property <string> text;
    in property <bool> error: true;
    height: root.text == "" ? 0 : 26px;
    Text {
        x: 20px;
        width: parent.width - 40px;
        text: root.text;
        color: root.error ? Theme.danger : Theme.text-muted;
        font-family: Theme.sans;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component UsersPage inherits Rectangle {
    // Formulário "Alterar senha".
    property <string> pw-current;
    property <string> pw-new;
    property <string> pw-confirm;
    property <string> pw-error;
    // Formulário "Adicionar usuário".
    property <string> add-name;
    property <string> add-login;
    /// O login foi digitado à mão (deixa de seguir o nome).
    property <bool> add-login-edited;
    property <bool> add-admin;
    property <string> add-pass;
    property <string> add-confirm;
    property <string> add-error;
    // Formulário de outra conta.
    property <string> ed-name;
    property <bool> ed-admin;
    property <string> ed-pass;
    property <string> ed-confirm;
    property <string> ed-error;
    property <bool> ed-removing;
    property <UserAccount> ed-account;

    function open-form(form: string) {
        Accounts.message = "";
        Accounts.form = form;
        root.pw-current = ""; root.pw-new = ""; root.pw-confirm = ""; root.pw-error = "";
        root.add-name = ""; root.add-login = ""; root.add-login-edited = false; root.add-admin = false;
        root.add-pass = ""; root.add-confirm = ""; root.add-error = "";
        root.ed-pass = ""; root.ed-confirm = ""; root.ed-error = ""; root.ed-removing = false;
    }
    function open-edit(u: UserAccount) {
        if (Accounts.form == "edit" && Accounts.editing == u.login) {
            Accounts.form = "";
            return;
        }
        root.open-form("edit");
        Accounts.editing = u.login;
        root.ed-account = u;
        root.ed-name = u.name;
        root.ed-admin = u.admin;
    }
    /// Erro das duas senhas ("" = ok).
    function password-error(a: string, b: string) -> string {
        if (a == "") { return @tr("Type the new password"); }
        if (a != b) { return @tr("The passwords do not match"); }
        return "";
    }

    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: users-col.preferred-height + 36px;
        users-col := VerticalLayout {
            x: 0;
            y: 12px;
            width: min(Page.max-width, parent.width);
            alignment: start;
            spacing: 12px;

            SectionLabel { text: @tr("YOUR ACCOUNT"); }
            Panel {
                height: 64px;
                AccountRow { account: Accounts.me; divider: false; }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                PillButton {
                    text: @tr("Change password");
                    clicked => { root.open-form(Accounts.form == "password" ? "" : "password"); }
                }
                PillButton {
                    text: @tr("Log out");
                    clicked => { Shell.open-app("logout"); }
                }
            }

            if Accounts.form == "password": Panel {
                height: pw-col.preferred-height;
                pw-col := VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 14px;
                    FormTitle { text: @tr("Change password"); }
                    Field { label: @tr("Current password"); password: true; text <=> root.pw-current; }
                    Field { label: @tr("New password"); password: true; text <=> root.pw-new; }
                    Field { label: @tr("Confirm"); password: true; text <=> root.pw-confirm; }
                    FormHint { text: root.pw-error; }
                    FormHint {
                        error: !Accounts.busy;
                        text: Accounts.busy ? @tr("Please wait...") : Accounts.message-error ? Accounts.message : "";
                    }
                    FormButtons {
                        busy: Accounts.busy;
                        cancel => { Accounts.form = ""; }
                        save => {
                            if (root.pw-current == "") {
                                root.pw-error = @tr("Type your current password");
                                return;
                            }
                            root.pw-error = root.password-error(root.pw-new, root.pw-confirm);
                            if (root.pw-error == "") {
                                Accounts.change-own-password(root.pw-current, root.pw-new);
                            }
                        }
                    }
                }
            }

            SectionLabel { text: @tr("OTHER USERS"); }
            Panel {
                height: others-col.preferred-height;
                others-col := VerticalLayout {
                    if Accounts.others.length == 0: Rectangle {
                        height: 56px;
                        Text {
                            x: 20px;
                            text: @tr("No other users on this computer");
                            color: Theme.text-muted;
                            font-family: Theme.sans;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                    for u[i] in Accounts.others: AccountRow {
                        account: u;
                        divider: i > 0;
                        clickable: Accounts.can-manage;
                        selected: Accounts.form == "edit" && Accounts.editing == u.login;
                        clicked => { root.open-edit(u); }
                    }
                }
            }

            if Accounts.form == "edit": Panel {
                height: ed-col.preferred-height;
                ed-col := VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 14px;
                    FormTitle { text: root.ed-account.login; }
                    Field { label: @tr("Full name"); text <=> root.ed-name; }
                    FormRow {
                        label: @tr("Account type");
                        Segmented {
                            x: parent.width - self.width - 20px;
                            options: [@tr("Standard"), @tr("Administrator")];
                            selected: root.ed-admin ? 1 : 0;
                            chosen(i) => { root.ed-admin = i == 1; }
                        }
                    }
                    Field { label: @tr("New password"); password: true; placeholder: @tr("Leave empty to keep"); text <=> root.ed-pass; }
                    Field { label: @tr("Confirm"); password: true; text <=> root.ed-confirm; }
                    FormHint { text: root.ed-error; }
                    FormHint {
                        error: !Accounts.busy;
                        text: Accounts.busy ? @tr("Please wait...") : Accounts.message-error ? Accounts.message : "";
                    }
                    FormButtons {
                        busy: Accounts.busy;
                        cancel => { Accounts.form = ""; }
                        save => {
                            root.ed-error = root.ed-name == "" ? @tr("Type the name")
                                : root.ed-pass == "" && root.ed-confirm == "" ? ""
                                : root.password-error(root.ed-pass, root.ed-confirm);
                            if (root.ed-error == "") {
                                Accounts.update(root.ed-account.login, root.ed-name, root.ed-admin, root.ed-pass);
                            }
                        }
                    }
                    Rectangle { height: 14px; Rectangle { y: 7px; height: 1px; background: Theme.border; } }
                    if !root.ed-removing: HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: start;
                        PillButton {
                            text: @tr("Remove user...");
                            danger: true;
                            enabled: !root.ed-account.signed-in && !Accounts.busy;
                            clicked => { root.ed-removing = true; }
                        }
                    }
                    if !root.ed-removing && root.ed-account.signed-in: FormHint {
                        error: false;
                        text: @tr("Signed in now: log this user out before removing.");
                    }
                    if root.ed-removing: VerticalLayout {
                        spacing: 8px;
                        Text {
                            x: 20px;
                            width: parent.width - 40px;
                            text: @tr("Remove {}? Their files in /home/{} can be kept or deleted.", root.ed-account.name, root.ed-account.login);
                            color: Theme.text;
                            font-family: Theme.sans;
                            font-size: 13.5px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 10px;
                            alignment: end;
                            PillButton { text: @tr("Cancel"); clicked => { root.ed-removing = false; } }
                            PillButton {
                                text: @tr("Keep files");
                                enabled: !Accounts.busy;
                                clicked => { Accounts.remove(root.ed-account.login, false); }
                            }
                            PillButton {
                                text: @tr("Delete files");
                                danger: true;
                                enabled: !Accounts.busy;
                                clicked => { Accounts.remove(root.ed-account.login, true); }
                            }
                        }
                    }
                }
            }

            if Accounts.can-manage && Accounts.form != "add": HorizontalLayout {
                alignment: start;
                PillButton {
                    text: @tr("Add user...");
                    clicked => { root.open-form("add"); }
                }
            }
            if !Accounts.can-manage: Text {
                text: @tr("Only administrators can add or change other users.");
                color: Theme.text-muted;
                font-family: Theme.sans;
                font-size: 13.5px;
                wrap: word-wrap;
            }

            if Accounts.form == "add": Panel {
                height: add-col.preferred-height;
                add-col := VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 14px;
                    FormTitle { text: @tr("Add user"); }
                    Field {
                        label: @tr("Full name");
                        placeholder: @tr("e.g. Maria Silva");
                        text <=> root.add-name;
                        edited(t) => {
                            if (!root.add-login-edited) {
                                root.add-login = Accounts.suggest-login(t);
                            }
                        }
                    }
                    Field {
                        label: @tr("Username");
                        text <=> root.add-login;
                        edited(t) => { root.add-login-edited = t != ""; }
                    }
                    FormHint { error: false; text: root.add-login != "" ? @tr("Home folder: /home/{}, private to this user", root.add-login) : ""; }
                    FormRow {
                        label: @tr("Account type");
                        Segmented {
                            x: parent.width - self.width - 20px;
                            options: [@tr("Standard"), @tr("Administrator")];
                            selected: root.add-admin ? 1 : 0;
                            chosen(i) => { root.add-admin = i == 1; }
                        }
                    }
                    Field { label: @tr("Password"); password: true; text <=> root.add-pass; }
                    Field { label: @tr("Confirm"); password: true; text <=> root.add-confirm; }
                    FormHint { text: root.add-error; }
                    FormHint {
                        error: !Accounts.busy;
                        text: Accounts.busy ? @tr("Please wait...") : Accounts.message-error ? Accounts.message : "";
                    }
                    FormButtons {
                        busy: Accounts.busy;
                        cancel => { Accounts.form = ""; }
                        save => {
                            root.add-error = root.add-name == "" ? @tr("Type the name")
                                : Accounts.check-login(root.add-login) != "" ? Accounts.check-login(root.add-login)
                                : root.password-error(root.add-pass, root.add-confirm);
                            if (root.add-error == "") {
                                Accounts.create(root.add-name, root.add-login, root.add-pass, root.add-admin);
                            }
                        }
                    }
                }
            }

            // Com um formulário aberto, o resultado aparece dentro dele.
            if Accounts.form == "" && (Accounts.busy || Accounts.message != ""): Text {
                text: Accounts.busy ? @tr("Please wait...") : Accounts.message;
                color: Accounts.message-error && !Accounts.busy ? Theme.danger : Theme.text-muted;
                font-family: Theme.sans;
                font-size: 13.5px;
                wrap: word-wrap;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Impressoras
// ---------------------------------------------------------------------------

/// Uma impressora instalada; clicada, mostra as ações embaixo.
component PrinterRow inherits Rectangle {
    in property <Printer> printer;
    in property <bool> divider: true;
    in property <bool> open: false;
    callback clicked();
    height: 64px;
    background: root.open ? Theme.accent-soft : touch.has-hover ? Theme.tile-hover : transparent;
    if root.divider: Rectangle { y: 0; height: 1px; background: Theme.border; }
    Image {
        x: 22px;
        width: 22px;
        height: 22px;
        source: Icons.printer;
        colorize: root.printer.stopped ? Theme.danger : Theme.accent;
    }
    VerticalLayout {
        x: 62px;
        width: parent.width - self.x - 50px;
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: root.printer.info; color: Theme.text; font-family: Theme.sans; font-size: 14.5px; font-weight: 600; overflow: elide; }
            if root.printer.is-default: Text { text: @tr("Default"); color: Theme.accent; font-family: Theme.sans; font-size: 12.5px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
        }
        Text {
            text: root.printer.state
                + (root.printer.jobs > 0 ? " · " + @tr("{} in the queue", root.printer.jobs) : "")
                + " · " + (root.printer.network ? @tr("Network") : "USB");
            color: root.printer.stopped ? Theme.danger : Theme.text-muted;
            font-family: Theme.sans;
            font-size: 13px;
            overflow: elide;
        }
    }
    Image {
        x: parent.width - 36px;
        width: 16px;
        height: 16px;
        source: root.open ? Icons.chevron-down : Icons.chevron-right;
        colorize: Theme.text-muted;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PrintersPage inherits Rectangle {
    /// Impressora aberta (mostra as ações).
    property <string> open-name;
    property <string> address;

    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: printers-col.preferred-height + 36px;
        printers-col := VerticalLayout {
            x: 0;
            y: 12px;
            width: min(Page.max-width, parent.width);
            alignment: start;
            spacing: 12px;

            if !Printers.available: EmptyNotice {
                icon: Icons.printer;
                title: @tr("Printing is not installed");
                text: @tr("Printers work in the KalangOS session, with CUPS installed.");
            }

            if Printers.available: SectionLabel { text: @tr("PRINTERS"); }
            if Printers.available: Panel {
                height: list-col.preferred-height;
                list-col := VerticalLayout {
                    if Printers.list.length == 0: Rectangle {
                        height: 64px;
                        Text {
                            x: 20px;
                            width: parent.width - 40px;
                            text: @tr("No printers yet. Printers on the network usually show up here by themselves.");
                            color: Theme.text-muted;
                            font-family: Theme.sans;
                            font-size: 14px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    for p[i] in Printers.list: VerticalLayout {
                        PrinterRow {
                            printer: p;
                            divider: i > 0;
                            open: root.open-name == p.name;
                            clicked => { root.open-name = root.open-name == p.name ? "" : p.name; }
                        }
                        if root.open-name == p.name: HorizontalLayout {
                            padding-left: 62px;
                            padding-right: 20px;
                            padding-bottom: 14px;
                            spacing: 10px;
                            alignment: start;
                            if !p.is-default: PillButton {
                                text: @tr("Make default");
                                enabled: !Printers.busy;
                                clicked => { Printers.set-default(p.name); }
                            }
                            PillButton {
                                text: @tr("Test page");
                                enabled: !Printers.busy;
                                clicked => { Printers.test-page(p.name); }
                            }
                            if p.jobs > 0: PillButton {
                                text: @tr("Cancel jobs");
                                enabled: !Printers.busy;
                                clicked => { Printers.cancel-jobs(p.name); }
                            }
                            PillButton {
                                text: @tr("Remove");
                                danger: true;
                                enabled: !Printers.busy;
                                clicked => {
                                    Printers.remove(p.name);
                                    root.open-name = "";
                                }
                            }
                        }
                    }
                }
            }

            if Printers.available && !Printers.adding: HorizontalLayout {
                alignment: start;
                spacing: 12px;
                PillButton {
                    text: @tr("Add printer...");
                    clicked => {
                        Printers.adding = true;
                        Printers.message = "";
                        Printers.search();
                    }
                }
                PillButton {
                    text: @tr("Advanced options");
                    clicked => { Printers.advanced(); }
                }
            }

            if Printers.available && Printers.adding: Panel {
                height: add-col.preferred-height;
                add-col := VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 14px;
                    HorizontalLayout {
                        padding-right: 20px;
                        FormTitle { text: @tr("Add printer"); }
                        PillButton {
                            height: 34px;
                            text: Printers.searching ? @tr("Searching...") : @tr("Search again");
                            enabled: !Printers.searching;
                            clicked => { Printers.search(); }
                        }
                    }
                    if !Printers.searching && Printers.found.length == 0: Text {
                        x: 20px;
                        width: parent.width - 40px;
                        height: 40px;
                        text: @tr("No new printer found. Check that it is on and connected (cable or the same network).");
                        color: Theme.text-muted;
                        font-family: Theme.sans;
                        font-size: 13.5px;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    for d[i] in Printers.found: Rectangle {
                        height: 56px;
                        if i > 0: Rectangle { y: 0; height: 1px; background: Theme.border; }
                        VerticalLayout {
                            x: 20px;
                            width: parent.width - 150px;
                            alignment: center;
                            spacing: 2px;
                            Text { text: d.name; color: Theme.text; font-family: Theme.sans; font-size: 14px; font-weight: 600; overflow: elide; }
                            Text { text: d.kind; color: Theme.text-muted; font-family: Theme.sans; font-size: 12.5px; }
                        }
                        PillButton {
                            x: parent.width - self.width - 20px;
                            height: 34px;
                            text: @tr("Add");
                            primary: true;
                            enabled: !Printers.busy;
                            clicked => { Printers.add(d.uri, d.name); }
                        }
                    }
                    Rectangle { height: 8px; }
                    Field {
                        label: @tr("Address");
                        placeholder: @tr("IP or name on the network, e.g. 192.168.0.50");
                        text <=> root.address;
                    }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 6px;
                        spacing: 10px;
                        alignment: end;
                        PillButton { text: @tr("Close"); clicked => { Printers.adding = false; } }
                        PillButton {
                            text: @tr("Add by address");
                            primary: true;
                            enabled: !Printers.busy && root.address != "";
                            clicked => { Printers.add-address(root.address); }
                        }
                    }
                }
            }

            if Printers.busy || Printers.message != "": Text {
                text: Printers.busy ? @tr("Please wait...") : Printers.message;
                color: Printers.message-error && !Printers.busy ? Theme.danger : Theme.text-muted;
                font-family: Theme.sans;
                font-size: 13.5px;
                wrap: word-wrap;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Compartilhamento
// ---------------------------------------------------------------------------

export component SharingPage inherits Rectangle {
    // Com rolagem: pastas + computadores da rede passam da altura da janela.
    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: sharing-col.preferred-height + 36px;
        sharing-col := VerticalLayout {
            x: 0;
            y: 12px;
            width: min(Page.max-width, parent.width);
            alignment: start;
            spacing: 12px;

            if !Device.sharing-available: EmptyNotice {
                icon: Icons.folder;
                title: @tr("File sharing is not installed");
                text: @tr("Sharing folders works in the KalangOS session, with Samba installed.");
            }

            if Device.sharing-available: SectionLabel { text: @tr("FILE SHARING"); }
            if Device.sharing-available: Panel {
                height: 3 * 67px;
                VerticalLayout {
                    Row {
                        title: @tr("Share folders on the network");
                        subtitle: Device.sharing-busy ? @tr("Please wait...")
                            : Device.sharing-enabled ? @tr("Visible as {} on the local network", Device.sharing-name)
                            : @tr("Off");
                        divider: false;
                        Toggle {
                            x: parent.width - self.width - 20px;
                            checked <=> Device.sharing-enabled;
                            toggled(on) => { Device.set-sharing(on); }
                        }
                    }
                    Row {
                        title: @tr("Access without a password");
                        subtitle: @tr("Visitors can open and copy files, but not change them");
                        Toggle {
                            x: parent.width - self.width - 20px;
                            checked <=> Device.sharing-guest;
                            toggled(on) => { Device.set-sharing-guest(on); }
                        }
                    }
                    Row {
                        title: @tr("Network password");
                        subtitle: @tr("To change files from another computer, sign in as {}", Device.login);
                        PillButton {
                            x: parent.width - self.width - 20px;
                            text: @tr("Set password");
                            clicked => { Device.sharing-password(); }
                        }
                    }
                }
            }

            if Device.sharing-available: HorizontalLayout {
                SectionLabel { text: @tr("SHARED FOLDERS"); }
                Text {
                    horizontal-alignment: right;
                    text: @tr("Click to share or stop sharing");
                    color: Theme.text-muted;
                    font-family: Theme.sans;
                    font-size: 12.5px;
                }
            }
            if Device.sharing-available: Rectangle {
                height: ceil(Device.sharing-folders.length / 3) * (44px + 8px) - 8px;
                for folder[i] in Device.sharing-folders: Rectangle {
                    x: Math.mod(i, 3) * (parent.width + 8px) / 3;
                    y: floor(i / 3) * (44px + 8px);
                    width: (parent.width + 8px) / 3 - 8px;
                    height: 44px;
                    border-radius: Theme.radius-small;
                    background: folder.shared ? Theme.accent-soft : folder-touch.has-hover ? Theme.tile-hover : Theme.tile;
                    border-width: 1px;
                    border-color: folder.shared ? Theme.accent.with-alpha(0.55) : Theme.border;
                    opacity: Device.sharing-busy ? 0.6 : 1;
                    Image {
                        x: 12px;
                        source: Icons.folder;
                        colorize: folder.shared ? Theme.accent : Theme.text-muted;
                        width: 18px;
                        height: 18px;
                    }
                    Text {
                        x: 40px;
                        width: parent.width - 48px;
                        text: folder.name;
                        color: Theme.text;
                        font-family: Theme.sans;
                        font-size: 13.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    folder-touch := TouchArea {
                        enabled: !Device.sharing-busy;
                        mouse-cursor: pointer;
                        clicked => { Device.toggle-shared-folder(i); }
                    }
                }
            }
            if Device.sharing-message != "": Text {
                text: Device.sharing-message;
                color: Theme.text-muted;
                font-family: Theme.sans;
                font-size: 13.5px;
                wrap: word-wrap;
            }

            // --- Computadores da rede ---
            HorizontalLayout {
                height: 24px;
                SectionLabel { text: @tr("COMPUTERS ON THE NETWORK"); vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                PillButton {
                    height: 24px;
                    text: Device.computers-busy ? @tr("Please wait...") : @tr("Refresh");
                    enabled: !Device.computers-busy;
                    clicked => { Device.refresh-computers(); }
                }
            }
            Panel {
                height: max(1, Device.computers.length) * 52px;
                if Device.computers.length == 0: Text {
                    x: 20px;
                    text: Device.computers-busy ? @tr("Looking for computers...")
                        : @tr("No computers sharing files were found. Try the address below.");
                    color: Theme.text-muted;
                    font-family: Theme.sans;
                    font-size: 13.5px;
                    vertical-alignment: center;
                }
                for pc[i] in Device.computers: Rectangle {
                    y: i * 52px;
                    height: 52px;
                    background: pc-touch.has-hover ? Theme.tile : transparent;
                    border-radius: Theme.radius;
                    if i > 0: Rectangle { y: 0; height: 1px; background: Theme.border; }
                    Image {
                        x: 20px;
                        source: Icons.monitor;
                        colorize: Theme.accent;
                        width: 18px;
                        height: 18px;
                    }
                    Text {
                        x: 52px;
                        text: pc.name;
                        color: Theme.text;
                        font-family: Theme.sans;
                        font-size: 14.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: parent.width - self.width - 44px;
                        text: pc.host;
                        color: Theme.text-muted;
                        font-family: Theme.mono;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                    Image {
                        x: parent.width - 34px;
                        source: Icons.chevron-right;
                        colorize: Theme.text-muted;
                        width: 16px;
                        height: 16px;
                    }
                    pc-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Device.open-computer(i); }
                    }
                }
            }
            Panel {
                height: 67px;
                Rectangle {
                    x: 20px;
                    width: parent.width - 40px - connect-btn.width - 10px - browse-btn.width - 10px;
                    height: 38px;
                    border-radius: Theme.radius-small;
                    background: Theme.sunken;
                    border-width: 1px;
                    border-color: address.has-focus ? Theme.accent : Theme.border;
                    // O exemplo corta com "…" quando a janela é estreita.
                    if address.text == "": Text {
                        x: 12px;
                        width: parent.width - 24px;
                        overflow: elide;
                        text: @tr("Server address, e.g. 192.168.0.10 or \\\\pc\\folder");
                        color: Theme.text-muted;
                        font-family: Theme.sans;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    address := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        color: Theme.text;
                        font-family: Theme.sans;
                        font-size: 14px;
                        accepted => { connect-btn.clicked(); }
                    }
                }
                connect-btn := PillButton {
                    x: parent.width - self.width - 20px - browse-btn.width - 10px;
                    text: @tr("Connect");
                    primary: true;
                    enabled: address.text != "";
                    clicked => { Device.connect-server(address.text); }
                }
                browse-btn := PillButton {
                    x: parent.width - self.width - 20px;
                    text: @tr("Browse network");
                    clicked => { Device.browse-network(); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Idioma e região
// ---------------------------------------------------------------------------

export component RegionPage inherits Rectangle {
    VerticalLayout {
        x: 0;
        y: Page.top;
        width: min(Page.max-width, parent.width);
        alignment: start;
        spacing: 16px;

        Panel {
            height: 2 * 67px;
            VerticalLayout {
                Row {
                    title: @tr("Language");
                    subtitle: @tr("Menus, settings and apps");
                    divider: false;
                    Dropdown {
                        // Encolhe em janela estreita.
                        width: clamp(parent.width * 0.4, 150px, 250px);
                        x: parent.width - self.width - 20px;
                        options: Device.languages;
                        selected: Device.language-index;
                        chosen(i) => { Device.set-language(i); }
                    }
                }
                Row {
                    title: @tr("Keyboard");
                    subtitle: Device.keyboard-message != "" ? Device.keyboard-message : @tr("Layout of the keys");
                    Dropdown {
                        // Encolhe em janela estreita.
                        width: clamp(parent.width * 0.4, 150px, 250px);
                        x: parent.width - self.width - 20px;
                        options: Device.keyboard-layouts;
                        selected: Device.keyboard-index;
                        chosen(i) => { Device.set-keyboard(i); }
                    }
                }
            }
        }

        if Device.language-pending: Panel {
            height: 67px;
            Row {
                title: @tr("Sign out to change the language");
                subtitle: @tr("Open apps keep the current language until then");
                divider: false;
                PillButton {
                    x: parent.width - self.width - 20px;
                    text: @tr("Log out");
                    primary: true;
                    clicked => { Shell.open-app("logout"); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Atualizações
// ---------------------------------------------------------------------------

export component UpdatesPage inherits Rectangle {
    property <bool> busy: Updates.state == "checking" || Updates.state == "installing";

    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: up-col.preferred-height + 36px;
        up-col := VerticalLayout {
            x: 0;
            y: 12px;
            width: min(Page.max-width, parent.width);
            alignment: start;
            spacing: 12px;

            Panel {
                height: 67px;
                Row {
                    title: Updates.state == "checking" ? @tr("Checking for updates...")
                        : Updates.state == "installing" ? @tr("Installing updates...")
                        : Updates.list.length == 0 ? @tr("Everything is up to date")
                        : Updates.list.length == 1 ? @tr("1 update available")
                        : @tr("{} updates available", Updates.list.length);
                    subtitle: Updates.last-check;
                    divider: false;
                    HorizontalLayout {
                        x: parent.width - self.preferred-width - 20px;
                        width: self.preferred-width;
                        spacing: 10px;
                        alignment: end;
                        PillButton {
                            y: (67px - self.height) / 2;
                            text: @tr("Check now");
                            enabled: !root.busy;
                            clicked => { Updates.check(); }
                        }
                        if Updates.list.length > 0: PillButton {
                            y: (67px - self.height) / 2;
                            text: @tr("Install");
                            primary: true;
                            enabled: !root.busy;
                            clicked => { Updates.install(); }
                        }
                    }
                }
            }

            // Barra de progresso e o que está fazendo.
            if Updates.state == "installing": Panel {
                height: 74px;
                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.sunken;
                        Rectangle {
                            x: 0;
                            width: parent.width * max(0.02, Updates.progress);
                            border-radius: 4px;
                            background: Theme.accent;
                            animate width { duration: 300ms; }
                        }
                    }
                    Text {
                        text: Updates.status;
                        color: Theme.text-muted;
                        font-family: Theme.sans;
                        font-size: 13px;
                        overflow: elide;
                    }
                }
            }

            if Updates.message != "": Text {
                text: Updates.message;
                color: Updates.state == "error" ? Theme.danger : Theme.text-muted;
                font-family: Theme.sans;
                font-size: 13.5px;
                wrap: word-wrap;
            }
            if Updates.reboot-needed && Updates.state != "installing": HorizontalLayout {
                alignment: start;
                PillButton {
                    text: @tr("Restart now");
                    primary: true;
                    clicked => { Updates.reboot(); }
                }
            }

            if Updates.list.length > 0: SectionLabel { text: @tr("AVAILABLE"); }
            if Updates.list.length > 0: Panel {
                height: list-col.preferred-height;
                list-col := VerticalLayout {
                    for u[i] in Updates.list: Rectangle {
                        height: 50px;
                        if i > 0: Rectangle { y: 0; height: 1px; background: Theme.border; }
                        Image {
                            x: 20px;
                            width: 18px;
                            height: 18px;
                            source: u.app ? Icons.bag : Icons.download;
                            colorize: Theme.text-muted;
                        }
                        Text {
                            x: 52px;
                            width: parent.width * 0.45;
                            text: u.name;
                            color: Theme.text;
                            font-family: Theme.sans;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width * 0.5;
                            width: parent.width * 0.5 - 20px;
                            text: u.version;
                            color: Theme.text-muted;
                            font-family: Theme.mono;
                            font-size: 12px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Bluetooth e Monitores
// ---------------------------------------------------------------------------

/// Linha de um aparelho Bluetooth: clicar conecta/desconecta (pareia antes,
/// se for novo); os pareados têm "Esquecer".
component BtRow inherits Rectangle {
    in property <BtDevice> dev;
    in property <bool> divider: true;
    height: 56px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.tile : transparent;

    property <bool> busy: Device.bt-busy-mac == root.dev.mac;

    if root.divider: Rectangle { x: 20px; y: 0; width: parent.width - 40px; height: 1px; background: Theme.border; }
    Image {
        x: 20px;
        source: root.dev.kind == "audio" ? Icons.music
            : root.dev.kind == "computer" ? Icons.monitor
            : Icons.bluetooth;
        colorize: root.dev.connected ? Theme.accent : Theme.text-muted;
        width: 18px;
        height: 18px;
    }
    Text {
        x: 54px;
        width: parent.width - self.x - right.preferred-width - 32px;
        text: root.dev.name;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 14.5px;
        font-weight: root.dev.connected ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (Device.bt-busy-mac == "") {
                Device.bt-message = "";
                if (root.dev.connected) {
                    Device.bt-disconnect(root.dev.mac);
                } else {
                    Device.bt-connect(root.dev.mac, root.dev.name, root.dev.paired);
                }
            }
        }
    }
    right := HorizontalLayout {
        x: parent.width - self.preferred-width - 20px;
        width: self.preferred-width;
        spacing: 10px;
        if root.dev.paired && !root.busy: ForgetLink {
            font-size: 12.5px;
            clicked => { Device.bt-forget(root.dev.mac); }
        }
        Text {
            text: root.busy ? @tr("Connecting...")
                : root.dev.connected ? @tr("Connected")
                : root.dev.paired ? @tr("Not connected") : "";
            color: root.dev.connected ? Theme.accent : Theme.text-muted;
            font-family: Theme.sans;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

export component BluetoothPage inherits Rectangle {
    // Procura aparelhos ao abrir a página (como no Ubuntu).
    init => {
        if (Device.bt-available && Device.bt-powered) {
            Device.bt-scan();
        }
    }
    property <int> paired-count: root.count-paired(Device.bt-devices);
    pure function count-paired(list: [BtDevice]) -> int {
        // Os pareados vêm primeiro na lista (ordem do Rust).
        return Device.bt-paired-count(list);
    }

    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: bt-col.preferred-height + 36px;
        bt-col := VerticalLayout {
            x: 0;
            y: 12px;
            width: min(Page.max-width, parent.width);
            alignment: start;
            spacing: 16px;

            if !Device.bluetooth-present: EmptyNotice {
                icon: Icons.bluetooth;
                title: @tr("No Bluetooth adapter");
                text: @tr("This computer has no Bluetooth, or it is turned off.");
            }
            if Device.bluetooth-present && !Device.bt-available: EmptyNotice {
                icon: Icons.bluetooth;
                title: @tr("Bluetooth service unavailable");
                text: @tr("The Bluetooth service (BlueZ) did not respond. Check that it is installed and running.");
            }

            if Device.bt-available: Panel {
                height: 67px;
                Row {
                    title: "Bluetooth";
                    subtitle: Device.bt-powered ? @tr("On") : @tr("Off");
                    divider: false;
                    Toggle {
                        x: parent.width - self.width - 20px;
                        checked <=> Device.bt-powered;
                        toggled(on) => {
                            Device.set-bt(on);
                            if (on) {
                                Device.bt-scan();
                            }
                        }
                    }
                }
            }

            // --- Meus aparelhos (pareados) ---
            if Device.bt-available && Device.bt-powered && root.paired-count > 0: SectionLabel {
                text: @tr("MY DEVICES");
            }
            if Device.bt-available && Device.bt-powered && root.paired-count > 0: Panel {
                height: root.paired-count * 56px;
                for dev[i] in Device.bt-devices: BtRow {
                    y: i * 56px;
                    visible: i < root.paired-count;
                    dev: dev;
                    divider: i > 0;
                }
            }

            // --- Outros aparelhos (encontrados) ---
            if Device.bt-available && Device.bt-powered: HorizontalLayout {
                height: 24px;
                SectionLabel { text: @tr("OTHER DEVICES"); vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                PillButton {
                    height: 24px;
                    text: Device.bt-scanning ? @tr("Searching...") : @tr("Search");
                    enabled: !Device.bt-scanning;
                    clicked => { Device.bt-scan(); }
                }
            }
            if Device.bt-available && Device.bt-powered: Panel {
                height: max(1, Device.bt-devices.length - root.paired-count) * 56px;
                if Device.bt-devices.length == root.paired-count: Text {
                    text: Device.bt-scanning ? @tr("Searching for devices...")
                        : @tr("No devices found. Put the device in pairing mode and search again.");
                    color: Theme.text-muted;
                    font-family: Theme.sans;
                    font-size: 13.5px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    width: parent.width - 40px;
                }
                for dev[i] in Device.bt-devices: BtRow {
                    y: (i - root.paired-count) * 56px;
                    visible: i >= root.paired-count;
                    dev: dev;
                    divider: i > root.paired-count;
                }
            }

            if Device.bt-message != "": Text {
                text: Device.bt-message;
                color: Theme.text;
                font-family: Theme.sans;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Monitores
// ---------------------------------------------------------------------------

export component DisplaysPage inherits Rectangle {
    /// Monitor escolhido (quando há mais de um).
    property <int> sel: 0;
    property <DisplayOutput> out: Device.displays.length > 0
        ? Device.displays[min(root.sel, Device.displays.length - 1)] : {};

    // Escolhas ainda não aplicadas (-1 = mantém a atual).
    property <int> edit-res: -1;
    property <int> edit-rate: -1;
    property <int> edit-scale: -1;
    property <int> edit-rot: -1;
    property <int> edit-on: -1;

    // Valores exibidos: a escolha ou o atual.
    property <int> res: root.edit-res >= 0 ? root.edit-res : root.out.resolution;
    // Outra resolução começa pela maior taxa.
    property <int> rate: root.edit-rate >= 0 ? root.edit-rate : root.edit-res >= 0 ? 0 : root.out.rate;
    property <int> scale: root.edit-scale >= 0 ? root.edit-scale : root.out.scale;
    property <int> rot: root.edit-rot >= 0 ? root.edit-rot : root.out.rotation;
    property <bool> on: root.edit-on >= 0 ? root.edit-on == 1 : root.out.enabled;
    property <DisplayResolution> mode: root.res < root.out.resolutions.length ? root.out.resolutions[root.res] : {};

    /// A escala deixa ao menos 1024×600 pontos para o shell (igual a
    /// `scale_fits` no Rust; em pé, largura e altura trocam).
    property <float> scale-value: Device.display-scale-values[root.scale];
    property <bool> fits: root.scale == 0 || (
        (Math.mod(root.rot, 2) == 1 ? root.mode.height : root.mode.width) / root.scale-value >= 1024
        && (Math.mod(root.rot, 2) == 1 ? root.mode.width : root.mode.height) / root.scale-value >= 600);
    property <bool> changed: root.edit-res >= 0 || root.edit-rate >= 0 || root.edit-scale >= 0
        || root.edit-rot >= 0 || root.edit-on >= 0;

    function reset() {
        root.edit-res = -1;
        root.edit-rate = -1;
        root.edit-scale = -1;
        root.edit-rot = -1;
        root.edit-on = -1;
    }

    if !Device.displays-available: EmptyNotice {
        x: 0;
        y: Page.top;
        icon: Icons.monitor;
        title: @tr("Displays");
        text: Shell.native
            ? @tr("Could not read the displays (wlr-randr did not respond).")
            : @tr("Resolution, scale and rotation can be changed in the KalangOS session.");
    }

    // Com rolagem: o desenho dos monitores mais as opções passam da janela.
    if Device.displays-available: Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: disp-col.preferred-height + 36px;
    disp-col := VerticalLayout {
        x: 0;
        y: 12px;
        width: min(Page.max-width, parent.width);
        alignment: start;
        spacing: 16px;

        // --- Arranjo: arraste para posicionar; clique para escolher ---
        Panel {
            height: 220px;
            arrange := Rectangle {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                height: parent.height - 28px;
                clip: true;
                // px do desenho por px lógico do arranjo.
                property <float> k: min(self.width / 1px / Device.display-bounds-w, self.height / 1px / Device.display-bounds-h);
                property <length> ox: (self.width - Device.display-bounds-w * self.k * 1px) / 2;
                property <length> oy: (self.height - Device.display-bounds-h * self.k * 1px) / 2;

                for d[i] in Device.displays: Rectangle {
                    // Deslocamento enquanto arrasta (só visual; ao soltar,
                    // o Rust encaixa e grava a posição nova).
                    property <length> dx: 0;
                    property <length> dy: 0;
                    visible: d.enabled;
                    x: arrange.ox + (d.x - Device.display-bounds-x) * arrange.k * 1px + self.dx + 2px;
                    y: arrange.oy + (d.y - Device.display-bounds-y) * arrange.k * 1px + self.dy + 2px;
                    width: max(20px, d.width-px * arrange.k * 1px - 4px);
                    height: max(14px, d.height-px * arrange.k * 1px - 4px);
                    border-radius: 6px;
                    background: i == root.sel ? Theme.accent.with-alpha(0.22) : Theme.tile;
                    border-width: i == root.sel ? 2px : 1px;
                    border-color: i == root.sel ? Theme.accent : Theme.border;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: d.number;
                            color: i == root.sel ? Theme.accent : Theme.text;
                            font-family: Theme.sans;
                            font-size: 22px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: d.name;
                            color: Theme.text-muted;
                            font-family: Theme.mono;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        if d.primary: Text {
                            text: @tr("Primary");
                            color: Theme.accent;
                            font-family: Theme.sans;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }
                    drag := TouchArea {
                        mouse-cursor: Device.displays.length > 1 ? MouseCursor.move : MouseCursor.default;
                        moved => {
                            if (self.pressed && Device.displays.length > 1) {
                                parent.dx += self.mouse-x - self.pressed-x;
                                parent.dy += self.mouse-y - self.pressed-y;
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up) {
                                if (abs(parent.dx) > 3px || abs(parent.dy) > 3px) {
                                    Device.move-display(i,
                                        d.x + round(parent.dx / 1px / arrange.k),
                                        d.y + round(parent.dy / 1px / arrange.k));
                                } else if (root.sel != i) {
                                    root.sel = i;
                                    root.reset();
                                }
                                parent.dx = 0;
                                parent.dy = 0;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            height: 38px;
            PillButton {
                text: @tr("Identify");
                clicked => { Device.identify-displays(); }
            }
            if Device.displays.length > 1 && !root.out.primary: PillButton {
                text: @tr("Make primary");
                clicked => { Device.set-primary-display(root.sel); }
            }
            Rectangle { horizontal-stretch: 1; }
            if Device.display-arranged: PillButton {
                text: @tr("Apply position");
                primary: true;
                enabled: !Device.display-confirm;
                clicked => { Device.apply-arrangement(); }
            }
        }

        Panel {
            height: 5 * 67px;
            VerticalLayout {
                Row {
                    title: "Monitor";
                    subtitle: root.out.label;
                    divider: false;
                    if Device.displays.length > 1: Toggle {
                        x: parent.width - self.width - 20px;
                        checked: root.on;
                        toggled(v) => { root.edit-on = v ? 1 : 0; }
                    }
                }
                Row {
                    title: @tr("Resolution");
                    Dropdown {
                        // Encolhe em janela estreita.
                        width: clamp(parent.width * 0.4, 150px, 250px);
                        x: parent.width - self.width - 20px;
                        options: root.out.resolution-labels;
                        selected: root.res;
                        enabled: root.on;
                        chosen(i) => {
                            root.edit-res = i;
                            root.edit-rate = -1;
                        }
                    }
                }
                Row {
                    title: @tr("Refresh rate");
                    Dropdown {
                        // Encolhe em janela estreita.
                        width: clamp(parent.width * 0.4, 150px, 250px);
                        x: parent.width - self.width - 20px;
                        options: root.mode.rates;
                        selected: root.rate;
                        enabled: root.on;
                        chosen(i) => { root.edit-rate = i; }
                    }
                }
                Row {
                    title: @tr("Scale");
                    subtitle: root.fits ? @tr("Makes text and windows larger") : @tr("Too large for this resolution");
                    Dropdown {
                        // Encolhe em janela estreita.
                        width: clamp(parent.width * 0.4, 150px, 250px);
                        x: parent.width - self.width - 20px;
                        options: Device.display-scales;
                        selected: root.scale;
                        enabled: root.on;
                        chosen(i) => { root.edit-scale = i; }
                    }
                }
                Row {
                    title: @tr("Rotation");
                    Dropdown {
                        // Encolhe em janela estreita.
                        width: clamp(parent.width * 0.4, 150px, 250px);
                        x: parent.width - self.width - 20px;
                        options: Device.display-rotations;
                        selected: root.rot;
                        enabled: root.on;
                        chosen(i) => { root.edit-rot = i; }
                    }
                }
            }
        }

        // Confirmação: volta sozinho se ninguém clicar em "Manter".
        if Device.display-confirm: Panel {
            height: 67px;
            border-color: Theme.accent.with-alpha(0.6);
            Row {
                divider: false;
                title: @tr("Keep this configuration?");
                subtitle: @tr("Reverting to the previous one in {} s", Device.display-countdown);
                HorizontalLayout {
                    x: parent.width - self.width - 20px;
                    width: self.preferred-width;
                    alignment: end;
                    spacing: 10px;
                    PillButton {
                        y: (67px - self.height) / 2;
                        text: @tr("Revert");
                        clicked => { Device.revert-display(); }
                    }
                    PillButton {
                        y: (67px - self.height) / 2;
                        text: @tr("Keep");
                        primary: true;
                        clicked => { Device.keep-display(); }
                    }
                }
            }
        }

        if !Device.display-confirm: HorizontalLayout {
            alignment: start;
            spacing: 10px;
            PillButton {
                text: @tr("Apply");
                primary: true;
                enabled: root.changed && root.fits;
                clicked => {
                    Device.apply-display(root.sel, root.res, root.rate, root.scale, root.rot, root.on);
                    root.reset();
                }
            }
            if root.changed: PillButton {
                text: @tr("Undo");
                clicked => { root.reset(); }
            }
        }

        if Device.display-message != "": Text {
            text: Device.display-message;
            color: Theme.text-muted;
            font-family: Theme.sans;
            font-size: 13.5px;
        }
    }
    }
}

// ---------------------------------------------------------------------------
// Barra de tarefas (barra superior e dock)
// ---------------------------------------------------------------------------

export component TaskbarPage inherits Rectangle {
    // Com rolagem: a página é mais alta que a janela maximizada.
    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: taskbar-col.preferred-height + 36px;
        taskbar-col := VerticalLayout {
            x: 0;
            y: 12px;
            width: min(Page.max-width, parent.width);
            alignment: start;
            spacing: 12px;

            SectionLabel { text: @tr("TOP BAR"); }
            Panel {
                height: 4 * 67px;
                VerticalLayout {
                    Row {
                        title: @tr("Date");
                        subtitle: @tr("The day before the time ({})", Shell.bar-day);
                        divider: false;
                        Toggle { x: parent.width - self.width - 20px; checked <=> Theme.bar-show-date; }
                    }
                    Row {
                        title: @tr("Seconds");
                        subtitle: @tr("Clock with seconds ({}:{})", Shell.bar-time, Shell.bar-seconds);
                        Toggle { x: parent.width - self.width - 20px; checked <=> Theme.bar-show-seconds; }
                    }
                    Row {
                        title: @tr("CPU usage");
                        subtitle: @tr("How much of the processor is in use");
                        Toggle { x: parent.width - self.width - 20px; checked <=> Theme.bar-show-cpu; }
                    }
                    Row {
                        title: @tr("Battery");
                        subtitle: @tr("Charge as a percentage (only on computers with a battery)");
                        Toggle { x: parent.width - self.width - 20px; checked <=> Theme.bar-show-battery; }
                    }
                }
            }

            SectionLabel { text: @tr("DOCK MODEL"); }
            HorizontalLayout {
                spacing: 10px;
                DockModelCard { model: 0; label: "Kalango"; }
                DockModelCard { model: 1; label: @tr("3D glass"); }
                DockModelCard { model: 2; label: @tr("Tiles"); }
                DockModelCard { model: 3; label: @tr("Bar"); }
                DockModelCard { model: 4; label: @tr("Minimal"); }
            }

            SectionLabel { text: "DOCK"; }
            Panel {
                height: 10 * 67px;
                VerticalLayout {
                    Row {
                        title: @tr("Position");
                        divider: false;
                        Segmented {
                            x: parent.width - self.width - 20px;
                            options: [@tr("Bottom"), @tr("Left"), @tr("Right")];
                            selected: Theme.dock-position;
                            chosen(i) => { Theme.dock-position = i; }
                        }
                    }
                    Row {
                        title: @tr("Style");
                        subtitle: Theme.dock-style == 1 ? @tr("Bar along the edge, end to end")
                            : Theme.dock-detached ? @tr("Centered, floating away from the edge") : @tr("Centered, touching the edge");
                        Segmented {
                            x: parent.width - self.width - 20px;
                            options: ["Dock", @tr("Bar")];
                            selected: Theme.dock-style;
                            chosen(i) => { Theme.dock-style = i; }
                        }
                    }
                    // Como o Ubuntu com o "modo painel" desligado: a dock fica
                    // solta da borda, com os quatro cantos arredondados.
                    Row {
                        title: @tr("Floating");
                        subtitle: Theme.dock-style == 1 ? @tr("Only in the Dock style")
                            : @tr("A gap between the dock and the edge, like Ubuntu");
                        Toggle { x: parent.width - self.width - 20px; checked <=> Theme.dock-detached; }
                    }
                    // Grade de 9 pontos que abre o menu de programas.
                    Row {
                        title: @tr("Show apps button");
                        subtitle: @tr("Opens the app menu, like Ubuntu's grid");
                        Segmented {
                            x: parent.width - self.width - 20px;
                            options: [@tr("Start"), @tr("End"), @tr("Hidden")];
                            selected: Theme.dock-apps-button;
                            chosen(i) => { Theme.dock-apps-button = i; }
                        }
                    }
                    Row {
                        title: @tr("Icons");
                        subtitle: Theme.dock-icon-style == 1 ? @tr("Raised tile with shadow; rises under the mouse")
                            : Theme.dock-icon-style == 2 ? @tr("Tile in each app's color") : @tr("Just the icon");
                        Segmented {
                            x: parent.width - self.width - 20px;
                            options: [@tr("Flat"), "3D", @tr("Tiles")];
                            selected: Theme.dock-icon-style;
                            chosen(i) => { Theme.dock-icon-style = i; }
                        }
                    }
                    Row {
                        title: @tr("Corners");
                        subtitle: @tr("Of the dock and of the icon tiles");
                        Segmented {
                            x: parent.width - self.width - 20px;
                            options: [@tr("Square"), @tr("Rounded"), @tr("Pill")];
                            selected: Theme.dock-corners;
                            chosen(i) => { Theme.dock-corners = i; }
                        }
                    }
                    Row {
                        title: @tr("Always visible");
                        subtitle: @tr("Off: appears when the mouse reaches the screen edge");
                        Toggle { x: parent.width - self.width - 20px; checked <=> Theme.dock-always-visible; }
                    }
                    Row {
                        title: @tr("Transparency");
                        subtitle: @tr("How much of what is behind shows through the dock");
                        SliderBar {
                            x: parent.width - self.width - 82px;
                            width: clamp(parent.width * 0.3, 100px, 240px);
                            // 0–80 %.
                            value: Theme.dock-transparency / 0.8;
                            changed(v) => { Theme.dock-transparency = round(v * 16) * 0.05; }
                        }
                        Text {
                            x: parent.width - self.width - 20px;
                            width: 52px;
                            text: round(Theme.dock-transparency * 100) + "%";
                            color: Theme.text;
                            font-family: Theme.mono;
                            font-size: 13px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    Row {
                        title: @tr("Icon transparency");
                        subtitle: @tr("The icons become solid under the mouse");
                        SliderBar {
                            x: parent.width - self.width - 82px;
                            width: clamp(parent.width * 0.3, 100px, 240px);
                            // 0–60 %.
                            value: Theme.dock-icon-transparency / 0.6;
                            changed(v) => { Theme.dock-icon-transparency = round(v * 12) * 0.05; }
                        }
                        Text {
                            x: parent.width - self.width - 20px;
                            width: 52px;
                            text: round(Theme.dock-icon-transparency * 100) + "%";
                            color: Theme.text;
                            font-family: Theme.mono;
                            font-size: 13px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    Row {
                        title: @tr("Size");
                        subtitle: @tr("Icon size, from 16 to 72 px");
                        // 16–72 px de 4 em 4 (15 posições no slider).
                        SliderBar {
                            x: parent.width - self.width - 82px;
                            width: clamp(parent.width * 0.3, 100px, 240px);
                            value: (Theme.dock-size - 16) / 56;
                            changed(v) => { Theme.dock-size = 16 + round(v * 14) * 4; }
                        }
                        Text {
                            x: parent.width - self.width - 20px;
                            width: 52px;
                            text: Theme.dock-size + " px";
                            color: Theme.text;
                            font-family: Theme.mono;
                            font-size: 13px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                SectionLabel { text: @tr("DOCK APPS"); }
                Text {
                    horizontal-alignment: right;
                    text: @tr("Click to add or remove · in this order");
                    color: Theme.text-muted;
                    font-family: Theme.sans;
                    font-size: 12.5px;
                }
            }
            // Grade 6×2 dos apps fixados; Configurações fica sempre na dock.
            Rectangle {
                height: 2 * 44px + 8px;
                for app[i] in Apps.pinned: Rectangle {
                    property <bool> fixed: app.id == "settings";
                    property <bool> on: self.fixed || Shell.dock-has(Theme.dock-apps, app.id);
                    x: Math.mod(i, 6) * (parent.width + 8px) / 6;
                    y: floor(i / 6) * (44px + 8px);
                    width: (parent.width + 8px) / 6 - 8px;
                    height: 44px;
                    border-radius: Theme.radius-small;
                    background: self.on ? Theme.accent-soft : chip-touch.has-hover ? Theme.tile-hover : Theme.tile;
                    border-width: 1px;
                    border-color: self.on ? Theme.accent.with-alpha(0.55) : Theme.border;
                    opacity: self.fixed ? 0.6 : 1;
                    Image {
                        x: 10px;
                        source: app.icon;
                        colorize: app.tint == transparent ? transparent : app.id == "files" ? Theme.accent : app.tint;
                        width: app.tint == transparent ? 20px : 17px;
                        height: self.width;
                    }
                    Text {
                        x: 34px;
                        width: parent.width - 40px;
                        text: app.name;
                        color: Theme.text;
                        font-family: Theme.sans;
                        font-size: 12.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    chip-touch := TouchArea {
                        enabled: !parent.fixed;
                        mouse-cursor: pointer;
                        clicked => { Theme.dock-apps = Shell.dock-toggle(Theme.dock-apps, app.id); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Sobre o sistema
// ---------------------------------------------------------------------------

export component AboutPage inherits Rectangle {
    // Linhas mais baixas (cabe tudo em 1366×768) e rolagem para telas menores.
    Flickable {
        y: Page.top - 12px;
        height: parent.height - self.y;
        content-height: about-col.preferred-height + 36px;
    about-col := VerticalLayout {
        x: 0;
        y: 12px;
        width: min(Page.max-width, parent.width);
        alignment: start;
        spacing: 18px;

        HorizontalLayout {
            spacing: 18px;
            alignment: start;
            height: 56px;
            KalangoIcon { width: 56px; height: 56px; }
            KalangoLogo { height: 56px; }
        }

        Panel {
            height: Device.about.length * 42px;
            for item[i] in Device.about: Rectangle {
                y: i * 42px;
                height: 42px;
                if i > 0: Rectangle { y: 0; height: 1px; background: Theme.border; }
                Text {
                    x: 20px;
                    text: item.label;
                    color: Theme.text-muted;
                    font-family: Theme.sans;
                    font-size: 14px;
                    vertical-alignment: center;
                }
                Text {
                    x: 180px;
                    width: parent.width - 200px;
                    text: item.value;
                    color: Theme.text;
                    font-family: Theme.sans;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
}
