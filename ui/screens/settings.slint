// Configurações: barra lateral de seções + páginas. A Aparência grava no
// global `Theme` e muda o sistema ao vivo; as demais páginas
// (`settings_pages.slint`) mostram e alteram o computador de verdade pelo
// global `Device` (rede, som, energia...).

import { Theme, ThemeMode } from "../theme.slint";
import { Updates } from "../device.slint";
import { Icons } from "../icons.slint";
import { Shell, TerminalTheme } from "../globals.slint";
import { SectionLabel, IconButton, Toggle, SliderBar } from "../components/widgets.slint";
import {
    NetworkPage, BluetoothPage, DisplaysPage, SoundPage, PowerPage, UsersPage, SharingPage, RegionPage, UpdatesPage, AboutPage,
    PrintersPage,
    TaskbarPage,
} from "settings_pages.slint";

/// Seção da barra lateral.
struct Section {
    name: string,
    icon: image,
    /// Número no selo âmbar (0 = sem selo).
    badge: int,
}

/// Item clicável da barra lateral.
component SidebarItem inherits Rectangle {
    in property <Section> section;
    in property <bool> selected;
    /// Só o ícone (janela estreita).
    in property <bool> compact: false;
    callback clicked();

    height: 42px;
    border-radius: Theme.radius-small;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.tile : transparent;
    border-width: root.selected ? 1px : 0;
    border-color: Theme.accent.with-alpha(0.45);

    Image {
        x: root.compact ? (parent.width - self.width) / 2 : 14px;
        source: root.section.icon;
        colorize: root.compact && root.selected ? Theme.accent : Theme.text;
        width: 18px;
        height: 18px;
    }
    if !root.compact: Text {
        x: 44px;
        width: parent.width - 44px - 8px;
        overflow: elide;
        text: root.section.name;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 14.5px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
    }
    if root.section.badge > 0 && !root.compact: Rectangle {
        x: parent.width - self.width - 12px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: Theme.warning;
        Text {
            text: root.section.badge;
            color: Theme.on-accent;
            font-family: Theme.sans;
            font-size: 12px;
            font-weight: 700;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Card de prévia de tema (até 220×158) com miniatura de janela, destaque e dock.
component ThemeCard inherits Rectangle {
    in property <string> label;
    in property <ThemeMode> mode;
    /// Cores da miniatura (fixas por modo, independem do tema atual).
    in property <color> preview-bg;
    in property <color> preview-window;
    in property <color> preview-dock;
    in property <color> preview-accent;
    callback clicked();

    property <bool> selected: Theme.mode == root.mode;

    width: 220px;
    height: 158px;
    border-radius: Theme.radius;
    background: Theme.tile;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    drop-shadow-blur: root.selected ? 14px : 0;
    drop-shadow-color: Theme.accent.with-alpha(0.25);

    Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: 110px;
        border-radius: Theme.radius-small;
        background: root.preview-bg;

        Rectangle {
            x: 14px;
            y: 14px;
            width: min(112px, parent.width - 70px);
            height: 65px;
            border-radius: 4px;
            background: root.preview-window;
            border-width: 1px;
            border-color: root.preview-dock;
        }
        Rectangle {
            x: parent.width - 44px;
            y: 22px;
            width: 30px;
            height: 30px;
            border-radius: 15px;
            background: root.preview-accent;
        }
        Rectangle {
            y: parent.height - 18px;
            width: 60px;
            height: 9px;
            border-radius: 4.5px;
            background: root.preview-dock;
        }
    }

    Text {
        x: 10px;
        y: 128px;
        width: parent.width - 20px;
        overflow: elide;
        text: root.label;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 14.5px;
        font-weight: 600;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Linha do painel de opções: título + descrição à esquerda, controle à direita.
component OptionRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    /// Desenha a linha divisória no topo (todas menos a primeira).
    in property <bool> divider: true;
    /// Espaço do controle à direita (o texto corta com "…" antes dele).
    in property <length> control-width: 80px;

    height: 67px;

    if root.divider: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        x: 20px;
        width: max(0px, parent.width - 40px - root.control-width);
        alignment: center;
        spacing: 3px;
        Text { text: root.title; color: Theme.text; font-family: Theme.sans; font-size: 14.5px; font-weight: 600; overflow: elide; }
        Text { text: root.subtitle; color: Theme.text-muted; font-family: Theme.sans; font-size: 13.5px; overflow: elide; }
    }
    // Controle (Toggle/Slider) vem como filho e se alinha pela direita.
    @children
}

/// Card de tema do terminal: prévia do prompt no estilo do Kali nas cores
/// do tema e o nome embaixo.
component TerminalCard inherits Rectangle {
    in property <TerminalTheme> theme;
    in property <bool> selected;
    callback clicked();

    width: 168px;
    height: 104px;
    border-radius: Theme.radius-small;
    background: Theme.panel;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border;

    Rectangle {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: 66px;
        border-radius: 6px;
        background: root.theme.bg;
        clip: true;
        VerticalLayout {
            padding: 7px;
            spacing: 1px;
            HorizontalLayout {
                alignment: start;
                Text { text: "┌──("; color: root.theme.cyan; font-family: Theme.mono; font-size: 9.5px; }
                Text { text: "user@kalango"; color: root.theme.blue; font-family: Theme.mono; font-size: 9.5px; font-weight: 700; }
                Text { text: ")-[~]"; color: root.theme.cyan; font-family: Theme.mono; font-size: 9.5px; }
            }
            HorizontalLayout {
                alignment: start;
                Text { text: "└─"; color: root.theme.cyan; font-family: Theme.mono; font-size: 9.5px; }
                Text { text: "$ "; color: root.theme.blue; font-family: Theme.mono; font-size: 9.5px; font-weight: 700; }
                Text { text: "ls"; color: root.theme.green; font-family: Theme.mono; font-size: 9.5px; font-weight: 700; }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Text { text: "docs"; color: root.theme.blue; font-family: Theme.mono; font-size: 9.5px; }
                Text { text: "app.rs"; color: root.theme.fg; font-family: Theme.mono; font-size: 9.5px; }
                Text { text: "run.sh"; color: root.theme.green; font-family: Theme.mono; font-size: 9.5px; }
            }
            HorizontalLayout {
                spacing: 3px;
                for c in [root.theme.red, root.theme.green, root.theme.yellow, root.theme.blue, root.theme.magenta, root.theme.cyan]: Rectangle {
                    width: 10px;
                    height: 5px;
                    border-radius: 2px;
                    background: c;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
    Text {
        x: 10px;
        y: 78px;
        width: parent.width - 20px;
        text: root.theme.name;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        overflow: elide;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Página Aparência. Responsiva: os cards encolhem e as miniaturas de papel
/// de parede quebram linha quando a janela é estreita.
component AppearancePage inherits Rectangle {
    // Rolagem abaixo do título (a página é mais alta que a janela).
    Flickable {
        y: 100px;
        height: parent.height - 100px;
        content-height: col.preferred-height + 40px;

        col := VerticalLayout {
            x: 0;
            y: 13px;
            width: min(721px, parent.width);
            alignment: start;
            spacing: 0;
            property <length> w: self.width;

            // --- Tema ---
            SectionLabel { text: @tr("THEME"); }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: start;
                spacing: 17px;
                height: 158px;
                ThemeCard {
                    width: min(220px, (col.w - 34px) / 3);
                    label: @tr("Dark (glass)");
                    mode: ThemeMode.glass;
                    preview-bg: #07090d;
                    preview-window: #17222b;
                    preview-dock: #2a3540;
                    preview-accent: Theme.accents[Theme.accent-index];
                    clicked => { Theme.mode = ThemeMode.glass; }
                }
                ThemeCard {
                    width: min(220px, (col.w - 34px) / 3);
                    label: @tr("Solid dark (OLED)");
                    mode: ThemeMode.oled;
                    preview-bg: #000000;
                    preview-window: #0e0e0e;
                    preview-dock: #262626;
                    preview-accent: Theme.accents[Theme.accent-index];
                    clicked => { Theme.mode = ThemeMode.oled; }
                }
                ThemeCard {
                    width: min(220px, (col.w - 34px) / 3);
                    label: @tr("Light");
                    mode: ThemeMode.light;
                    preview-bg: #eef1f4;
                    preview-window: #ffffff;
                    preview-dock: #d4dbe2;
                    preview-accent: Theme.accents[Theme.accent-index].darker(0.45);
                    clicked => { Theme.mode = ThemeMode.light; }
                }
            }

            // --- Cor de destaque ---
            Rectangle { height: 40px; }
            SectionLabel { text: @tr("ACCENT COLOR"); }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: start;
                spacing: 14px;
                height: 44px;
                for c[i] in Theme.accents: Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    // Selecionado: anel claro com uma folga até o círculo de cor.
                    border-width: Theme.accent-index == i ? 2px : 0;
                    border-color: Theme.text;

                    Rectangle {
                        width: Theme.accent-index == i ? 34px : 44px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: c;
                        animate width { duration: Theme.anim; }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Theme.accent-index = i; }
                    }
                }
            }

            // --- Painel de opções ---
            Rectangle { height: 33px; }
            Rectangle {
                height: 3 * 67px;
                border-radius: Theme.radius;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    OptionRow {
                        title: @tr("Window transparency");
                        subtitle: @tr("How much of the background shows through the glass");
                        divider: false;
                        // Slider mais estreito em janela estreita.
                        property <length> slider-w: clamp(col.w * 0.3, 100px, 180px);
                        control-width: self.slider-w + 62px;
                        SliderBar {
                            x: parent.width - self.width - 72px;
                            width: parent.slider-w;
                            value <=> Theme.transparency;
                        }
                        Text {
                            x: parent.width - self.width - 20px;
                            width: 42px;
                            text: round(Theme.transparency * 100) + "%";
                            color: Theme.text;
                            font-family: Theme.mono;
                            font-size: 13px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    OptionRow {
                        title: @tr("Background blur");
                        subtitle: @tr("Turning it off saves GPU on older hardware");
                        Toggle {
                            x: parent.width - self.width - 20px;
                            checked <=> Theme.blur;
                        }
                    }
                    OptionRow {
                        title: @tr("Reduce animations");
                        subtitle: @tr("Instant transitions");
                        Toggle {
                            x: parent.width - self.width - 20px;
                            checked <=> Theme.reduce-motion;
                        }
                    }
                }
            }

            // --- Papel de parede (a dock fica em Barra de tarefas) ---
            Rectangle { height: 24px; }
            SectionLabel { text: @tr("WALLPAPER"); }
            Rectangle { height: 10px; }
            wallpapers := Rectangle {
                // Miniaturas de 80×45 em grade: quantas couberem por linha.
                // Depois dos modelos: a imagem própria (se houver) e o "+".
                property <int> cols: max(1, floor((col.w + 10px) / 90px));
                property <bool> has-custom: Theme.wallpaper-file != "";
                property <int> custom-at: Theme.wallpaper-names.length;
                property <int> plus-at: self.custom-at + (self.has-custom ? 1 : 0);
                property <int> custom-index: Theme.wallpaper-names.length;
                height: ceil((self.plus-at + 1) / self.cols) * 55px - 10px;
                for nome[i] in Theme.wallpaper-names: Rectangle {
                    x: Math.mod(i, wallpapers.cols) * (80px + 10px);
                    y: floor(i / wallpapers.cols) * 55px;
                    width: 80px;
                    height: 45px;
                    border-radius: 6px;
                    clip: true;
                    background: Theme.background;
                    // Circuitos (sem miniatura): linha e nó na cor de destaque.
                    if i == 0: Rectangle {
                        Rectangle { x: 8px; y: 30px; width: 40px; height: 1.5px; background: Theme.circuit; }
                        Rectangle { x: 47px; y: 14px; width: 1.5px; height: 17px; background: Theme.circuit; }
                        Rectangle {
                            x: 43px; y: 9px; width: 10px; height: 10px; border-radius: 5px;
                            border-width: 1.5px; border-color: Theme.accent; background: transparent;
                        }
                    }
                    if i > 0 && i < Shell.wallpaper-thumbs.length: Image {
                        width: parent.width;
                        height: parent.height;
                        source: Shell.wallpaper-thumbs[i];
                        image-fit: cover;
                    }
                    Rectangle {
                        border-radius: 6px;
                        border-width: Theme.wallpaper == i ? 2px : 1px;
                        border-color: Theme.wallpaper == i ? Theme.accent : Theme.border;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Theme.wallpaper = i; }
                    }
                }
                // Imagem própria já escolhida.
                if self.has-custom: Rectangle {
                    x: Math.mod(wallpapers.custom-at, wallpapers.cols) * (80px + 10px);
                    y: floor(wallpapers.custom-at / wallpapers.cols) * 55px;
                    width: 80px;
                    height: 45px;
                    border-radius: 6px;
                    clip: true;
                    background: Theme.background;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: Shell.wallpaper-custom-thumb;
                        image-fit: cover;
                    }
                    Rectangle {
                        border-radius: 6px;
                        border-width: Theme.wallpaper == wallpapers.custom-index ? 2px : 1px;
                        border-color: Theme.wallpaper == wallpapers.custom-index ? Theme.accent : Theme.border;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Theme.wallpaper = wallpapers.custom-index; }
                    }
                }
                // Escolher uma imagem do computador.
                Rectangle {
                    x: Math.mod(wallpapers.plus-at, wallpapers.cols) * (80px + 10px);
                    y: floor(wallpapers.plus-at / wallpapers.cols) * 55px;
                    width: 80px;
                    height: 45px;
                    border-radius: 6px;
                    background: plus-touch.has-hover ? Theme.tile-hover : Theme.tile;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text {
                        text: Shell.wallpaper-busy ? "…" : "+";
                        color: Theme.text-muted;
                        font-family: Theme.sans;
                        font-size: 24px;
                    }
                    plus-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Shell.pick-wallpaper(); }
                    }
                }
            }
            Rectangle { height: 8px; }
            Text {
                color: Shell.wallpaper-message != "" ? Theme.danger : Theme.text-muted;
                text: Shell.wallpaper-message != "" ? Shell.wallpaper-message
                    : Theme.wallpaper == wallpapers.custom-index ? @tr("My image")
                    : Theme.wallpaper < Theme.wallpaper-names.length ? Theme.wallpaper-names[Theme.wallpaper]
                    : "";
                font-family: Theme.sans;
                font-size: 13px;
            }

            // --- Ícones (as pastas seguem a cor de destaque nos três) ---
            Rectangle { height: 22px; }
            SectionLabel { text: @tr("ICONS"); }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: start;
                spacing: 17px;
                height: 92px;
                for nome[i] in Theme.icon-theme-names: Rectangle {
                    width: min(229px, (col.w - 34px) / 3);
                    height: 92px;
                    border-radius: Theme.radius;
                    background: Theme.panel;
                    border-width: Theme.icon-theme == i ? 2px : 1px;
                    border-color: Theme.icon-theme == i ? Theme.accent : Theme.border;
                    clip: true;

                    HorizontalLayout {
                        y: 12px;
                        height: 40px;
                        alignment: center;
                        spacing: 8px;
                        if i < Shell.icon-previews.length: HorizontalLayout {
                            spacing: 8px;
                            for icone in Shell.icon-previews[i].icons: Image {
                                width: 34px;
                                height: 34px;
                                source: icone;
                            }
                        }
                    }
                    Text {
                        y: 62px;
                        text: nome;
                        color: Theme.text;
                        font-family: Theme.sans;
                        font-size: 14px;
                        font-weight: Theme.icon-theme == i ? 600 : 400;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Theme.icon-theme = i; }
                    }
                }
            }

            // --- Terminal: temas do foot (prompt no estilo do Kali) ---
            if Shell.terminal-themes.length > 0: Rectangle { height: 26px; }
            if Shell.terminal-themes.length > 0: SectionLabel { text: @tr("TERMINAL"); }
            if Shell.terminal-themes.length > 0: Rectangle { height: 10px; }
            if Shell.terminal-themes.length > 0: term-grid := Rectangle {
                // Cards de 168×104 em grade.
                property <int> cols: max(1, floor((col.w + 12px) / 180px));
                height: ceil(Shell.terminal-themes.length / self.cols) * 116px - 12px;
                for t[i] in Shell.terminal-themes: TerminalCard {
                    x: Math.mod(i, term-grid.cols) * 180px;
                    y: floor(i / term-grid.cols) * 116px;
                    theme: t;
                    selected: Shell.terminal-theme == t.id;
                    clicked => { Shell.set-terminal-theme(t.id); }
                }
            }
            if Shell.terminal-message != "": Rectangle { height: 8px; }
            if Shell.terminal-message != "": Text {
                text: Shell.terminal-message;
                color: Theme.text-muted;
                font-family: Theme.sans;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}

export component SettingsScreen inherits Rectangle {
    callback close();

    property <[Section]> sections: [
        { name: @tr("Network & Wi-Fi"), icon: Icons.wifi },
        { name: "Bluetooth", icon: Icons.bluetooth },
        { name: @tr("Appearance"), icon: Icons.contrast },
        { name: @tr("Taskbar"), icon: Icons.dock },
        { name: @tr("Displays"), icon: Icons.monitor },
        { name: @tr("Sound"), icon: Icons.volume },
        { name: @tr("Power"), icon: Icons.battery },
        { name: @tr("Users"), icon: Icons.user },
        { name: @tr("Sharing"), icon: Icons.folder },
        { name: @tr("Language & Region"), icon: Icons.globe },
        { name: @tr("Updates"), icon: Icons.download, badge: Updates.list.length },
        { name: @tr("About"), icon: Icons.info },
        { name: @tr("Printers"), icon: Icons.printer },
    ];
    /// Ordem na barra lateral (índices de `sections`; Impressoras entrou
    /// depois, sem renumerar as páginas, que os atalhos `settings:<n>` usam).
    property <[int]> order: [0, 1, 2, 3, 4, 5, 6, 7, 12, 8, 9, 10, 11];
    /// Página aberta (índice em `sections`).
    in-out property <int> current: 2;

    /// Janela estreita (meia tela num notebook): barra lateral só com ícones.
    property <bool> narrow: root.width < 900px;
    property <length> sidebar-w: root.narrow ? 64px : root.width < 1150px ? 230px : 280px;
    /// Margem do conteúdo dos dois lados.
    property <length> content-pad: root.narrow ? 24px : 48px;

    // --- Barra lateral ---
    Rectangle {
        x: 0;
        width: root.sidebar-w;
        background: Theme.panel;

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: Theme.border;
        }

        if !root.narrow: Text {
            x: 24px;
            y: 22px;
            text: @tr("Settings");
            color: Theme.text;
            font-family: Theme.sans;
            font-size: 22px;
            font-weight: 600;
        }

        // Busca (visual)
        if !root.narrow: Rectangle {
            x: 14px;
            y: 65px;
            width: parent.width - 28px;
            height: 42px;
            border-radius: Theme.radius-small;
            background: Theme.tile;
            border-width: 1px;
            border-color: Theme.border;
            Image {
                x: 14px;
                source: Icons.search;
                colorize: Theme.text-muted;
                width: 16px;
                height: 16px;
            }
            if sidebar-search.text == "": Text {
                x: 39px;
                text: @tr("Search");
                color: Theme.text-muted;
                font-family: Theme.sans;
                font-size: 14.5px;
                vertical-alignment: center;
            }
            sidebar-search := TextInput {
                x: 39px;
                width: parent.width - 50px;
                height: parent.height;
                vertical-alignment: center;
                color: Theme.text;
                font-family: Theme.sans;
                font-size: 14.5px;
            }
        }

        VerticalLayout {
            x: root.narrow ? 8px : 14px;
            y: root.narrow ? 20px : 120px;
            width: parent.width - 2 * self.x;
            alignment: start;
            for i in root.order: SidebarItem {
                compact: root.narrow;
                section: root.sections[i];
                selected: root.current == i;
                clicked => { root.current = i; }
            }
        }
    }

    // --- Conteúdo ---
    Rectangle {
        x: root.sidebar-w + root.content-pad;
        width: root.width - root.sidebar-w - 2 * root.content-pad;

        Text {
            y: 34px;
            x: 0;
            text: root.sections[root.current].name;
            color: Theme.text;
            font-family: Theme.sans;
            font-size: 30px;
            font-weight: 600;
        }

        if root.current == 2: AppearancePage {
            x: 0;
            y: 0;
        }

        if root.current == 0: NetworkPage { }
        if root.current == 1: BluetoothPage { }
        if root.current == 3: TaskbarPage { }
        if root.current == 4: DisplaysPage { }
        if root.current == 5: SoundPage { }
        if root.current == 6: PowerPage { }
        if root.current == 7: UsersPage { }
        if root.current == 8: SharingPage { }
        if root.current == 9: RegionPage { }
        if root.current == 10: UpdatesPage { }
        if root.current == 11: AboutPage { }
        if root.current == 12: PrintersPage { }
    }

    // Fechar dentro da tela só no protótipo (lá as Configurações são uma tela
    // do próprio shell). Na sessão real elas são uma janela, com os botões
    // minimizar/maximizar/fechar do labwc na barra de título.
    if !Shell.native: IconButton {
        x: root.width - self.width - 34px;
        y: 37px;
        width: 36px;
        height: 36px;
        icon: Icons.x;
        icon-size: 16px;
        clicked => { root.close(); }
    }
}
