// Menu de apps (launcher): card central com busca, uma lista com rolagem
// (fixados, recentes e todos os apps, como o Launchpad do macOS) e rodapé do
// usuário. Abre com Super (⌃ Control no macOS) ou pela pílula.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Apps, AppEntry, Shell } from "../globals.slint";
import { SectionLabel, Avatar, IconButton } from "../components/widgets.slint";
import { AppIcon } from "../components/app_icon.slint";

/// Tile de app da grade (108×101): ícone no estilo da dock (`AppIcon`:
/// plano, 3D ou ladrilho, com os mesmos cantos) e o nome embaixo, como no
/// Launchpad do macOS.
component AppTile inherits Rectangle {
    in property <AppEntry> app;
    callback clicked();
    /// Botão direito: menu do app (fixar na dock).
    callback menu();

    width: 108px;
    height: 101px;
    border-radius: 10px;
    background: touch.has-hover ? Theme.tile-hover.with-alpha(0.5) : transparent;
    animate background { duration: Theme.anim; }

    AppIcon {
        y: 9px;
        width: 56px;
        height: 56px;
        app: root.app;
        hovered: touch.has-hover;
        // Mesmos cantos da dock (retos, arredondados ou pílula = círculo).
        radius: Theme.dock-corners == 0 ? 6px : Theme.dock-corners == 2 ? self.width / 2 : 12px;
        glyph: 26px;
    }

    Text {
        y: 74px;
        width: parent.width - 12px;
        horizontal-alignment: center;
        overflow: elide;
        text: root.app.name;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 13.5px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.menu();
            }
        }
    }
}

export component Launcher inherits Rectangle {
    callback launch(string);
    /// Abrir um arquivo recente (caminho completo).
    callback open-file(string);
    callback close();
    callback lock();

    /// Texto digitado na busca.
    property <string> query: search.text;
    /// Menu do botão direito: app e onde fica (no card).
    property <AppEntry> menu-app;
    property <bool> menu-open: false;
    property <length> menu-x;
    property <length> menu-y;
    property <bool> searching: root.query != "";
    /// Com busca: o resultado do filtro (feito no Rust, que procura também
    /// nos apps instalados). Sem busca: os fixados (o resto vem embaixo, em
    /// `Apps.others`).
    property <[AppEntry]> shown: root.searching ? Shell.filter-apps(root.query) : Apps.pinned;

    // Posições das seções dentro da lista (rolam juntas).
    /// Linha da grade: tile (101) + espaço (11).
    property <length> row-step: 112px;
    /// Do rótulo da seção até os itens.
    property <length> label-gap: 26px;
    property <length> recent-label-y: root.label-gap + ceil(root.shown.length / 6) * root.row-step + 6px;
    property <bool> has-recents: !root.searching && Apps.recents.length > 0;
    property <length> all-label-y: root.has-recents ? root.recent-label-y + root.label-gap + 50px + 24px : root.recent-label-y;
    /// Fim do conteúdo (altura da lista inteira).
    property <length> content-end: root.searching || Apps.others.length == 0
        ? root.label-gap + ceil(root.shown.length / 6) * root.row-step - 11px
        : root.all-label-y + root.label-gap + ceil(Apps.others.length / 6) * root.row-step - 11px;

    // Volta ao topo quando a busca muda.
    changed query => { list.content-y = 0; }

    /// Limpa a busca, volta ao topo e foca o campo (chamado ao abrir).
    public function reset() {
        search.text = "";
        list.content-y = 0;
        search.focus();
    }

    /// Abre o menu do botão direito de um app (posição do tile na lista).
    function open-menu(app: AppEntry, x: length, y: length) {
        // As Configurações ficam sempre na dock.
        if (Shell.native && app.id != "settings") {
            root.menu-app = app;
            root.menu-x = list.x + x + 20px;
            root.menu-y = list.y + y + list.content-y + 70px;
            root.menu-open = true;
        }
    }

    // Escurece o fundo; clicar fora do card fecha.
    Rectangle {
        background: Theme.background.with-alpha(0.55);
        TouchArea { clicked => { root.close(); } }
    }

    card := Rectangle {
        width: 759px;
        height: 569px;
        // 121px na tela de referência, menos a barra superior (35px).
        y: 86px;
        border-radius: 18px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 50px;
        drop-shadow-color: #000000a0;

        // Bloqueia cliques no card para não fechar o launcher.
        TouchArea { }

        // --- Busca ---
        Rectangle {
            x: 29px;
            y: 29px;
            width: parent.width - 58px;
            height: 54px;
            border-radius: 10px;
            background: Theme.sunken;
            border-width: 1.5px;
            border-color: Theme.accent;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.accent.with-alpha(0.18);

            Image {
                x: 20px;
                source: Icons.search;
                colorize: Theme.accent;
                width: 19px;
                height: 19px;
            }

            if search.text == "": Text {
                x: 53px;
                text: @tr("Search apps, files, commands...");
                color: Theme.text-muted;
                font-family: Theme.sans;
                font-size: 17px;
                vertical-alignment: center;
            }

            search := TextInput {
                x: 53px;
                width: parent.width - 53px - 80px;
                height: parent.height;
                vertical-alignment: center;
                color: Theme.text;
                font-family: Theme.sans;
                font-size: 17px;
                selection-background-color: Theme.accent.with-alpha(0.4);
                // Enter abre o primeiro resultado.
                accepted => {
                    if (root.shown.length > 0) {
                        root.launch(root.shown[0].id);
                    }
                }
            }

            // Etiqueta do atalho
            Rectangle {
                x: parent.width - self.width - 18px;
                width: super-label.preferred-width + 16px;
                height: 22px;
                border-radius: 5px;
                background: Theme.tile;
                super-label := Text {
                    text: "Super";
                    color: Theme.text-muted;
                    font-family: Theme.mono;
                    font-size: 11px;
                }
            }
        }

        // --- Lista com rolagem (como o Launchpad do macOS) ---
        // Sem busca: FIXADOS, RECENTES e TODOS OS APPS, uma seção embaixo da
        // outra, rolando com a roda do mouse (sem clicar em nada). Com busca:
        // só os resultados. Grade de 6 colunas, posição pelo índice.
        list := Flickable {
            x: 29px;
            y: 104px;
            width: 703px;
            height: 366px;
            content-height: max(self.height, root.content-end);

            SectionLabel {
                x: 0;
                y: 4px;
                text: root.searching ? @tr("RESULTS") : @tr("PINNED");
            }
            for app[i] in root.shown: AppTile {
                x: Math.mod(i, 6) * (108px + 11px);
                y: root.label-gap + floor(i / 6) * root.row-step;
                app: app;
                clicked => { root.launch(app.id); }
                menu => { root.open-menu(app, self.x, self.y); }
            }

            // Recentes: arquivos abertos há pouco (e, na ISO live, o
            // atalho do instalador, com borda de destaque).
            if root.has-recents: SectionLabel {
                x: 0;
                y: root.recent-label-y + 4px;
                text: @tr("RECENT");
            }
            for r[i] in root.has-recents ? Apps.recents : []: Rectangle {
                x: i * (346px + 9px);
                y: root.recent-label-y + root.label-gap;
                width: 346px;
                height: 50px;
                border-radius: 8px;
                background: recent-touch.has-hover ? Theme.tile-hover : Theme.tile;
                border-width: r.kind == "install" ? 1px : 0;
                border-color: Theme.accent.with-alpha(0.6);

                Image {
                    x: 14px;
                    source: r.kind == "code" ? Icons.code : r.kind == "image" ? Icons.image
                        : r.kind == "install" ? Icons.download : Icons.file;
                    colorize: r.kind == "code" ? #a78bfa : r.kind == "image" ? #f28b95
                        : r.kind == "install" ? Theme.accent : #7ea6f7;
                    width: 19px;
                    height: 19px;
                }
                VerticalLayout {
                    x: 44px;
                    width: parent.width - 58px;
                    alignment: center;
                    spacing: 1px;
                    Text { text: r.name; color: Theme.text; font-family: Theme.sans; font-size: 13.5px; overflow: elide; }
                    Text { text: r.path; color: Theme.text-muted; font-family: Theme.mono; font-size: 12px; overflow: elide; }
                }
                recent-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (r.app != "") {
                            root.launch(r.app);
                        } else if (r.target != "") {
                            root.open-file(r.target);
                        }
                    }
                }
            }

            // Todos os outros apps instalados, em ordem alfabética.
            if !root.searching && Apps.others.length > 0: SectionLabel {
                x: 0;
                y: root.all-label-y + 4px;
                text: @tr("ALL APPS");
            }
            for app[i] in root.searching ? [] : Apps.others: AppTile {
                x: Math.mod(i, 6) * (108px + 11px);
                y: root.all-label-y + root.label-gap + floor(i / 6) * root.row-step;
                app: app;
                clicked => { root.launch(app.id); }
                menu => { root.open-menu(app, self.x, self.y); }
            }
        }

        // Indicador de rolagem (só quando a lista não cabe).
        if list.content-height > list.height: Rectangle {
            x: list.x + list.width + 10px;
            y: list.y + list.height * (-list.content-y / list.content-height);
            width: 3px;
            height: list.height * list.height / list.content-height;
            border-radius: 1.5px;
            background: Theme.text-muted.with-alpha(0.5);
        }

        if root.shown.length == 0: Text {
            y: 180px;
            text: @tr("No apps found for \"{}\"", root.query);
            color: Theme.text-muted;
            font-family: Theme.sans;
            font-size: 14px;
        }

        // --- Rodapé ---
        Rectangle {
            x: 29px;
            y: 480px;
            width: parent.width - 58px;
            height: 1px;
            background: Theme.border;
        }
        HorizontalLayout {
            x: 29px;
            y: 503px;
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 34px;
                Avatar { width: 34px; height: 34px; letter: Shell.user-initial; }
            }
            Text {
                text: Shell.user-name;
                color: Theme.text;
                font-family: Theme.sans;
                font-size: 15px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            x: parent.width - self.preferred-width - 29px;
            y: 503px;
            height: 44px;
            spacing: 10px;
            // Sessão real: bloquear abre o swaylock e "sair" encerra a sessão
            // (volta para a tela de login do greetd). Protótipo: tela de login.
            IconButton {
                icon: Icons.lock;
                clicked => {
                    if (Shell.native) {
                        root.launch("lock");
                    } else {
                        root.lock();
                    }
                }
            }
            if Shell.native: IconButton {
                icon: Icons.log-out;
                clicked => { root.launch("logout"); }
            }
            IconButton {
                icon: Icons.power;
                icon-color: Theme.danger;
                clicked => { Shell.power-off(); }
            }
        }

        // Menu do botão direito num app: abrir e fixar/desafixar na dock.
        if root.menu-open: TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.menu-open = false;
                }
            }
        }
        if root.menu-open: Rectangle {
            x: min(root.menu-x, parent.width - self.width - 12px);
            y: min(root.menu-y, parent.height - self.height - 12px);
            width: 210px;
            height: menu-col.preferred-height;
            border-radius: 12px;
            background: Theme.panel-solid;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000090;
            TouchArea { }
            menu-col := VerticalLayout {
                padding: 5px;
                for item[k] in [@tr("Open"), Shell.dock-has(Theme.dock-apps, root.menu-app.id) ? @tr("Unpin from dock") : @tr("Pin to dock")]: Rectangle {
                    height: 34px;
                    border-radius: 7px;
                    background: menu-touch.has-hover ? Theme.tile-hover : transparent;
                    Text {
                        x: 10px;
                        text: item;
                        color: Theme.text;
                        font-family: Theme.sans;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    menu-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.menu-open = false;
                            if (k == 0) {
                                root.launch(root.menu-app.id);
                            } else {
                                Theme.dock-apps = Shell.dock-toggle(Theme.dock-apps, root.menu-app.id);
                                Shell.save-prefs();
                            }
                        }
                    }
                }
            }
        }
    }
}
