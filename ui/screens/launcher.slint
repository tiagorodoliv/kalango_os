// Menu de apps (launcher): card central com busca, apps fixados, recentes
// e rodapé do usuário. Abre com Super (⌃ Control no macOS) ou pela pílula.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Apps, AppEntry, Shell } from "../globals.slint";
import { SectionLabel, Avatar, IconButton, LinkText } from "../components/widgets.slint";

/// Tile de app da grade (108×101). Apps do catálogo usam os ícones de traço
/// na cor do app; apps do sistema ("Todos os apps") trazem o ícone colorido
/// próprio (`tint` transparente) ou, sem ícone, a inicial.
component AppTile inherits Rectangle {
    in property <AppEntry> app;
    callback clicked();

    width: 108px;
    height: 101px;
    border-radius: 10px;
    background: touch.has-hover ? Theme.tile-hover : Theme.tile;
    border-width: 1px;
    border-color: Theme.border;
    animate background { duration: Theme.anim; }

    /// Ícone colorido do próprio app (app do sistema).
    property <bool> own-icon: root.app.tint == transparent;

    // Quadradinho do ícone: o Terminal tem fundo preto, os demais a cor do app.
    Rectangle {
        y: 15px;
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: root.own-icon ? transparent
            : root.app.id == "terminal" ? #05080b : root.app.tint.with-alpha(0.16);
        if root.app.letter == "": Image {
            source: root.app.icon;
            colorize: root.own-icon ? transparent : root.app.id == "files" ? Theme.accent : root.app.tint;
            width: root.own-icon ? 44px : 22px;
            height: root.own-icon ? 44px : 22px;
        }
        if root.app.letter != "": Text {
            text: root.app.letter;
            color: root.app.tint;
            font-family: Theme.sans;
            font-size: 22px;
            font-weight: 600;
        }
    }

    Text {
        y: 73px;
        width: parent.width - 12px;
        horizontal-alignment: center;
        overflow: elide;
        text: root.app.name;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 13.5px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Launcher inherits Rectangle {
    callback launch(string);
    /// Abrir um arquivo recente (caminho completo).
    callback open-file(string);
    callback close();
    callback lock();

    /// Texto digitado na busca.
    property <string> query: search.text;
    /// Página "Todos os apps" aberta (no lugar dos fixados e recentes).
    property <bool> all-view: false;
    /// Grade grande e com rolagem: busca ou "Todos os apps". Sem ela, a grade
    /// dos fixados (2 linhas) divide o card com os recentes.
    property <bool> tall-grid: root.query != "" || root.all-view;
    /// Apps exibidos: fixados, todos os apps ou o resultado do filtro (feito
    /// no Rust, que procura também nos apps instalados).
    property <[AppEntry]> shown: root.query != "" ? Shell.filter-apps(root.query)
        : root.all-view ? Apps.all : Apps.pinned;

    // Volta ao topo da grade quando a lista muda (outra busca ou página).
    changed query => { grid.content-y = 0; }
    changed all-view => { grid.content-y = 0; }

    /// Limpa a busca, volta aos fixados e foca o campo (chamado ao abrir).
    public function reset() {
        search.text = "";
        root.all-view = false;
        search.focus();
    }

    // Escurece o fundo; clicar fora do card fecha.
    Rectangle {
        background: Theme.background.with-alpha(0.55);
        TouchArea { clicked => { root.close(); } }
    }

    card := Rectangle {
        width: 759px;
        height: 569px;
        // 121px na tela de referência, menos a barra superior (35px).
        y: 86px;
        border-radius: 18px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 50px;
        drop-shadow-color: #000000a0;

        // Bloqueia cliques no card para não fechar o launcher.
        TouchArea { }

        // --- Busca ---
        Rectangle {
            x: 29px;
            y: 29px;
            width: parent.width - 58px;
            height: 54px;
            border-radius: 10px;
            background: Theme.sunken;
            border-width: 1.5px;
            border-color: Theme.accent;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.accent.with-alpha(0.18);

            Image {
                x: 20px;
                source: Icons.search;
                colorize: Theme.accent;
                width: 19px;
                height: 19px;
            }

            if search.text == "": Text {
                x: 53px;
                text: @tr("Search apps, files, commands...");
                color: Theme.text-muted;
                font-family: Theme.sans;
                font-size: 17px;
                vertical-alignment: center;
            }

            search := TextInput {
                x: 53px;
                width: parent.width - 53px - 80px;
                height: parent.height;
                vertical-alignment: center;
                color: Theme.text;
                font-family: Theme.sans;
                font-size: 17px;
                selection-background-color: Theme.accent.with-alpha(0.4);
                // Enter abre o primeiro resultado.
                accepted => {
                    if (root.shown.length > 0) {
                        root.launch(root.shown[0].id);
                    }
                }
            }

            // Etiqueta do atalho
            Rectangle {
                x: parent.width - self.width - 18px;
                width: super-label.preferred-width + 16px;
                height: 22px;
                border-radius: 5px;
                background: Theme.tile;
                super-label := Text {
                    text: "Super";
                    color: Theme.text-muted;
                    font-family: Theme.mono;
                    font-size: 11px;
                }
            }
        }

        // --- Fixados (ou resultados da busca) ---
        SectionLabel {
            x: 29px;
            y: 112px;
            text: root.query != "" ? @tr("RESULTS") : root.all-view ? @tr("ALL APPS") : @tr("PINNED");
        }
        if root.query == "": LinkText {
            x: parent.width - self.width - 29px;
            y: 110px;
            text: root.all-view ? @tr("Back to pinned") : @tr("All apps");
            clicked => {
                root.all-view = !root.all-view;
                search.focus();
            }
        }

        // Grade 6 colunas; posição calculada pelo índice. Com busca ou em
        // "Todos os apps" ela ocupa até o rodapé e rola com a roda do mouse.
        grid := Flickable {
            x: 29px;
            y: 140px;
            width: 703px;
            height: root.tall-grid ? 330px : 213px;
            content-height: max(self.height, ceil(root.shown.length / 6) * (101px + 11px) - 11px);

            for app[i] in root.shown: AppTile {
                x: Math.mod(i, 6) * (108px + 11px);
                y: floor(i / 6) * (101px + 11px);
                app: app;
                clicked => { root.launch(app.id); }
            }
        }

        // Indicador de rolagem (só quando a lista não cabe).
        if grid.content-height > grid.height: Rectangle {
            x: grid.x + grid.width + 10px;
            y: grid.y + grid.height * (-grid.content-y / grid.content-height);
            width: 3px;
            height: grid.height * grid.height / grid.content-height;
            border-radius: 1.5px;
            background: Theme.text-muted.with-alpha(0.5);
        }

        if root.shown.length == 0: Text {
            y: 180px;
            text: @tr("No apps found for \"{}\"", root.query);
            color: Theme.text-muted;
            font-family: Theme.sans;
            font-size: 14px;
        }

        // --- Recentes (só sem busca) ---
        if !root.tall-grid: SectionLabel {
            x: 29px;
            y: 381px;
            text: @tr("RECENT");
        }
        for r[i] in root.tall-grid ? [] : Apps.recents: Rectangle {
            x: 29px + i * (346px + 9px);
            y: 406px;
            width: 346px;
            height: 50px;
            border-radius: 8px;
            background: recent-touch.has-hover ? Theme.tile-hover : Theme.tile;

            // O atalho do instalador (ISO live) ganha borda de destaque.
            border-width: r.kind == "install" ? 1px : 0;
            border-color: Theme.accent.with-alpha(0.6);

            Image {
                x: 14px;
                source: r.kind == "code" ? Icons.code : r.kind == "image" ? Icons.image
                    : r.kind == "install" ? Icons.download : Icons.file;
                colorize: r.kind == "code" ? #a78bfa : r.kind == "image" ? #f28b95
                    : r.kind == "install" ? Theme.accent : #7ea6f7;
                width: 19px;
                height: 19px;
            }
            VerticalLayout {
                x: 44px;
                width: parent.width - 58px;
                alignment: center;
                spacing: 1px;
                Text { text: r.name; color: Theme.text; font-family: Theme.sans; font-size: 13.5px; overflow: elide; }
                Text { text: r.path; color: Theme.text-muted; font-family: Theme.mono; font-size: 12px; overflow: elide; }
            }
            recent-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (r.app != "") {
                        root.launch(r.app);
                    } else if (r.target != "") {
                        root.open-file(r.target);
                    }
                }
            }
        }

        if !root.tall-grid && Apps.recents.length == 0: Text {
            x: 29px;
            y: 421px;
            text: @tr("No recently opened files");
            color: Theme.text-muted;
            font-family: Theme.sans;
            font-size: 13px;
        }

        // --- Rodapé ---
        Rectangle {
            x: 29px;
            y: 480px;
            width: parent.width - 58px;
            height: 1px;
            background: Theme.border;
        }
        HorizontalLayout {
            x: 29px;
            y: 503px;
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 34px;
                Avatar { width: 34px; height: 34px; letter: Shell.user-initial; }
            }
            Text {
                text: Shell.user-name;
                color: Theme.text;
                font-family: Theme.sans;
                font-size: 15px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            x: parent.width - self.preferred-width - 29px;
            y: 503px;
            height: 44px;
            spacing: 10px;
            // Sessão real: bloquear abre o swaylock e "sair" encerra a sessão
            // (volta para a tela de login do greetd). Protótipo: tela de login.
            IconButton {
                icon: Icons.lock;
                clicked => {
                    if (Shell.native) {
                        root.launch("lock");
                    } else {
                        root.lock();
                    }
                }
            }
            if Shell.native: IconButton {
                icon: Icons.log-out;
                clicked => { root.launch("logout"); }
            }
            IconButton {
                icon: Icons.power;
                icon-color: Theme.danger;
                clicked => { Shell.power-off(); }
            }
        }
    }
}
