// Dados globais compartilhados entre UI e Rust.
//
// - `Apps`: catálogo dos apps fixados (fonte única para launcher e dock).
// - `Shell`: estado do sistema preenchido pelo Rust (relógio, CPU, bateria,
//   apps abertos) e callbacks que a UI chama no Rust (busca, login, abrir app,
//   desligar).

import { Icons } from "icons.slint";
import { Theme } from "theme.slint";

/// Um app do catálogo.
export struct AppEntry {
    /// Identificador estável usado para abrir o app (ex.: "files").
    id: string,
    /// Nome exibido em pt-BR.
    name: string,
    icon: image,
    /// Cor do ícone; o fundo do quadradinho usa a mesma cor com alfa baixo.
    /// Transparente nos apps do sistema com ícone próprio (já colorido).
    tint: color,
    /// Inicial exibida no lugar do ícone (app do sistema sem ícone).
    letter: string,
    /// Texto extra da busca (nome genérico, palavras-chave, programa).
    keywords: string,
    /// Estilos Mandacaru (`src/launcher/icon_style.rs`): o ícone em tons de
    /// creme (Barro) e de âmbar (Noite do sertão), e a cor da caatinga do
    /// fundo (Caatinga). Vazios/transparente nos ícones de traço do catálogo,
    /// que o `AppIcon` pinta com `colorize`.
    icon-barro: image,
    icon-noite: image,
    earth: color,
}

/// Uma imagem própria de papel de parede (Configurações → Aparência).
export struct CustomWallpaper {
    path: string,
    thumb: image,
}

/// Um item da seção RECENTES do launcher (arquivo ou atalho de app).
export struct RecentEntry {
    /// Nome do arquivo (ou do atalho, ex.: "Instalar KalangOS").
    name: string,
    /// Linha secundária: pasta do arquivo, abreviada com "~".
    path: string,
    /// Tipo, que escolhe o ícone: "file", "code", "image" ou "install".
    kind: string,
    /// Caminho completo para abrir (arquivos).
    target: string,
    /// Id de app do catálogo a abrir no lugar de um arquivo (ex.: "installer").
    app: string,
}

/// Amostras de um tema de ícones (Configurações → Aparência).
export struct IconPreview {
    icons: [image],
}

export global Apps {
    /// Os 12 apps fixados do launcher (grade 6×2), na ordem do layout.
    /// Na sessão real, o Rust troca os ícones de traço pelos do tema de ícones
    /// (`tint` transparente = ícone colorido próprio).
    in-out property <[AppEntry]> pinned: [
        { id: "files", name: @tr("Files"), icon: Icons.folder, tint: #3dd6f5 },
        { id: "terminal", name: "Terminal", icon: Icons.terminal, tint: #3dd6f5 },
        { id: "browser", name: @tr("Browser"), icon: Icons.globe, tint: #7ea6f7 },
        { id: "code", name: @tr("Code"), icon: Icons.code, tint: #a78bfa },
        { id: "store", name: @tr("Store"), icon: Icons.bag, tint: #e8b04b },
        { id: "settings", name: @tr("Settings"), icon: Icons.settings, tint: #9aa5b1 },
        { id: "images", name: @tr("Images"), icon: Icons.image, tint: #f28b95 },
        { id: "music", name: @tr("Music"), icon: Icons.music, tint: #5fd38d },
        { id: "documents", name: @tr("Documents"), icon: Icons.file-text, tint: #7ea6f7 },
        { id: "calendar", name: @tr("Calendar"), icon: Icons.calendar, tint: #e8b04b },
        { id: "monitor", name: "Monitor", icon: Icons.activity, tint: #3dd6f5 },
        { id: "updates", name: @tr("Updates"), icon: Icons.download, tint: #9aa5b1 },
    ];

    /// Todos os apps instalados (página "Todos os apps" do menu), em ordem
    /// alfabética. Sessão real: o Rust lê os `.desktop` do sistema
    /// (`src/launcher/desktop.rs`). Protótipo: os próprios fixados.
    in-out property <[AppEntry]> all: pinned;

    /// Os apps instalados que não estão nos fixados (nem repetem um deles,
    /// como o Thunar = Arquivos): a parte "Todos os apps" do menu, embaixo dos
    /// fixados e dos recentes, na mesma lista com rolagem.
    in-out property <[AppEntry]> others: [];

    /// Apps da dock (antes do separador; Configurações vem depois dele),
    /// escolhidos em Configurações → Barra de tarefas (`Theme.dock-apps`).
    out property <[AppEntry]> dock: Shell.dock-entries(Theme.dock-apps);

    /// Protótipo: os dois arquivos do layout. Sessão real: o Rust preenche com
    /// os recentes de verdade (`src/launcher/recent.rs`) e o atalho do instalador.
    in-out property <[RecentEntry]> recents: [
        { name: "README.md", path: "~/Projects/distro", kind: "file" },
        { name: "main.cpp", path: "~/Projects/firmware", kind: "code" },
    ];
}

/// Tema do terminal (Configurações → Aparência → Terminal, `src/settings/terminal.rs`),
/// com as cores da prévia.
export struct TerminalTheme {
    id: string,
    name: string,
    bg: color,
    fg: color,
    red: color,
    green: color,
    yellow: color,
    blue: color,
    magenta: color,
    cyan: color,
}

/// Uma conta na tela de login.
export struct LoginUser {
    login: string,
    name: string,
    initial: string,
    /// Sessão aberta dessa conta ("" = nenhuma): escolher volta para ela.
    session: string,
}

export global Shell {
    /// Configurações com transparência (OpenGL): cantos de baixo
    /// arredondados como os da barra de título do labwc.
    in property <bool> rounded-window: false;
    /// A janela está maximizada (os cantos ficam retos).
    in property <bool> window-maximized: false;
    /// Configurações com moldura própria (sessão real; o labwc não decora).
    in property <bool> own-titlebar: false;
    /// O que a moldura própria pede (src/lib.rs, pelo winit).
    callback window-drag();
    /// 0 = cima, 1 = baixo, 2 = esquerda, 3 = direita, 4..7 = cantos
    /// (cima-esq, cima-dir, baixo-esq, baixo-dir).
    callback window-resize(int);
    callback window-minimize();
    callback window-toggle-maximize();

    // --- Preenchido pelo Rust (src/common/clock.rs e src/common/system.rs) ---

    /// Hora "19:38" (tela de login).
    in property <string> time: "--:--";
    /// Data por extenso, "quarta-feira, 11 de novembro" (tela de login).
    in property <string> long-date: "";
    /// Dia da barra superior, "qua 11 nov".
    in property <string> bar-day: "";
    /// Hora da barra superior, "19:38".
    in property <string> bar-time: "--:--";
    /// Segundos da hora atual, "05" (opção "Mostrar segundos").
    in property <string> bar-seconds: "00";
    /// Papel de parede escolhido (`Theme.wallpaper`), já carregado pelo Rust
    /// na resolução da tela (`src/shell/wallpaper.rs`). Vazio = circuitos.
    in property <image> wallpaper;
    /// Miniaturas dos papéis de parede (ordem de `Theme.wallpaper-names`;
    /// a 1ª, dos circuitos, fica vazia).
    in property <[image]> wallpaper-thumbs;
    /// Miniatura da imagem própria (vazia sem imagem escolhida).
    in property <image> wallpaper-custom-thumb;
    /// Imagens próprias já adicionadas (caminho e miniatura), para escolher
    /// de novo ou tirar da lista (`src/shell/wallpaper.rs`).
    in property <[CustomWallpaper]> wallpaper-customs;
    callback remove-custom-wallpaper(string);
    /// Escolhendo/preparando a imagem própria, ou o erro dela.
    in property <bool> wallpaper-busy: false;
    in property <string> wallpaper-message: "";
    /// Abre a janela de escolher imagem e a usa como papel de parede.
    callback pick-wallpaper();
    /// Amostras dos temas de ícones (ordem de `Theme.icon-theme-names`).
    in property <[IconPreview]> icon-previews;
    /// Uso de CPU, "12%" ou "--" fora do Linux.
    in property <string> cpu: "--";
    /// Carga da bateria, "78%" ou "--" sem bateria.
    in property <string> battery: "--";
    /// Carga em número (0–100), para o desenho do ícone.
    in property <int> battery-level: 0;
    /// Ligada na tomada (carregando ou cheia): o ícone mostra o raio.
    in property <bool> battery-charging: false;
    /// Ícone de rede da barra pela conexão principal (`src/common/system.rs`):
    /// "ethernet", "ethernet-off", "wifi-0" a "wifi-3" ou "wifi-off".
    in property <string> net-icon: "ethernet-off";
    /// Gravando num pendrive (`src/shell/usb.rs`): a barra pede para não remover.
    in property <bool> usb-writing: false;
    /// Gravando a tela (`wf-recorder` aberto pela captura, src/shell/capture.rs):
    /// aviso no centro da barra; Print para.
    in property <bool> recording: false;
    /// "Identificar" monitores: número e nome do monitor desta janela.
    in property <bool> identify-visible: false;
    in property <int> identify-number: 1;
    in property <string> identify-name: "";
    /// A dock está numa janela própria, sempre por cima (`src/shell/dock.rs`): a
    /// área de trabalho não a desenha.
    in property <bool> dock-external: false;
    /// Tamanho da janela da dock (`--faixa=LxA`).
    in property <length> dock-strip-width: 1440px;
    in property <length> dock-strip-height: 70px;
    /// Dock escondida: o mouse encostou na faixa da borda (`--dock-gatilho`)
    /// e a dock deve aparecer por cima das janelas (`src/shell/dock.rs`).
    callback reveal-dock();
    /// Dock em janela própria: o mouse está em cima dela (a dock aberta pela
    /// faixa some sozinha quando ele sai).
    in-out property <bool> dock-hovered: false;
    /// Áreas de trabalho (`src/shell/workspaces.rs`): quantas há (0 = sem
    /// indicador) e a ativa (a partir de 0).
    in property <int> workspace-count: 3;
    in property <int> workspace-active: 0;
    /// Vai para a área de trabalho `índice`.
    callback switch-workspace(int);
    /// Temas do terminal e o escolhido ("" = foot.ini feito à mão).
    in property <[TerminalTheme]> terminal-themes: [];
    in property <string> terminal-theme: "kalango";
    in property <string> terminal-message: "";
    callback set-terminal-theme(string);
    /// Nome exibido do usuário.
    in property <string> user-name: @tr("User");
    /// Letra do avatar (inicial do nome).
    in property <string> user-initial: "U";

    // --- Tela de login de verdade (greeter do greetd, `src/shell/greeter.rs`) ---

    /// Rodando como greeter: a senha vai para o greetd/PAM.
    in property <bool> greeter: false;
    /// Login (nome de usuário do sistema) que vai entrar.
    in property <string> login-user: "user";
    /// Contas de pessoas (com mais de uma, a tela de login mostra todas).
    in property <[LoginUser]> login-users: [];
    /// Sessão aberta da conta escolhida ("" = nenhuma): a tela mostra
    /// "Voltar à sessão" no lugar da senha (trocar de usuário).
    in property <string> login-session: "";
    /// Greeter: a conta escolhida tem PIN (`/var/lib/kalango/pin/<conta>`):
    /// o campo vira "Senha ou PIN" (o mesmo campo aceita os dois).
    in property <bool> login-has-pin: false;
    /// Conferindo a senha (o PAM leva ~2 s para recusar).
    in property <bool> login-busy: false;
    /// Erro da última tentativa ("Senha incorreta"); a UI limpa ao digitar.
    in-out property <string> login-error: "";
    /// Sessão real do KalangOS (labwc, variável `KALANGO_SESSION=1`):
    /// os apps abrem de verdade e as janelas de demonstração somem.
    /// Desligado no desenvolvimento e nas capturas (protótipo navegável).
    in property <bool> native: false;
    /// Rodando da ISO live (`/run/live/medium`): a área de trabalho mostra o
    /// ícone "Instalar KalangOS" no canto, à vista de quem experimenta.
    in property <bool> live: false;
    /// O app em foco está em tela cheia (vídeo, jogo): a dock em janela
    /// própria fecha até ele sair (`src/shell/dock.rs`).
    in property <bool> app-fullscreen: false;
    /// Lixeira (`src/shell/trash.rs`): tem algo dentro e os ícones do tema
    /// de ícones (vazia e cheia; vazios sem tema, aí vale `Icons.trash`).
    in property <bool> trash-full: false;
    in property <image> trash-icon;
    in property <image> trash-icon-full;
    /// Apps com janela aberta (sessão real, `src/shell/taskbar.rs`): ids da dock
    /// separados por vírgula ("files,desktop:/usr/share/...").
    in property <string> running-ids: "";
    /// Id do app em foco (traço de destaque na dock).
    in property <string> active-app: "";
    /// Apps abertos que não estão fixados: aparecem na dock depois dos fixados.
    in property <[AppEntry]> running-extra: [];
    /// Clique num app da dock na sessão real: põe a janela em foco, minimiza
    /// (se já estava em foco) ou abre o app.
    callback dock-click(string);
    /// Botão direito num app da dock: menu com as janelas, nova janela,
    /// fixar/desafixar e fechar. `offset` = centro do item ao longo da dock.
    callback dock-menu(string /* id */, length /* offset */);
    /// Alt+Tab: o painel aparece só depois de 120 ms (Alt+Tab rápido não pisca).
    in property <bool> switcher-reveal: true;
    /// Grava a aparência agora (fixar na dock pelo menu, que fecha logo).
    callback save-prefs();

    // --- Implementado no Rust ---

    /// Filtra o catálogo pela busca (sem diferenciar maiúsculas nem acentos).
    pure callback filter-apps(string) -> [AppEntry];
    /// Apps do catálogo com os ids da lista (`Theme.dock-apps`), na mesma ordem.
    pure callback dock-entries(string) -> [AppEntry];
    /// A lista de ids (`Theme.dock-apps`) contém o app?
    pure callback dock-has(string /* lista */, string /* id */) -> bool;
    /// Lista com o app acrescentado no fim (ou tirado, se já estava).
    /// A dock nunca fica vazia: o último app não sai.
    pure callback dock-toggle(string /* lista */, string /* id */) -> string;
    /// Valida a senha. Protótipo: aceita qualquer senha não vazia
    /// (no sistema real: PAM via greetd).
    callback try-login(string) -> bool;
    /// Desliga. Protótipo: encerra o programa; sessão real: `systemctl poweroff`.
    callback power-off();
    /// Sessão real: abre o app do catálogo (ou "launcher"/"settings", que são
    /// janelas do próprio shell). Devolve `false` se o app não está instalado.
    callback open-app(string) -> bool;
    /// Sessão real: abre um arquivo no app padrão (`xdg-open`).
    callback open-file(string) -> bool;
    /// Fecha esta janela do shell (usado pelo launcher e pelas Configurações,
    /// que rodam como processos próprios na sessão real).
    callback quit();
    /// Greeter: confere a senha do usuário no greetd e, se der certo, sai
    /// para o greetd iniciar a sessão. O resultado volta em `login-error`.
    callback start-login(string /* usuário */, string /* senha */);
    /// Greeter: troca o usuário ("Outro usuário").
    callback choose-user(string);
    /// Greeter: volta para a sessão aberta da conta escolhida (`login-session`),
    /// que continua bloqueada.
    callback return-to-session();
}
