// Janela raiz do protótipo do Kalango OS.
//
// Fluxo navegável: login → área de trabalho (janelas Arquivos/Terminal,
// dock, barra) → menu de apps (overlay) → Configurações → Aparência.
//
// Na sessão real (`Shell.native`) o mesmo binário roda em três processos,
// escolhidos por `mode`: a área de trabalho (sempre atrás dos apps), o menu
// de apps (`--launcher`, tela cheia e transparente, por cima de tudo) e as
// Configurações (`--settings`, janela comum); o greeter do greetd
// (`--greeter`) usa só a tela de login. As janelas de demonstração
// somem e a dock/menu abrem os apps instalados.
// O estado de navegação mora aqui; tema e dados do sistema ficam nos
// globais `Theme` e `Shell`, que o Rust também acessa.

// Fontes embutidas no binário: o visual não depende do que está instalado.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

import { Theme, ThemeMode } from "theme.slint";
import { Apps, AppEntry, RecentEntry, Shell, IconPreview } from "globals.slint";
import { Backdrop, BackdropVariant } from "components/backdrop.slint";
import { TopBar } from "components/top_bar.slint";
import { Dock } from "components/dock.slint";
import { DesktopMenuArea } from "components/desktop_menu.slint";
import { CalendarView, Calendar, CalendarDay } from "screens/calendar.slint";
import { FilesWindow } from "apps/files.slint";
import { TerminalWindow } from "apps/terminal.slint";
import { LoginScreen } from "screens/login.slint";
import { Launcher } from "screens/launcher.slint";
import { SwitcherView, Switcher, SwitcherItem, DockMenuView, DockMenu, DockMenuWindow } from "screens/switcher.slint";
import { SettingsScreen } from "screens/settings.slint";
import { QuickSettings } from "screens/quick_settings.slint";
import { Device, InfoItem, WifiNetwork, DisplayOutput, DisplayResolution, Power, Accounts, UserAccount, Printers, Printer, PrinterDevice } from "device.slint";

// Reexportados para o Rust enxergar os globais e tipos.
export { Theme, ThemeMode, Shell, Apps, AppEntry, RecentEntry, IconPreview, Device, InfoItem, WifiNetwork, DisplayOutput, DisplayResolution }
export { Switcher, SwitcherItem, DockMenu, DockMenuWindow, Power, Accounts, UserAccount, Printers, Printer, PrinterDevice, Calendar, CalendarDay }

/// Telas de nível superior.
export enum Screen { login, desktop, settings }

/// O que este processo do shell mostra (ver `src/shell/session.rs`).
export enum ShellMode {
    /// Área de trabalho: login, barra, dock e fundo. Padrão.
    desktop,
    /// Só o menu de apps, sobre fundo transparente (`--launcher`).
    launcher,
    /// Só as Configurações (`--settings`).
    settings,
    /// Só a tela de login, conferindo a senha no greetd (`--greeter`).
    greeter,
    /// Só o painel rápido do canto da barra, sobre fundo transparente
    /// (`--quick-settings`).
    quick-settings,
    /// Só a dock, em janela própria sempre por cima (`--dock`, src/shell/dock.rs).
    dock,
    /// Só o papel de parede de um monitor extra (`--fundo=`, src/shell/outputs.rs).
    fundo,
    /// Só o calendário do relógio, sobre fundo transparente (`--calendario`).
    calendar,
    /// Alt+Tab: as janelas abertas (`--alternar`, src/shell/switcher.rs).
    switcher,
    /// Menu do botão direito de um app da dock (`--menu-dock=`, src/shell/taskbar.rs).
    dock-menu,
}

export component AppWindow inherits Window {
    title: root.mode == ShellMode.settings ? @tr("Settings") : "Kalango OS";
    icon: @image-url("brand/kalango-icon.png");
    // Referência do layout em px lógicos; no dispositivo (feature kms)
    // a janela ocupa a tela inteira automaticamente.
    // A dock em janela própria tem o tamanho dela (`--faixa=LxA`).
    preferred-width: root.mode == ShellMode.dock ? Shell.dock-strip-width : 1440px;
    preferred-height: root.mode == ShellMode.dock ? Shell.dock-strip-height : 900px;
    min-width: root.mode == ShellMode.dock ? 0 : 1100px;
    min-height: root.mode == ShellMode.dock ? 0 : 720px;
    // O launcher, o painel rápido e a dock são camadas transparentes por cima
    // dos apps (a dock: os cantos arredondados mostram o que está atrás).
    background: root.mode == ShellMode.launcher || root.mode == ShellMode.quick-settings || root.mode == ShellMode.calendar || root.mode == ShellMode.dock
        || root.mode == ShellMode.switcher || root.mode == ShellMode.dock-menu
        ? transparent : Theme.background;
    // A dock é uma janela comum (não tela cheia): sem moldura nenhuma.
    no-frame: root.mode == ShellMode.dock;
    default-font-family: Theme.sans;

    in property <ShellMode> mode: ShellMode.desktop;
    in-out property <Screen> screen: Screen.login;
    in-out property <bool> launcher-open: false;
    /// Painel rápido aberto (protótipo; na sessão real é outro processo).
    /// Protótipo e capturas: lista de redes do painel rápido aberta e a rede
    /// escolhida nela (esperando a senha).
    in-out property <bool> quick-wifi-open: false;
    in-out property <string> quick-wifi-selected: "";
    in-out property <bool> quick-open: false;
    /// Protótipo: calendário aberto (na sessão real é o processo `--calendario`).
    property <bool> calendar-open: false;
    /// Página aberta nas Configurações (2 = Aparência, 3 = Barra de tarefas,
    /// 4 = Monitores...). O Rust escolhe a inicial (`--pagina=`) e troca a
    /// página quando o menu da área de trabalho pede outra.
    in-out property <int> settings-page: 2;
    /// Menu do botão direito aberto, e onde o botão foi clicado.
    property <bool> files-open: true;
    property <bool> terminal-open: true;
    /// App com a janela em primeiro plano ("files" ou "terminal").
    property <string> focused-app: "terminal";
    /// Aviso temporário no rodapé (ex.: app ainda não existe no protótipo).
    property <string> toast;

    /// Abre um app pelo id do catálogo.
    function launch(id: string) {
        if (Shell.native) {
            // Sessão real: o Rust abre o app instalado (ou a janela de
            // Configurações). O launcher se fecha depois de abrir.
            if (Shell.open-app(id)) {
                root.launcher-open = false;
                if (root.mode == ShellMode.launcher) {
                    Shell.quit();
                }
            } else {
                root.show-toast(@tr("This app is not available yet"));
            }
        } else {
            root.launch-demo(id);
        }
        keys.focus();
    }

    /// Clique num app da dock: na sessão real o Rust decide (foca, minimiza
    /// ou abre); no protótipo, abre.
    function dock-launch(id: string) {
        if (Shell.native) {
            Shell.dock-click(id);
        } else {
            root.launch(id);
        }
    }

    /// Protótipo: "abre" as janelas de demonstração dentro do shell.
    function launch-demo(id: string) {
        root.launcher-open = false;
        if (id == "files") {
            root.files-open = true;
            root.focused-app = "files";
            root.screen = Screen.desktop;
        } else if (id == "terminal") {
            root.terminal-open = true;
            root.focused-app = "terminal";
            root.screen = Screen.desktop;
        } else if (id == "settings") {
            root.screen = Screen.settings;
        } else {
            root.show-toast(@tr("This app does not exist in the prototype yet"));
        }
    }

    /// Abre as Configurações numa página. Sessão real: janela própria
    /// (`settings:<página>`); protótipo: a tela de Configurações.
    function open-settings(page: int) {
        if (Shell.native) {
            if (!Shell.open-app("settings:" + page)) {
                root.show-toast(@tr("Could not open Settings"));
            }
        } else {
            root.settings-page = page;
            root.screen = Screen.settings;
        }
    }

    /// Aviso curto (na sessão real, no centro da barra). Público para o
    /// Rust avisar também (ex.: fim da gravação no pendrive).
    public function show-toast(msg: string) {
        root.toast = msg;
        toast-timer.running = false;
        toast-timer.running = true;
    }

    function toggle-launcher() {
        if (Shell.native) {
            // Sessão real: o menu é outra janela, que fica por cima dos apps.
            if (!Shell.open-app("launcher")) {
                root.show-toast(@tr("Could not open the app menu"));
            }
        } else if (root.screen != Screen.login) {
            root.launcher-open = !root.launcher-open;
            if (!root.launcher-open) {
                keys.focus();
            }
        }
    }

    /// Abre ou fecha o painel rápido (clique no bloco de status da barra).
    function toggle-quick() {
        if (Shell.native) {
            // Sessão real: outra janela, por cima dos apps (rodar de novo fecha).
            if (!Shell.open-app("quick-settings")) {
                root.show-toast(@tr("Could not open the panel"));
            }
        } else {
            root.launcher-open = false;
            root.quick-open = !root.quick-open;
            keys.focus();
        }
    }

    /// Abre ou fecha o calendário (clique no relógio da barra).
    function toggle-calendar() {
        if (Shell.native) {
            Shell.open-app("calendar-popup");
        } else {
            root.launcher-open = false;
            root.quick-open = false;
            root.calendar-open = !root.calendar-open;
        }
    }

    function lock() {
        root.launcher-open = false;
        root.quick-open = false;
        root.screen = Screen.login;
    }

    toast-timer := Timer {
        interval: 2.5s;
        running: false;
        triggered => {
            root.toast = "";
            self.running = false;
        }
    }

    // Atalhos globais: teclas não tratadas pelos campos de texto chegam aqui.
    keys := FocusScope {
        key-pressed(event) => {
            // Super no Linux. No macOS o Slint troca Cmd↔Ctrl, então a tecla
            // ⌃ Control chega como Meta e também abre o launcher.
            if (event.text == Key.Meta) {
                root.toggle-launcher();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.mode == ShellMode.launcher || root.mode == ShellMode.settings || root.mode == ShellMode.quick-settings
                    || root.mode == ShellMode.dock-menu || root.mode == ShellMode.calendar) {
                    Shell.quit();
                    return accept;
                }
                if (root.quick-open) {
                    root.quick-open = false;
                    keys.focus();
                    return accept;
                }
                if (root.calendar-open) {
                    root.calendar-open = false;
                    return accept;
                }
                if (root.launcher-open) {
                    root.launcher-open = false;
                    keys.focus();
                    return accept;
                }
                if (root.screen == Screen.settings) {
                    root.screen = Screen.desktop;
                    return accept;
                }
            }
            return reject;
        }

        // ------------------------------------------------------------------
        // Login
        // ------------------------------------------------------------------
        if root.mode == ShellMode.greeter || (root.mode == ShellMode.desktop && root.screen == Screen.login): LoginScreen {
            init => { self.focus-password(); }
            logged-in => {
                root.screen = Screen.desktop;
                keys.focus();
            }
        }

        // ------------------------------------------------------------------
        // Área de trabalho (também fica por trás do launcher)
        // ------------------------------------------------------------------
        if root.mode == ShellMode.desktop && root.screen == Screen.desktop: Rectangle {
            Backdrop {
                variant: BackdropVariant.desktop;
                show-mark: root.launcher-open;
            }

            // Botão direito no fundo: menu da área de trabalho.
            desktop-menu := DesktopMenuArea {
                z: self.open ? 10 : 0;
                settings(page) => { root.open-settings(page); }
                launch(id) => { root.launch(id); }
            }

            if !Shell.native && root.files-open && !root.launcher-open: FilesWindow {
                x: 110px;
                y: 96px;
                width: 761px;
                height: 502px;
                z: root.focused-app == "files" ? 2 : 1;
                focused: root.focused-app == "files";
                activated => { root.focused-app = "files"; }
                close => { root.files-open = false; root.focused-app = "terminal"; }
            }

            if !Shell.native && root.terminal-open && !root.launcher-open: TerminalWindow {
                x: 650px;
                y: 300px;
                width: 641px;
                height: 401px;
                z: root.focused-app == "terminal" ? 2 : 1;
                focused: root.focused-app == "terminal";
                activated => { root.focused-app = "terminal"; }
                close => { root.terminal-open = false; root.focused-app = "files"; }
            }

            // Dock: embaixo, à esquerda ou à direita, flutuante ou como barra.
            // Com "Sempre visível" desligado, só aparece quando o mouse chega
            // na faixa daquela borda.
            // Com a dock em janela própria (sempre por cima), esta não aparece.
            if !root.launcher-open && !Shell.dock-external: dock-zone := TouchArea {
                property <int> pos: Theme.dock-position;
                // Encostada na borda da tela (sem folga).
                property <length> gap: 0;
                property <length> zone: Theme.dock-thickness + self.gap + 22px;
                property <bool> show: Theme.dock-always-visible || self.has-hover;
                x: self.pos == 2 ? parent.width - self.zone : 0;
                y: self.pos == 0 ? parent.height - self.zone : Theme.bar-height;
                width: self.pos == 0 ? parent.width : self.zone;
                height: self.pos == 0 ? self.zone : parent.height - Theme.bar-height;
                z: 3;

                Dock {
                    bar-length: dock-zone.pos == 0 ? dock-zone.width : dock-zone.height;
                    x: dock-zone.pos == 0 ? (parent.width - self.width) / 2
                        : dock-zone.pos == 1 ? (dock-zone.show ? dock-zone.gap : -self.width - 4px)
                        : (dock-zone.show ? parent.width - self.width - dock-zone.gap : parent.width + 4px);
                    y: dock-zone.pos == 0
                        ? (dock-zone.show ? parent.height - self.height - dock-zone.gap : parent.height + 4px)
                        : (parent.height - self.height) / 2;
                    files-open: root.files-open;
                    terminal-open: root.terminal-open;
                    focused-app: root.focused-app;
                    launch(id) => { root.dock-launch(id); }
                    menu(id, offset) => { if (Shell.native) { Shell.dock-menu(id, offset); } }
                    animate x, y { duration: Theme.anim; easing: ease-out; }
                }
            }
        }

        // ------------------------------------------------------------------
        // Configurações
        // ------------------------------------------------------------------
        if root.mode == ShellMode.desktop && root.screen == Screen.settings: Rectangle {
            Backdrop { variant: BackdropVariant.plain; }
            SettingsScreen {
                y: Theme.bar-height;
                height: parent.height - Theme.bar-height;
                current <=> root.settings-page;
                close => {
                    root.screen = Screen.desktop;
                    keys.focus();
                }
            }
        }

        // ------------------------------------------------------------------
        // Barra superior (todas as telas menos o login)
        // ------------------------------------------------------------------
        if root.mode == ShellMode.desktop && root.screen != Screen.login: TopBar {
            y: 0;
            width: parent.width;
            z: 5;
            launcher-open: root.launcher-open;
            compact: root.launcher-open || root.screen == Screen.settings;
            message: !Shell.native ? ""
                : root.toast != "" ? root.toast
                : Shell.usb-writing ? @tr("Writing to the USB drive, do not remove it") : "";
            quick-open: root.quick-open;
            status-clicked => { root.toggle-quick(); }
            pill-clicked => { root.toggle-launcher(); }
            clock-clicked => { root.toggle-calendar(); }
        }
        // Protótipo: o calendário dentro da área de trabalho.
        if root.mode == ShellMode.desktop && root.calendar-open: CalendarView {
            z: 6;
            close => { root.calendar-open = false; }
        }

        // ------------------------------------------------------------------
        // Launcher (overlay, abaixo da barra)
        // ------------------------------------------------------------------
        if root.launcher-open: Launcher {
            y: Theme.bar-height;
            height: parent.height - Theme.bar-height;
            z: 4;
            init => { self.reset(); }
            launch(id) => { root.launch(id); }
            close => {
                root.launcher-open = false;
                keys.focus();
            }
            lock => { root.lock(); }
        }

        // Painel rápido do protótipo (camada por cima da área de trabalho)
        if root.quick-open: QuickSettings {
            z: 5;
            wifi-open <=> root.quick-wifi-open;
            wifi-selected <=> root.quick-wifi-selected;
            close => {
                root.quick-open = false;
                keys.focus();
            }
            open-settings(page) => {
                root.quick-open = false;
                root.open-settings(page);
            }
            lock => { root.lock(); }
            logout => { root.lock(); }
        }

        // ------------------------------------------------------------------
        // Processos da sessão real: menu de apps, painel e Configurações sozinhos
        // ------------------------------------------------------------------
        if root.mode == ShellMode.launcher: Launcher {
            // A faixa da barra fica transparente: a barra real aparece por trás.
            y: Theme.bar-height;
            height: parent.height - Theme.bar-height;
            init => { self.reset(); }
            launch(id) => { root.launch(id); }
            open-file(path) => {
                if (Shell.open-file(path)) {
                    Shell.quit();
                } else {
                    root.show-toast(@tr("Could not open the file"));
                }
            }
            close => { Shell.quit(); }
        }

        // Papel de parede de um monitor extra.
        // Botão direito nele: o mesmo menu da área de trabalho.
        if root.mode == ShellMode.fundo: Rectangle {
            Backdrop { variant: BackdropVariant.desktop; }
            DesktopMenuArea {
                settings(page) => { root.open-settings(page); }
                launch(id) => { root.launch(id); }
            }
        }

        // "Identificar" (Configurações → Monitores): número do monitor.
        if Shell.identify-visible && (root.mode == ShellMode.desktop || root.mode == ShellMode.fundo): Rectangle {
            width: 260px;
            height: 220px;
            border-radius: 28px;
            background: Theme.panel.with-alpha(0.92);
            border-width: 2px;
            border-color: Theme.accent;
            drop-shadow-blur: 40px;
            drop-shadow-color: #000000a0;
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: Shell.identify-number;
                    color: Theme.accent;
                    font-family: Theme.sans;
                    font-size: 120px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: Shell.identify-name;
                    color: Theme.text-muted;
                    font-family: Theme.mono;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
            }
        }

        // Dock em janela própria: a faixa inteira é a janela; a dock fica
        // encostada na borda da tela e centralizada.
        if root.mode == ShellMode.dock: Dock {
            bar-length: Theme.dock-position == 0 ? root.width : root.height;
            x: Theme.dock-position == 0 ? (root.width - self.width) / 2
                : Theme.dock-position == 1 ? 0 : root.width - self.width;
            y: Theme.dock-position == 0 ? root.height - self.height : (root.height - self.height) / 2;
            launch(id) => { root.dock-launch(id); }
            menu(id, offset) => { Shell.dock-menu(id, offset); }
        }

        if root.mode == ShellMode.switcher: SwitcherView { }
        if root.mode == ShellMode.dock-menu: DockMenuView { }

        if root.mode == ShellMode.calendar: CalendarView {
            close => { Shell.quit(); }
        }
        if root.mode == ShellMode.quick-settings: QuickSettings {
            close => { Shell.quit(); }
            open-settings(page) => {
                root.open-settings(page);
                Shell.quit();
            }
            lock => {
                Shell.open-app("lock");
                Shell.quit();
            }
            logout => { Shell.open-app("logout"); }
        }

        if root.mode == ShellMode.settings: Rectangle {
            Backdrop { variant: BackdropVariant.plain; }
            SettingsScreen {
                current <=> root.settings-page;
                close => { Shell.quit(); }
            }
        }

        // Aviso temporário (na área de trabalho da sessão real ele vai para
        // a barra superior, porque o rodapé pode estar atrás de um app)
        if root.toast != "" && !(Shell.native && root.mode == ShellMode.desktop): Rectangle {
            y: parent.height - 140px;
            width: toast-text.preferred-width + 32px;
            height: 38px;
            z: 6;
            border-radius: 19px;
            background: Theme.tile;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.5);
            toast-text := Text {
                text: root.toast;
                color: Theme.text;
                font-size: 13.5px;
            }
        }
    }
}
