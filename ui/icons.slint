// Ícones de traço (24×24, stroke branco) carregados uma única vez.
//
// O Slint exige caminho literal em @image-url, então cada ícone vira uma
// propriedade deste global. A cor é aplicada no uso com `colorize`.

export global Icons {
    out property <image> accessibility: @image-url("icons/accessibility.svg");
    out property <image> activity: @image-url("icons/activity.svg");
    out property <image> arrow-right: @image-url("icons/arrow-right.svg");
    out property <image> bag: @image-url("icons/bag.svg");
    out property <image> battery: @image-url("icons/battery.svg");
    out property <image> bluetooth: @image-url("icons/bluetooth.svg");
    out property <image> calendar: @image-url("icons/calendar.svg");
    out property <image> chevron-down: @image-url("icons/chevron-down.svg");
    out property <image> chevron-left: @image-url("icons/chevron-left.svg");
    out property <image> chevron-right: @image-url("icons/chevron-right.svg");
    out property <image> code: @image-url("icons/code.svg");
    out property <image> contrast: @image-url("icons/contrast.svg");
    out property <image> dock: @image-url("icons/dock.svg");
    out property <image> download: @image-url("icons/download.svg");
    out property <image> file-text: @image-url("icons/file-text.svg");
    out property <image> printer: @image-url("icons/printer.svg");
    out property <image> eye: @image-url("icons/eye.svg");
    out property <image> eye-off: @image-url("icons/eye-off.svg");
    out property <image> file: @image-url("icons/file.svg");
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> trash: @image-url("icons/trash.svg");
    out property <image> globe: @image-url("icons/globe.svg");
    /// Grade de 9 pontos: botão do menu de programas na dock (como no Ubuntu).
    out property <image> grid: @image-url("icons/grid.svg");
    out property <image> image: @image-url("icons/image.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> lock: @image-url("icons/lock.svg");
    out property <image> log-out: @image-url("icons/log-out.svg");
    out property <image> moon: @image-url("icons/moon.svg");
    out property <image> monitor: @image-url("icons/monitor.svg");
    out property <image> music: @image-url("icons/music.svg");
    out property <image> power: @image-url("icons/power.svg");
    out property <image> rotate-ccw: @image-url("icons/rotate-ccw.svg");
    out property <image> search: @image-url("icons/search.svg");
    out property <image> settings: @image-url("icons/settings.svg");
    out property <image> sun: @image-url("icons/sun.svg");
    out property <image> terminal: @image-url("icons/terminal.svg");
    out property <image> user: @image-url("icons/user.svg");
    out property <image> volume: @image-url("icons/volume.svg");
    out property <image> volume-x: @image-url("icons/volume-x.svg");
    out property <image> wifi: @image-url("icons/wifi.svg");
    out property <image> wifi-1: @image-url("icons/wifi-1.svg");
    out property <image> wifi-2: @image-url("icons/wifi-2.svg");
    out property <image> wifi-off: @image-url("icons/wifi-off.svg");
    out property <image> ethernet: @image-url("icons/ethernet.svg");
    out property <image> ethernet-off: @image-url("icons/ethernet-off.svg");
    out property <image> shield: @image-url("icons/shield.svg");
    out property <image> x: @image-url("icons/x.svg");
    out property <image> camera: @image-url("icons/camera.svg");
    out property <image> video: @image-url("icons/video.svg");
    out property <image> selection: @image-url("icons/selection.svg");
}
