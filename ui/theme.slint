// Tokens de design (cores, tamanhos, fontes) usados por toda a interface.
// Centralizar aqui permite aplicar o layout recebido trocando só estes valores.

export global Theme {
    // Cores
    out property <color> background: #0f1115;
    out property <color> surface: #1a1d24;
    out property <color> primary: #4f8cff;
    out property <color> text: #e8eaed;
    out property <color> text-muted: #9aa0a6;

    // Espaçamentos e tamanhos
    out property <length> spacing: 12px;
    out property <length> radius: 12px;
    out property <length> status-bar-height: 40px;

    // Tipografia
    out property <length> font-size: 16px;
    out property <length> font-size-title: 28px;
}
