// Tokens de design do Kalango OS (cores, fontes, tamanhos e animação).
//
// Tudo aqui é reativo: a tela Configurações → Aparência altera `accent-index`,
// `mode`, `transparency` e os toggles, e todas as cores derivadas são
// recalculadas na hora — o sistema inteiro muda ao vivo, sem reiniciar.

/// Modos de tema oferecidos na tela Aparência.
export enum ThemeMode {
    /// Escuro com painéis translúcidos ("vidro"). Padrão.
    glass,
    /// Escuro sólido, preto puro: economiza energia em telas OLED.
    oled,
    /// Claro.
    light,
}

export global Theme {
    // ---------------------------------------------------------------
    // Preferências do usuário (alteradas pela tela Aparência)
    // ---------------------------------------------------------------

    /// Índice em `accents` da cor de destaque escolhida.
    in-out property <int> accent-index: 0;
    in-out property <ThemeMode> mode: ThemeMode.glass;
    /// Transparência das janelas no modo vidro, de 0.0 a 1.0.
    in-out property <float> transparency: 0.6;
    /// Desfoque do fundo. Guardado, mas sem efeito visual no protótipo:
    /// desfoque real depende do compositor Wayland (ainda não escolhido).
    in-out property <bool> blur: true;
    in-out property <bool> dock-always-visible: true;
    in-out property <bool> reduce-motion: false;

    // ---------------------------------------------------------------
    // Barra de tarefas (Configurações → Barra de tarefas)
    // ---------------------------------------------------------------
    /// Barra superior: mostrar o dia ("qui 12 nov") antes da hora.
    in-out property <bool> bar-show-date: true;
    /// Barra superior: mostrar os segundos na hora.
    in-out property <bool> bar-show-seconds: false;
    /// Barra superior: mostrar o uso de CPU.
    in-out property <bool> bar-show-cpu: true;
    /// Barra superior: mostrar a carga da bateria (só aparece se houver bateria).
    in-out property <bool> bar-show-battery: true;
    /// Tamanho do botão de app da dock, em px (16–72, de 4 em 4; padrão 52),
    /// como o "Tamanho dos ícones" do Ubuntu.
    in-out property <int> dock-size: 52;
    /// Borda da dock: 0 = embaixo (padrão), 1 = esquerda, 2 = direita.
    in-out property <int> dock-position: 0;
    /// Estilo: 0 = dock flutuante centralizada, 1 = barra encostada na borda,
    /// ocupando a largura (ou altura) toda, como uma barra de tarefas.
    in-out property <int> dock-style: 0;
    /// Transparência do fundo da dock: 0 (opaca) a 0.8.
    in-out property <float> dock-transparency: 0;
    /// Ícones da dock: 0 = planos, 1 = 3D (ladrilho em relevo, sombra e
    /// sobem com o mouse), 2 = ladrilho na cor de cada app.
    in-out property <int> dock-icon-style: 0;
    /// Transparência dos ícones da dock: 0 (opacos) a 0.6; com o mouse em
    /// cima, o ícone fica opaco.
    in-out property <float> dock-icon-transparency: 0;
    /// Cantos da dock e dos ladrilhos: 0 = retos, 1 = arredondados (padrão),
    /// 2 = pílula (dock com pontas redondas e ladrilhos circulares).
    in-out property <int> dock-corners: 1;
    /// Tema de ícones: 0 = Flat Remix, 1 = Colloid, 2 = Fluent (as pastas
    /// seguem a cor de destaque nos três).
    in-out property <int> icon-theme: 0;
    out property <[string]> icon-theme-names: ["Flat Remix", "Colloid", "Fluent"];
    /// Papel de parede: 0 = circuitos (desenho do próprio shell); 1 em diante,
    /// as imagens de `wallpaper-names` (arquivos em src/shell/wallpaper.rs).
    in-out property <int> wallpaper: 1;
    /// Imagem própria (`wallpaper` = 8): a cópia reduzida que o Rust gravou.
    in-out property <string> wallpaper-file: "";
    /// Botões das janelas: 0 padrão, 1 círculos, 2 arredondados, 3 destaque,
    /// 4 retangulares (`src/settings/window_buttons.rs`).
    in-out property <int> window-buttons: 0;
    out property <[string]> wallpaper-names: [@tr("Circuits"), @tr("Black and blue"), @tr("Black"), @tr("Blue"), @tr("Green"), @tr("Purple"), @tr("Orange"), @tr("White")];
    /// Ids dos apps da dock, separados por vírgula, na ordem exibida
    /// (Configurações fica sempre no fim, depois do separador).
    in-out property <string> dock-apps: "files,terminal,browser,code,store";

    // ---------------------------------------------------------------
    // Paleta
    // ---------------------------------------------------------------

    /// As 6 cores de destaque, na mesma ordem dos wallpapers
    /// (ciano, roxo, azul, verde, âmbar, rosa).
    out property <[color]> accents: [#3dd6f5, #a78bfa, #7ea6f7, #5fd38d, #e8b04b, #f28b95];
    out property <[string]> accent-names: [@tr("Cyan"), @tr("Purple"), @tr("Blue"), @tr("Green"), @tr("Amber"), @tr("Pink")];

    out property <bool> is-light: mode == ThemeMode.light;
    out property <bool> is-oled: mode == ThemeMode.oled;

    /// Destaque efetivo. No tema claro escurece para manter contraste no fundo branco.
    out property <color> accent: is-light ? accents[accent-index].darker(0.45) : accents[accent-index];
    /// Texto/ícone desenhado sobre um preenchimento de destaque.
    out property <color> on-accent: #07090d;
    /// Destaque suave para fundos de item selecionado.
    out property <color> accent-soft: accent.with-alpha(0.14);
    /// Linhas de circuito do fundo.
    out property <color> circuit: accent.with-alpha(is-light ? 0.30 : 0.35);

    out property <color> background: is-light ? #eef1f4 : is-oled ? #000000 : #07090d;
    out property <color> grid: is-light ? #0000000a : #ffffff07;
    /// Cor sólida de painel/janela antes da transparência.
    out property <color> panel-solid: is-light ? #ffffff : is-oled ? #050505 : #0d1218;
    /// Painel efetivo: só o modo vidro deixa o fundo aparecer.
    out property <color> panel: mode == ThemeMode.glass ? panel-solid.with-alpha(1.0 - transparency * 0.15) : panel-solid;
    /// Barra superior.
    out property <color> bar: is-light ? #f7f9fb : is-oled ? #000000 : #07090de6;
    out property <color> tile: is-light ? #e9edf1 : is-oled ? #111111 : #131920;
    out property <color> tile-hover: is-light ? #dde3e9 : is-oled ? #1c1c1c : #1a222b;
    /// Fundo de campos de texto e áreas "afundadas" (terminal, caminho).
    out property <color> sunken: is-light ? #f3f5f8 : is-oled ? #000000 : #070b0f;
    out property <color> border: is-light ? #d4dbe2 : is-oled ? #1f1f1f : #1e2a33;
    out property <color> text: is-light ? #12181f : #e6edf3;
    out property <color> text-muted: is-light ? #5b6773 : #8b98a5;
    out property <color> danger: #f07178;
    out property <color> warning: #e8b04b;
    out property <color> success: #5fd38d;

    // ---------------------------------------------------------------
    // Tipografia (fontes embutidas em ui/fonts, importadas em app_window.slint)
    // ---------------------------------------------------------------

    out property <string> sans: "Inter";
    out property <string> mono: "JetBrains Mono";

    // ---------------------------------------------------------------
    // Medidas (px lógicos, referência 1440×900)
    // ---------------------------------------------------------------

    out property <length> bar-height: 35px;
    out property <length> radius: 12px;
    out property <length> radius-small: 8px;
    /// Lado do botão de app da dock (`dock-size`).
    out property <length> dock-item: clamp(dock-size, 16, 72) * 1px;
    /// Espessura da dock (o botão mais o respiro dos dois lados).
    out property <length> dock-thickness: dock-item + (dock-style == 1 ? 12px : 18px);
    /// Lado do ícone dentro do botão da dock.
    /// (Proporção dos tamanhos antigos: 44 → 20, 52 → 24, 60 → 28.)
    out property <length> dock-icon: max(12px, round(clamp(dock-size, 16, 72) * 6 / 13) * 1px);
    /// Raio do ladrilho de cada app da dock (`dock-corners`).
    out property <length> dock-item-radius: dock-corners == 0 ? 4px : dock-corners == 2 ? dock-item / 2 : dock-item * 0.21;

    /// Duração padrão das transições; zero quando "Reduzir animações" está ligado.
    out property <duration> anim: reduce-motion ? 0ms : 180ms;
}
