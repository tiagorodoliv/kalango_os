// Dock: apps da dock | Configurações. Fica embaixo, à esquerda ou à direita
// (`Theme.dock-position`), flutuante e centralizada ou como barra encostada
// na borda (`Theme.dock-style`). Os itens são posicionados pelo índice, assim
// o mesmo componente serve na horizontal e na vertical.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Apps, AppEntry, Shell } from "../globals.slint";
import { AppIcon } from "app_icon.slint";

/// Um item da dock (tile quadrado com ícone colorido; o lado vem de
/// `Theme.dock-item`, ajustável em Configurações → Barra de tarefas).
component DockItem inherits Rectangle {
    in property <AppEntry> app;
    /// App com janela aberta: ponto embaixo.
    in property <bool> running: false;
    /// App em foco: traço de destaque embaixo (mais forte que `running`).
    in property <bool> active: false;
    /// Borda da dock (mesmos valores de `Theme.dock-position`): o indicador
    /// fica do lado de dentro da tela.
    in property <int> edge: 0;
    callback clicked();
    /// Botão direito (menu do app).
    callback menu();

    width: Theme.dock-item;
    height: Theme.dock-item;

    // Ladrilho e ícone no estilo escolhido (o mesmo do menu de apps); sem a
    // transparência escolhida quando o mouse está em cima.
    AppIcon {
        app: root.app;
        hovered: touch.has-hover;
        radius: Theme.dock-item-radius;
        glyph: Theme.dock-icon;
        icon-opacity: touch.has-hover ? 1 : 1 - Theme.dock-icon-transparency;
    }

    // Indicador: traço quando ativo, ponto quando só aberto.
    if root.active || root.running: Rectangle {
        // Embaixo: traço horizontal sob o ícone; nas laterais, vertical e
        // encostado no lado de fora.
        x: root.edge == 1 ? 1px : root.edge == 2 ? parent.width - self.width - 1px : (parent.width - self.width) / 2;
        y: root.edge == 0 ? parent.height - 6px : (parent.height - self.height) / 2;
        width: root.edge == 0 ? (root.active ? 14px : 4px) : (root.active ? 3px : 4px);
        height: root.edge == 0 ? (root.active ? 3px : 4px) : (root.active ? 14px : 4px);
        border-radius: 2px;
        background: root.active ? Theme.accent : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                root.menu();
            }
        }
    }
}

export component Dock inherits Rectangle {
    /// Ids de apps com janela aberta e do app em foco.
    in property <bool> files-open;
    in property <bool> terminal-open;
    in property <string> focused-app;
    /// Estilo barra: comprimento da borda da tela (largura ou altura).
    in property <length> bar-length;
    /// Sem cantos arredondados (dock em janela própria: a janela não tem
    /// transparência, e os cantos ficariam pretos).
    in property <bool> square: false;
    /// Sombra em volta da dock. Desligada na dock em janela própria: a janela
    /// tem o tamanho exato da dock, a sombra era cortada na borda dela e só
    /// aparecia nos cantos, fora do arredondamento (a "sobra" nos cantos).
    in property <bool> shadow: true;
    callback launch(string);
    /// Botão direito num app: id e centro do item ao longo da dock.
    callback menu(string, length);

    property <bool> vertical: Theme.dock-position != 0;
    property <bool> bar: Theme.dock-style == 1;
    property <length> pad: (Theme.dock-thickness - Theme.dock-item) / 2;
    property <length> step: Theme.dock-item + 8px;
    /// Apps fixados + apps abertos que não estão fixados.
    property <int> count: Apps.dock.length + Shell.running-extra.length;
    /// Botão do menu de programas (`Theme.dock-apps-button`): visível e se
    /// fica no começo (os outros itens andam um passo) ou no fim.
    property <bool> apps-button: Theme.dock-apps-button != 2;
    property <bool> apps-first: Theme.dock-apps-button == 0;
    property <length> lead: root.apps-first ? root.step : 0;
    /// Comprimento dos itens: [botão], apps, separador, Configurações
    /// [, Lixeira] [, botão]. Mesma conta de `geometry` em src/shell/dock.rs.
    property <length> run: root.count * root.step + 17px + Theme.dock-item + (Theme.dock-trash ? root.step : 0)
        + (root.apps-button ? root.step : 0);
    /// Posição das Configurações ao longo da dock.
    property <length> settings-at: root.start + root.lead + root.count * root.step + 17px;
    property <length> along: root.bar ? root.bar-length : root.run + 2 * root.pad;
    /// Onde o primeiro item começa (na barra, os itens ficam centralizados).
    property <length> start: root.bar ? (root.bar-length - root.run) / 2 : root.pad;

    width: root.vertical ? Theme.dock-thickness : root.along;
    height: root.vertical ? root.along : Theme.dock-thickness;
    // Encostada na borda: só os cantos do lado de dentro são arredondados;
    // solta da borda (`Theme.dock-gap`), os quatro.
    // Cantos (`Theme.dock-corners`): retos, arredondados ou pílula.
    property <length> r: root.bar || root.square || Theme.dock-corners == 0 ? 0
        : Theme.dock-corners == 2 ? Theme.dock-thickness / 2 : 14px;
    property <bool> detached: Theme.dock-gap > 0;
    border-top-left-radius: Theme.dock-position == 1 && !root.detached ? 0 : root.r;
    border-top-right-radius: Theme.dock-position == 2 && !root.detached ? 0 : root.r;
    border-bottom-left-radius: Theme.dock-position == 2 || root.detached ? root.r : 0;
    border-bottom-right-radius: Theme.dock-position == 1 || root.detached ? root.r : 0;
    // Transparência escolhida em Configurações → Barra de tarefas.
    background: (root.bar ? Theme.bar : Theme.panel).with-alpha(1 - Theme.dock-transparency);
    border-width: root.bar ? 0 : 1px;
    border-color: Theme.border;
    drop-shadow-blur: root.bar || !root.shadow ? 0 : 24px;
    drop-shadow-color: #00000070;

    // Barra: linha na borda virada para dentro da tela.
    if root.bar: Rectangle {
        x: Theme.dock-position == 1 ? root.width - 1px : 0;
        y: 0;
        width: root.vertical ? 1px : root.width;
        height: root.vertical ? root.height : 1px;
        background: Theme.border;
    }

    for app[i] in Apps.dock: DockItem {
        x: root.vertical ? root.pad : root.start + root.lead + i * root.step;
        y: root.vertical ? root.start + root.lead + i * root.step : root.pad;
        app: app;
        edge: Theme.dock-position;
        // Sessão real: janelas abertas de verdade (`src/shell/taskbar.rs`).
        // Protótipo: janelas de demonstração.
        running: Shell.native
            ? Shell.dock-has(Shell.running-ids, app.id)
            : (app.id == "files" && root.files-open) || (app.id == "terminal" && root.terminal-open);
        active: Shell.native ? app.id == Shell.active-app : app.id == root.focused-app && self.running;
        clicked => { root.launch(app.id); }
        menu => { root.menu(app.id, root.start + root.lead + i * root.step + Theme.dock-item / 2); }
    }

    // Apps abertos que não estão fixados (VS Code, GIMP...).
    for app[j] in Shell.running-extra: DockItem {
        x: root.vertical ? root.pad : root.start + root.lead + (Apps.dock.length + j) * root.step;
        y: root.vertical ? root.start + root.lead + (Apps.dock.length + j) * root.step : root.pad;
        app: app;
        edge: Theme.dock-position;
        running: true;
        active: app.id == Shell.active-app;
        clicked => { root.launch(app.id); }
        menu => { root.menu(app.id, root.start + root.lead + (Apps.dock.length + j) * root.step + Theme.dock-item / 2); }
    }

    // Separador antes de Configurações
    Rectangle {
        x: root.vertical ? (root.width - self.width) / 2 : root.settings-at - 13px;
        y: root.vertical ? root.settings-at - 13px : (root.height - self.height) / 2;
        width: root.vertical ? Theme.dock-item * 0.62 : 1px;
        height: root.vertical ? 1px : Theme.dock-item * 0.62;
        background: Theme.border;
    }

    DockItem {
        x: root.vertical ? root.pad : root.settings-at;
        y: root.vertical ? root.settings-at : root.pad;
        app: Apps.pinned[5];
        edge: Theme.dock-position;
        running: Shell.native && Shell.dock-has(Shell.running-ids, "settings");
        active: Shell.native && Shell.active-app == "settings";
        clicked => { root.launch("settings"); }
        menu => { root.menu("settings", root.settings-at + Theme.dock-item / 2); }
    }

    // Lixeira (como a do Ubuntu): cheia ou vazia; clique abre no Thunar e o
    // botão direito tem "Esvaziar lixeira" (src/shell/trash.rs).
    property <bool> trash-themed: Shell.trash-icon.width > 0;
    if Theme.dock-trash: DockItem {
        x: root.vertical ? root.pad : root.settings-at + root.step;
        y: root.vertical ? root.settings-at + root.step : root.pad;
        app: {
            id: "trash",
            name: @tr("Trash"),
            icon: !root.trash-themed ? Icons.trash : Shell.trash-full && Shell.trash-icon-full.width > 0 ? Shell.trash-icon-full : Shell.trash-icon,
            tint: root.trash-themed ? transparent : Theme.text,
        };
        edge: Theme.dock-position;
        clicked => { root.launch("trash"); }
        menu => { root.menu("trash", root.settings-at + root.step + Theme.dock-item / 2); }
    }

    // Menu de programas (grade de 9 pontos, como o "Mostrar aplicativos" do
    // Ubuntu): no começo ou depois das Configurações. Abre/fecha o menu de
    // apps (`dock-launch` trata o id "apps-menu"); não tem menu de contexto.
    if root.apps-button: DockItem {
        property <length> at: root.apps-first ? root.start : root.settings-at + root.step * (Theme.dock-trash ? 2 : 1);
        x: root.vertical ? root.pad : self.at;
        y: root.vertical ? self.at : root.pad;
        app: { id: "apps-menu", name: @tr("Show apps"), icon: Icons.grid, tint: Theme.text };
        edge: Theme.dock-position;
        clicked => { root.launch("apps-menu"); }
    }
}
