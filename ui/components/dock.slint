// Dock inferior centralizada: apps da dock | Configurações.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Apps, AppEntry, Shell } from "../globals.slint";

/// Um item da dock (tile quadrado com ícone colorido; o lado vem de
/// `Theme.dock-item`, ajustável em Configurações → Barra de tarefas).
component DockItem inherits Rectangle {
    in property <AppEntry> app;
    /// App com janela aberta: ponto embaixo.
    in property <bool> running: false;
    /// App em foco: traço de destaque embaixo (mais forte que `running`).
    in property <bool> active: false;
    callback clicked();

    /// Ícone colorido do tema de ícones (sessão real): desenhado grande e sem
    /// colorir, sem o quadradinho de fundo (só aparece ao passar o mouse).
    property <bool> own-icon: root.app.tint == transparent;

    width: Theme.dock-item;
    height: Theme.dock-item;
    border-radius: Theme.dock-item * 0.21;
    background: touch.has-hover ? Theme.tile-hover : root.own-icon ? transparent : Theme.tile;
    animate background { duration: Theme.anim; }

    Image {
        source: root.app.icon;
        colorize: root.own-icon ? transparent : root.app.id == "files" ? Theme.accent : root.app.tint;
        width: root.own-icon ? Theme.dock-item * 0.82 : Theme.dock-icon;
        height: self.width;
    }

    // Indicador: traço quando ativo, ponto quando só aberto.
    if root.active || root.running: Rectangle {
        y: parent.height - 6px;
        width: root.active ? 14px : 4px;
        height: root.active ? 3px : 4px;
        border-radius: 2px;
        background: root.active ? Theme.accent : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Dock inherits Rectangle {
    /// Ids de apps com janela aberta e do app em foco.
    in property <bool> files-open;
    in property <bool> terminal-open;
    in property <string> focused-app;
    callback launch(string);

    width: row.preferred-width;
    height: row.preferred-height;
    border-radius: 14px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000070;

    row := HorizontalLayout {
        padding: 9px;
        spacing: 8px;

        for app in Apps.dock: DockItem {
            app: app;
            // Sessão real: apps abertos de verdade (o shell não sabe qual está
            // em foco, então só mostra o ponto). Protótipo: janelas de demonstração.
            running: Shell.native
                ? (app.id == "files" && Shell.files-running) || (app.id == "terminal" && Shell.terminal-running)
                  || (app.id == "browser" && Shell.browser-running) || (app.id == "code" && Shell.code-running)
                : (app.id == "files" && root.files-open) || (app.id == "terminal" && root.terminal-open);
            active: !Shell.native && app.id == root.focused-app && self.running;
            clicked => { root.launch(app.id); }
        }

        // Separador antes de Configurações
        Rectangle {
            width: 9px;
            Rectangle {
                width: 1px;
                height: Theme.dock-item * 0.62;
                background: Theme.border;
            }
        }

        DockItem {
            app: Apps.pinned[5];
            clicked => { root.launch("settings"); }
        }
    }
}
