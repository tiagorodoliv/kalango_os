// Barra superior da área de trabalho: pílula "K"alango (abre o launcher),
// indicador de workspaces, data/hora central e indicadores de sistema.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Shell } from "../globals.slint";
import { KalangoIcon } from "../brand.slint";
import { BatteryIcon } from "battery_icon.slint";

/// Ícone de status centralizado verticalmente na barra.
component BarIcon inherits Rectangle {
    in property <image> icon;
    in property <length> size: 15px;
    in property <color> tint: Theme.text;
    width: root.size;
    Image {
        source: root.icon;
        colorize: root.tint;
        width: root.size;
        height: root.size;
    }
}

export component TopBar inherits Rectangle {
    /// Launcher aberto: a pílula fica preenchida com o destaque.
    in property <bool> launcher-open: false;
    /// Esconde workspaces e indicadores (como no layout do launcher/configurações).
    in property <bool> compact: false;
    /// Aviso temporário no lugar da data (sessão real: a barra é a única
    /// parte do shell que nunca fica atrás das janelas dos apps).
    in property <string> message;
    callback pill-clicked();
    /// Painel rápido aberto: o bloco de status fica destacado.
    in property <bool> quick-open: false;
    /// Clique no bloco de status (Wi-Fi, volume, bateria, energia): abre o
    /// painel rápido (`ui/screens/quick_settings.slint`).
    callback status-clicked();
    /// Clique no relógio: abre o calendário.
    callback clock-clicked();
    /// Largura da área clicável do relógio.
    property <length> clock-text-w: 220px;

    height: Theme.bar-height;
    background: Theme.bar;

    // Linha inferior
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    // --- Esquerda: pílula + workspaces ---
    pill := Rectangle {
        x: 12px;
        y: 3px;
        width: pill-row.preferred-width + 4px;
        height: parent.height - 7px;
        border-radius: 7px;
        background: root.launcher-open ? Theme.accent : pill-touch.has-hover ? Theme.tile-hover : Theme.tile;
        border-width: 1px;
        border-color: root.launcher-open ? Theme.accent : Theme.accent.with-alpha(0.35);
        animate background { duration: Theme.anim; }

        pill-row := HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            spacing: 1px;
            alignment: center;
            // O ícone do K faz a primeira letra: "K" + "alango" = Kalango.
            Rectangle {
                width: 20px;
                KalangoIcon { width: 20px; height: 20px; }
            }
            Text {
                text: "alango";
                vertical-alignment: center;
                color: root.launcher-open ? Theme.on-accent : Theme.text;
                font-family: Theme.sans;
                font-size: 14px;
                font-weight: 600;
            }
        }

        pill-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.pill-clicked(); }
        }
    }

    // Áreas de trabalho: a ativa = barra em destaque, as outras = pontos.
    // Clicar troca (cada item tem uma área de clique maior que o desenho).
    if !root.compact && Shell.workspace-count > 1: HorizontalLayout {
        x: pill.x + pill.width + 9px;
        height: parent.height;
        spacing: 0;
        for i in Shell.workspace-count: Rectangle {
            property <bool> active: i == Shell.workspace-active;
            width: (self.active ? 22px : 5px) + 10px;
            animate width { duration: Theme.anim; }
            Rectangle {
                width: parent.active ? 22px : 5px;
                height: 4px;
                border-radius: 2px;
                background: parent.active ? Theme.accent
                    : ws-touch.has-hover ? Theme.text : Theme.text-muted.with-alpha(0.6);
                animate width { duration: Theme.anim; }
            }
            ws-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { Shell.switch-workspace(i); }
            }
        }
    }

    // --- Centro: data e hora (clique abre o calendário) ---
    clock := Text {
        // Por cima do destaque de quando o mouse passa.
        z: 1;
        text: root.message != "" ? root.message
            : (Theme.bar-show-date ? Shell.bar-day + " " : "") + Shell.bar-time
              + (Theme.bar-show-seconds ? ":" + Shell.bar-seconds : "");
        color: root.message != "" ? Theme.accent : Theme.text;
        font-family: Theme.mono;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: clock-text-w;
        height: parent.height - 8px;
        border-radius: 8px;
        background: clock-touch.has-hover && root.message == "" ? Theme.tile-hover.with-alpha(0.6) : transparent;
        clock-touch := TouchArea {
            enabled: root.message == "";
            mouse-cursor: pointer;
            clicked => { root.clock-clicked(); }
        }
    }

    // --- Direita: CPU e o bloco de status (abre o painel rápido) ---
    if !root.compact: HorizontalLayout {
        // Largura explícita: sem ela o layout ocupa a barra inteira e, com o
        // deslocamento em x, os itens ficam fora da tela.
        width: self.preferred-width;
        x: parent.width - self.width - 6px;
        height: parent.height;
        spacing: 8px;
        alignment: end;

        if Theme.bar-show-cpu: Text {
            text: "CPU " + Shell.cpu;
            vertical-alignment: center;
            color: Theme.text-muted;
            font-family: Theme.mono;
            font-size: 12px;
        }
        Rectangle {
            y: 3px;
            height: parent.height - 7px;
            width: status-row.preferred-width;
            border-radius: 7px;
            background: root.quick-open ? Theme.accent.with-alpha(0.22)
                : status-touch.has-hover ? Theme.tile-hover : transparent;
            animate background { duration: Theme.anim; }

            status-row := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 12px;
                property <color> fg: root.quick-open ? Theme.accent : Theme.text;
                BarIcon { icon: Icons.wifi; tint: status-row.fg; }
                BarIcon { icon: Icons.volume; tint: status-row.fg; }
                // Sem bateria (desktop, VM) o Rust manda "--": o indicador some.
                if Theme.bar-show-battery && Shell.battery != "--": HorizontalLayout {
                    spacing: 4px;
                    BatteryIcon {
                        y: (parent.height - self.height) / 2;
                        level: Shell.battery-level;
                        charging: Shell.battery-charging;
                        tint: status-row.fg;
                    }
                    Text {
                        text: Shell.battery;
                        vertical-alignment: center;
                        color: status-row.fg;
                        font-family: Theme.mono;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }
                BarIcon { icon: Icons.power; tint: status-row.fg; }
            }
            status-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.status-clicked(); }
            }
        }
    }
}
