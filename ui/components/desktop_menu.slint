// Menu do botão direito na área de trabalho: atalhos para o papel de parede,
// a dock, os monitores e os apps mais usados.

import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

/// Um item do menu (ícone de traço + texto).
component MenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    callback clicked();

    height: 34px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.accent-soft : transparent;

    Image {
        x: 10px;
        source: root.icon;
        colorize: touch.has-hover ? Theme.accent : Theme.text-muted;
        width: 16px;
        height: 16px;
    }
    Text {
        x: 36px;
        text: root.text;
        color: Theme.text;
        font-family: Theme.sans;
        font-size: 13.5px;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Linha divisória entre grupos de itens.
component MenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
}

/// O conteúdo do menu (o `PopupWindow` fica em app_window.slint).
export component DesktopMenu inherits Rectangle {
    /// Abre as Configurações numa página (2 = Aparência, 3 = Barra de
    /// tarefas, 4 = Monitores).
    callback settings(int);
    /// Abre um app do catálogo ("terminal", "files", "settings").
    callback launch(string);

    width: 236px;
    height: col.preferred-height;
    border-radius: Theme.radius-small + 2px;
    background: Theme.panel-solid;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 22px;
    drop-shadow-color: #00000090;

    // Segura os cliques no fundo do menu (fora dos itens) para não fechá-lo.
    TouchArea { }

    col := VerticalLayout {
        padding: 5px;
        MenuItem { icon: Icons.image; text: @tr("Change wallpaper"); clicked => { root.settings(2); } }
        MenuItem { icon: Icons.dock; text: @tr("Adjust the dock"); clicked => { root.settings(3); } }
        MenuItem { icon: Icons.monitor; text: @tr("Displays"); clicked => { root.settings(4); } }
        MenuSeparator { }
        MenuItem { icon: Icons.terminal; text: @tr("Open terminal"); clicked => { root.launch("terminal"); } }
        MenuItem { icon: Icons.folder; text: @tr("Open Files"); clicked => { root.launch("files"); } }
        MenuSeparator { }
        MenuItem { icon: Icons.settings; text: @tr("Settings"); clicked => { root.launch("settings"); } }
    }
}

/// Fundo que abre o [`DesktopMenu`] com o botão direito, onde se clicou.
/// Usado na área de trabalho e no papel de parede dos outros monitores
/// (`--fundo=`). Desenhado dentro da própria janela (e não como
/// PopupWindow): a janela é tela cheia sempre atrás das outras, e o labwc não
/// entrega os cliques a um popup dela.
export component DesktopMenuArea inherits Rectangle {
    callback settings(int);
    callback launch(string);
    /// Menu aberto (a área de trabalho põe a camada por cima das janelas
    /// de demonstração só enquanto ele está aberto).
    out property <bool> open: false;
    property <length> menu-x;
    property <length> menu-y;

    TouchArea {
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                root.open = true;
            }
        }
    }
    if root.open: TouchArea {
        // Clique fora do menu (qualquer botão) fecha.
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.open = false;
            }
        }
        DesktopMenu {
            // Sem passar da borda da tela.
            x: min(root.menu-x, parent.width - self.width - 8px);
            y: min(root.menu-y, parent.height - self.height - 8px);
            settings(page) => {
                root.open = false;
                root.settings(page);
            }
            launch(id) => {
                root.open = false;
                root.launch(id);
            }
        }
    }
}
