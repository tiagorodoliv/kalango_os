// Barra de status no topo da tela (nome do sistema + relógio).
// Placeholder: será refeita conforme o layout definitivo.

import { Theme } from "../theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> title: "Linux OS";
    in property <string> clock: "--:--";

    height: Theme.status-bar-height;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: Theme.spacing;
        padding-right: Theme.spacing;

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }

        Rectangle { } // espaçador flexível

        Text {
            text: root.clock;
            color: Theme.text;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }
    }
}
