// Estado real do computador mostrado nas Configurações (rede, som, energia,
// sobre o sistema). Preenchido pelo Rust em `src/device.rs`, que conversa com
// o NetworkManager (`nmcli`), o PipeWire (`wpctl`) e o systemd.
//
// Os valores padrão abaixo são os do protótipo (desenvolvimento e capturas).

/// Uma linha "rótulo: valor" (Sobre o sistema).
export struct InfoItem {
    label: string,
    value: string,
}

/// Uma rede Wi-Fi encontrada.
export struct WifiNetwork {
    ssid: string,
    /// Força do sinal, 0–100.
    signal: int,
    /// Pede senha (WPA/WEP).
    secure: bool,
    /// É a rede conectada agora.
    active: bool,
    /// Tem perfil salvo no NetworkManager (dá para esquecer).
    saved: bool,
}

/// Uma resolução de um monitor, com as taxas de atualização disponíveis.
export struct DisplayResolution {
    /// "1920 × 1080" (com "(recomendada)" na preferida do monitor).
    label: string,
    width: int,
    height: int,
    /// "60 Hz", "59,94 Hz"... da maior para a menor.
    rates: [string],
}

/// Um monitor (saída de vídeo) e a configuração atual dele.
export struct DisplayOutput {
    /// Conector ("HDMI-A-1").
    name: string,
    /// Nome para exibir ("Dell Inc. DELL P2419H (HDMI-A-1)").
    label: string,
    enabled: bool,
    resolutions: [DisplayResolution],
    /// Os rótulos de `resolutions` (para a lista suspensa).
    resolution-labels: [string],
    /// Índices atuais em `resolutions`, em `resolutions[i].rates`, em
    /// `Device.display-scales` e em `Device.display-rotations`.
    resolution: int,
    rate: int,
    scale: int,
    rotation: int,
}

/// Uma pasta que pode ser compartilhada (Configurações → Compartilhamento).
export struct SharedFolder {
    /// Nome da pasta ("Public", "Documents"...).
    name: string,
    path: string,
    shared: bool,
}

/// Uma conexão de rede salva (cabo ou Wi-Fi), para o IP fixo.
export struct NetConnection {
    name: string,
    /// "wifi" ou "ethernet".
    kind: string,
    active: bool,
}

/// Uma VPN salva no NetworkManager.
export struct VpnConnection {
    name: string,
    /// "OpenVPN" ou "WireGuard".
    kind: string,
    active: bool,
}

/// Um aparelho Bluetooth (`src/bluetooth.rs`).
export struct BtDevice {
    /// Endereço ("AA:BB:CC:DD:EE:FF").
    mac: string,
    name: string,
    /// "audio", "input", "phone", "computer" ou "other".
    kind: string,
    paired: bool,
    connected: bool,
}

/// Um computador da rede local com pastas compartilhadas (achado pelo Avahi).
export struct NetComputer {
    name: string,
    /// Nome na rede ("kalango.local") ou endereço.
    host: string,
}

export global Device {
    // --- Sobre o sistema ---

    /// Ficha do sistema: versão, base, kernel, processador, memória, disco...
    in property <[InfoItem]> about: [
        { label: @tr("Version"), value: @tr("Kalango OS 0.1 (prototype)") },
        { label: "Base", value: "Debian 13 \"trixie\"" },
        { label: @tr("Session"), value: "Wayland" },
    ];

    // --- Rede (NetworkManager) ---

    /// O NetworkManager respondeu (`nmcli` existe e o serviço está rodando).
    in property <bool> network-available: false;
    /// Resumo da conexão atual ("Conectado por cabo", "Conectado a Casa"...).
    in property <string> network-status: @tr("No network information");
    /// Existe uma placa Wi-Fi.
    in property <bool> wifi-present: false;
    /// Rádio Wi-Fi ligado.
    in-out property <bool> wifi-enabled: false;
    /// Redes encontradas, da mais forte para a mais fraca (no máximo 8).
    in property <[WifiNetwork]> networks;
    /// Nome da rede Wi-Fi conectada ("" sem conexão).
    in property <string> wifi-name: "";
    /// Conectando ou procurando redes.
    in property <bool> network-busy: false;
    /// Resultado da última ação ("Conectado a Casa", "Senha incorreta"...).
    in-out property <string> network-message: "";

    // --- IP fixo e VPN (`src/netconfig.rs`) ---
    /// Conexões salvas de cabo e Wi-Fi.
    in property <[NetConnection]> connections: [];
    /// Conexão com o editor de IP aberto ("" = nenhum).
    in-out property <string> ip-for: "";
    in-out property <bool> ip-manual: false;
    in-out property <string> ip-address: "";
    /// Máscara ("255.255.255.0") ou prefixo ("24").
    in-out property <string> ip-mask: "";
    in-out property <string> ip-gateway: "";
    /// Servidores DNS separados por vírgula.
    in-out property <string> ip-dns: "";
    /// Endereço em uso agora ("192.168.1.175/24").
    in property <string> ip-current: "";
    in-out property <string> ip-message: "";
    /// Abre o editor de IP de uma conexão (o Rust lê os valores atuais).
    callback ip-edit(string /* conexão */);
    /// Salva: conexão, manual, endereço, máscara, gateway, DNS.
    callback ip-apply(string, bool, string, string, string, string);

    /// Há NetworkManager (sessão real) para as VPNs.
    in property <bool> vpn-available: false;
    /// O plugin do OpenVPN está instalado.
    in property <bool> openvpn-available: false;
    in property <[VpnConnection]> vpns: [];
    /// VPN ligando/desligando ("" = nenhuma).
    in property <string> vpn-busy: "";
    in-out property <string> vpn-message: "";
    /// Formulário aberto: 0 = nenhum, 1 = OpenVPN, 2 = WireGuard.
    in-out property <int> vpn-form: 0;
    /// VPN importada que pede usuário e senha ("" = nenhuma).
    in-out property <string> vpn-login-for: "";
    callback vpn-set(string /* nome */, bool /* ligar */);
    callback vpn-remove(string);
    /// Escolhe um arquivo .ovpn ou .conf (WireGuard) e importa.
    callback vpn-import();
    callback vpn-set-login(string /* nome */, string /* usuário */, string /* senha */);
    /// Nome, servidor, porta, TCP, autenticação (0 certificados, 1 senha,
    /// 2 senha + certificados), CA, certificado, chave, usuário, senha.
    callback vpn-add-openvpn(string, string, string, bool, int, string, string, string, string, string);
    /// Nome, endereço, chave privada, DNS, chave pública do servidor,
    /// servidor:porta, IPs permitidos.
    callback vpn-add-wireguard(string, string, string, string, string, string, string);
    /// Chaves do WireGuard do formulário (geradas ou digitadas).
    in-out property <string> wg-private-key: "";
    in-out property <string> wg-public-key: "";
    callback wg-generate-key();
    /// Calcula a chave pública de uma chave privada digitada.
    callback wg-public-of(string);
    /// Escolher arquivo (zenity): o caminho chega em `picked-path`, com o
    /// propósito pedido ("ca", "cert", "key") e `picked-serial` + 1.
    callback pick-file(string);
    in property <string> picked-purpose: "";
    in property <string> picked-path: "";
    in property <int> picked-serial: 0;

    /// Liga ou desliga o Wi-Fi.
    callback set-wifi(bool);
    /// Procura redes de novo.
    callback rescan();
    /// Conecta a uma rede (senha vazia para rede aberta ou já salva).
    callback connect-wifi(string /* ssid */, string /* senha */);
    /// Posição da rede `ssid` na lista (-1 se não está). A lista vai como
    /// argumento para a ligação ser refeita quando ela muda.
    /// Esquece uma rede salva (apaga o perfil; desconecta se for a atual).
    callback forget-wifi(string /* ssid */);
    pure callback network-index([WifiNetwork], string /* ssid */) -> int;

    // --- Som (PipeWire/WirePlumber) ---

    /// O `wpctl` respondeu e há uma saída de som.
    in property <bool> sound-available: false;
    /// Nome da saída padrão ("Alto-falantes internos"...).
    in property <string> sound-output: "";
    /// Volume da saída padrão, 0.0–1.0.
    in-out property <float> volume: 0.5;
    /// Saída sem som.
    in-out property <bool> muted: false;

    callback set-volume(float);
    callback set-muted(bool);

    // --- Brilho da tela (notebooks: /sys/class/backlight) ---

    /// Há uma tela com brilho ajustável (some no PC de mesa e na VM).
    in property <bool> brightness-available: false;
    /// Brilho, 0.0–1.0.
    in-out property <float> brightness: 1.0;
    callback set-brightness(float);

    // --- Energia e usuário ---

    /// Carga da bateria ("78%") ou "Sem bateria".
    in property <string> battery: @tr("No battery");
    /// Carregando (ligado na tomada).
    in property <bool> charging: false;
    /// Login do usuário (`$USER`).
    in property <string> login: "user";
    /// O usuário pode administrar o sistema (grupo `sudo`).
    in property <bool> admin: true;
    /// Existe um adaptador Bluetooth.
    in property <bool> bluetooth-present: false;

    // --- Bluetooth (BlueZ, `src/bluetooth.rs`) ---
    /// O BlueZ respondeu e há um controlador.
    in property <bool> bt-available: false;
    in-out property <bool> bt-powered: false;
    /// Pareados primeiro (conectados no topo), depois os encontrados.
    in property <[BtDevice]> bt-devices: [];
    /// Nome do aparelho conectado ("" = nenhum), para o painel rápido.
    in property <string> bt-connected: "";
    /// Procurando aparelhos.
    in property <bool> bt-scanning: false;
    /// Aparelho sendo pareado/conectado ("" = nenhum).
    in property <string> bt-busy-mac: "";
    /// Resultado da última ação ou o código de pareamento.
    in-out property <string> bt-message: "";
    callback set-bt(bool);
    callback bt-scan();
    /// Pareia (se `pareado` for falso), confia e conecta.
    callback bt-connect(string /* mac */, string /* nome */, bool /* pareado */);
    callback bt-disconnect(string /* mac */);
    callback bt-forget(string /* mac */);
    /// Quantos aparelhos pareados há no começo da lista.
    pure callback bt-paired-count([BtDevice]) -> int;

    /// "suspend" ou "reboot" (desligar usa `Shell.power-off`).
    callback power-action(string);
    /// Abre a troca de senha (`passwd` num terminal).
    callback change-password();

    // --- Monitores (wlr-randr, `src/displays.rs`) ---

    /// O `wlr-randr` respondeu e há pelo menos um monitor.
    in property <bool> displays-available: false;
    in property <[DisplayOutput]> displays: [];
    /// Escalas oferecidas (mesma ordem de `SCALES` no Rust).
    out property <[string]> display-scales: ["50%", "75%", "100%", "125%", "150%", "175%", "200%"];
    out property <[float]> display-scale-values: [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0];
    /// Rotações (mesma ordem de `TRANSFORMS` no Rust).
    out property <[string]> display-rotations: ["Normal", @tr("90° (portrait)"), @tr("180° (upside down)"), @tr("270° (portrait)")];
    /// Uma mudança foi aplicada e espera "Manter" (senão volta sozinha).
    in property <bool> display-confirm: false;
    /// Segundos até voltar à configuração anterior.
    in property <int> display-countdown: 0;
    /// Resultado da última ação ("Configuração do monitor salva.").
    in property <string> display-message: "";
    /// Aplica no monitor `índice`: resolução, taxa, escala, rotação e ligado.
    callback apply-display(int, int, int, int, int, bool);
    /// Confirma a mudança aplicada (grava em monitores.conf).
    callback keep-display();
    /// Volta à configuração anterior.
    callback revert-display();

    // --- Idioma e região (src/region.rs) ---
    /// Idiomas, cada um no próprio idioma ("English", "Português (Brasil)").
    in property <[string]> languages: ["English", "Português (Brasil)"];
    in property <int> language-index: 0;
    /// O idioma escolhido não é o da sessão: vale depois de sair e entrar.
    in property <bool> language-pending: false;
    in property <[string]> keyboard-layouts: [@tr("English (US)")];
    /// Layout atual (-1 = um que não está na lista).
    in property <int> keyboard-index: 0;
    in property <string> keyboard-message: "";
    callback set-language(int);

    // --- Compartilhamento (src/sharing.rs) ---
    /// Samba e o script de compartilhamento instalados (sessão real).
    in property <bool> sharing-available: false;
    in-out property <bool> sharing-enabled: false;
    /// Esperando a senha do administrador ou o Samba.
    in property <bool> sharing-busy: false;
    /// Visitantes entram sem senha (só leitura).
    in-out property <bool> sharing-guest: true;
    /// Nome do computador na rede ("kalango").
    in property <string> sharing-name: "kalango";
    in property <[SharedFolder]> sharing-folders: [
        { name: "Public", path: "~/Public", shared: true },
        { name: "Documents", path: "~/Documents", shared: false },
        { name: "Pictures", path: "~/Pictures", shared: false },
        { name: "Music", path: "~/Music", shared: false },
        { name: "Videos", path: "~/Videos", shared: false },
        { name: "Downloads", path: "~/Downloads", shared: false },
    ];
    in-out property <string> sharing-message: "";
    in property <[NetComputer]> computers: [];
    in property <bool> computers-busy: false;
    callback set-sharing(bool);
    callback set-sharing-guest(bool);
    callback toggle-shared-folder(int);
    callback sharing-password();
    callback refresh-computers();
    callback open-computer(int);
    callback browse-network();
    /// Abre um endereço digitado ("192.168.0.10", "\\\\pc\\pasta", "sftp://...").
    callback connect-server(string);
    callback set-keyboard(int);
}
