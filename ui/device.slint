// Estado real do computador mostrado nas Configurações (rede, som, energia,
// sobre o sistema). Preenchido pelo Rust em `src/settings/device.rs`, que conversa com
// o NetworkManager (`nmcli`), o PipeWire (`wpctl`) e o systemd.
//
// Os valores padrão abaixo são os do protótipo (desenvolvimento e capturas).

/// Uma linha "rótulo: valor" (Sobre o sistema).
export struct InfoItem {
    label: string,
    value: string,
}

/// Uma rede Wi-Fi encontrada.
export struct WifiNetwork {
    ssid: string,
    /// Força do sinal, 0–100.
    signal: int,
    /// Pede senha (WPA/WEP).
    secure: bool,
    /// É a rede conectada agora.
    active: bool,
    /// Tem perfil salvo no NetworkManager (dá para esquecer).
    saved: bool,
}

/// Uma resolução de um monitor, com as taxas de atualização disponíveis.
export struct DisplayResolution {
    /// "1920 × 1080" (com "(recomendada)" na preferida do monitor).
    label: string,
    width: int,
    height: int,
    /// "60 Hz", "59,94 Hz"... da maior para a menor.
    rates: [string],
}

/// Um monitor (saída de vídeo) e a configuração atual dele.
export struct DisplayOutput {
    /// Conector ("HDMI-A-1").
    name: string,
    /// Nome para exibir ("Dell Inc. DELL P2419H (HDMI-A-1)").
    label: string,
    enabled: bool,
    resolutions: [DisplayResolution],
    /// Os rótulos de `resolutions` (para a lista suspensa).
    resolution-labels: [string],
    /// Índices atuais em `resolutions`, em `resolutions[i].rates`, em
    /// `Device.display-scales` e em `Device.display-rotations`.
    resolution: int,
    rate: int,
    scale: int,
    rotation: int,
    /// Posição e tamanho no arranjo (px lógicos), para o desenho.
    x: int,
    y: int,
    width-px: int,
    height-px: int,
    /// Número do monitor (1, 2... da esquerda para a direita; 0 = desligado).
    number: int,
    /// Monitor principal (barra e dock).
    primary: bool,
}

/// Atalho de teclado (Configurações → Idioma e região).
export struct ShortcutItem {
    /// Id do atalho padrão ("terminal") ou, nos próprios, a tecla.
    id: string,
    name: string,
    /// Para mostrar: "Super + Enter".
    keys: string,
    /// Comando (só nos próprios).
    command: string,
    custom: bool,
    /// Atalho padrão com a tecla trocada.
    changed: bool,
}

/// Porta liberada no firewall (Configurações → Compartilhamento → Firewall).
export struct FirewallRule {
    /// Para mostrar: "8000 · TCP", "6000–6010 · UDP".
    port: string,
    /// Como o script a chama: "8000/tcp", "6000:6010/udp".
    key: string,
    /// Quem pediu ("Compartilhamento", "sshd", "python3") ou o nome dado.
    name: string,
    /// Só da rede local (senão, de qualquer endereço).
    local: bool,
    /// Ativa; desativada fica na lista, fora do firewall.
    enabled: bool,
}

/// Uma pasta que pode ser compartilhada (Configurações → Compartilhamento).
export struct SharedFolder {
    /// Nome da pasta ("Public", "Documents"...).
    name: string,
    path: string,
    shared: bool,
}

/// Uma conexão de rede salva (cabo ou Wi-Fi), para o IP fixo.
export struct NetConnection {
    name: string,
    /// "wifi" ou "ethernet".
    kind: string,
    active: bool,
}

/// Uma VPN salva no NetworkManager.
export struct VpnConnection {
    name: string,
    /// "OpenVPN" ou "WireGuard".
    kind: string,
    active: bool,
}

/// Um aparelho Bluetooth (`src/settings/bluetooth.rs`).
export struct BtDevice {
    /// Endereço ("AA:BB:CC:DD:EE:FF").
    mac: string,
    name: string,
    /// "audio", "input", "phone", "computer" ou "other".
    kind: string,
    paired: bool,
    connected: bool,
}

/// Uma saída ou entrada de som do PipeWire.
export struct SoundDevice {
    /// Id do nó no PipeWire.
    id: int,
    /// "HDMI · 25UM58G", "Áudio interno"...
    name: string,
    /// Saída pelo monitor/TV (HDMI ou DisplayPort).
    hdmi: bool,
    /// É a padrão agora.
    active: bool,
}

/// Um computador da rede local com pastas compartilhadas (achado pelo Avahi).
export struct NetComputer {
    name: string,
    /// Nome na rede ("kalango.local") ou endereço.
    host: string,
}

export global Device {
    // --- Sobre o sistema ---

    /// Ficha do sistema: versão, base, kernel, processador, memória, disco...
    in property <[InfoItem]> about: [
        { label: @tr("Version"), value: @tr("KalangOS 0.1 (prototype)") },
        { label: "Base", value: "Debian 13 \"trixie\"" },
        { label: @tr("Session"), value: "Wayland" },
    ];

    // --- Rede (NetworkManager) ---

    /// O NetworkManager respondeu (`nmcli` existe e o serviço está rodando).
    in property <bool> network-available: false;
    /// Resumo da conexão atual ("Conectado por cabo", "Conectado a Casa"...).
    in property <string> network-status: @tr("No network information");
    /// Existe uma placa Wi-Fi.
    in property <bool> wifi-present: false;
    /// Já leu o estado da rede (antes disso o painel não mostra nome nem estado).
    in property <bool> network-ready: false;
    /// Rádio Wi-Fi ligado.
    in-out property <bool> wifi-enabled: false;
    /// Redes encontradas, da mais forte para a mais fraca (no máximo 8).
    in property <[WifiNetwork]> networks;
    /// Nome da rede Wi-Fi conectada ("" sem conexão).
    in property <string> wifi-name: "";
    /// Existe uma placa de rede cabeada (gerenciada pelo NetworkManager).
    in property <bool> wired-present: false;
    /// O cabo está conectado, com conexão ativa.
    in property <bool> wired-connected: false;
    /// Sem cabo na placa.
    in property <bool> wired-unplugged: false;
    /// Conexão cabeada ativa ("Wired connection 1").
    in property <string> wired-name: "";
    /// Placa cabeada ("enp12s0").
    in property <string> wired-device: "";
    /// Liga/desliga a placa cabeada (bloco "Cabeada" do painel rápido).
    callback set-wired(bool);
    /// Ativa ou desativa uma conexão salva (cabo ou VPN) pelo nome.
    callback connection-set(string /* nome */, bool /* ligar */);
    /// Conectando ou procurando redes.
    in property <bool> network-busy: false;
    /// Resultado da última ação ("Conectado a Casa", "Senha incorreta"...).
    in-out property <string> network-message: "";

    // --- IP fixo e VPN (`src/settings/netconfig.rs`) ---
    /// Conexões salvas de cabo e Wi-Fi.
    in property <[NetConnection]> connections: [];
    /// Conexão com o editor de IP aberto ("" = nenhum).
    in-out property <string> ip-for: "";
    in-out property <bool> ip-manual: false;
    in-out property <string> ip-address: "";
    /// Máscara ("255.255.255.0") ou prefixo ("24").
    in-out property <string> ip-mask: "";
    in-out property <string> ip-gateway: "";
    /// Servidores DNS separados por vírgula.
    in-out property <string> ip-dns: "";
    /// Endereço em uso agora ("192.168.1.50/24").
    in property <string> ip-current: "";
    in-out property <string> ip-message: "";
    /// Abre os detalhes de uma conexão (o Rust lê os valores atuais).
    callback ip-edit(string /* conexão */);
    /// Salva: conexão, manual, endereço, máscara, gateway, DNS, conectar
    /// automaticamente, conexão limitada.
    callback ip-apply(string, bool, string, string, string, string, bool, bool);

    // Painel de detalhes da conexão (`ip-for`), como o "Detalhes" do Ubuntu.
    /// Sinal, velocidade, segurança, endereços, MAC... (só com a conexão ativa).
    in property <[InfoItem]> conn-details: [];
    /// "wifi" ou "ethernet".
    in property <string> conn-kind: "";
    /// A conexão está em uso agora.
    in property <bool> conn-active: false;
    /// Conectar sozinho quando a rede estiver por perto.
    in-out property <bool> conn-autoconnect: true;
    /// Conexão limitada (dados móveis, roteador do celular): o sistema evita
    /// baixar atualizações grandes sozinho.
    in-out property <bool> conn-metered: false;
    /// Wi-Fi com senha (WPA/WPA2/WPA3 pessoal).
    in property <bool> conn-secured: false;
    /// Senha revelada pelo botão "Mostrar" ("" = escondida).
    in-out property <string> conn-password: "";
    /// Lê a senha salva da rede e a mostra em `conn-password`.
    callback conn-show-password(string /* conexão */);
    /// Apaga a conexão salva (e desconecta, se estiver em uso).
    callback conn-forget(string /* conexão */);

    /// Há NetworkManager (sessão real) para as VPNs.
    in property <bool> vpn-available: false;
    /// O plugin do OpenVPN está instalado.
    in property <bool> openvpn-available: false;
    in property <[VpnConnection]> vpns: [];
    /// VPN ligada agora ("" = nenhuma), para o bloco do painel rápido.
    in property <string> vpn-active: "";
    /// VPN ligando/desligando ("" = nenhuma).
    in property <string> vpn-busy: "";
    in-out property <string> vpn-message: "";
    /// Formulário aberto: 0 = nenhum, 1 = OpenVPN, 2 = WireGuard.
    in-out property <int> vpn-form: 0;
    /// VPN importada que pede usuário e senha ("" = nenhuma).
    in-out property <string> vpn-login-for: "";
    callback vpn-set(string /* nome */, bool /* ligar */);
    callback vpn-remove(string);
    /// Escolhe um arquivo .ovpn ou .conf (WireGuard) e importa.
    callback vpn-import();
    callback vpn-set-login(string /* nome */, string /* usuário */, string /* senha */);
    /// Nome, servidor, porta, TCP, autenticação (0 certificados, 1 senha,
    /// 2 senha + certificados), CA, certificado, chave, usuário, senha.
    callback vpn-add-openvpn(string, string, string, bool, int, string, string, string, string, string);
    /// Nome, endereço, chave privada, DNS, chave pública do servidor,
    /// servidor:porta, IPs permitidos.
    callback vpn-add-wireguard(string, string, string, string, string, string, string);
    /// Chaves do WireGuard do formulário (geradas ou digitadas).
    in-out property <string> wg-private-key: "";
    in-out property <string> wg-public-key: "";
    callback wg-generate-key();
    /// Calcula a chave pública de uma chave privada digitada.
    callback wg-public-of(string);
    /// Escolher arquivo (zenity): o caminho chega em `picked-path`, com o
    /// propósito pedido ("ca", "cert", "key") e `picked-serial` + 1.
    callback pick-file(string);
    in property <string> picked-purpose: "";
    in property <string> picked-path: "";
    in property <int> picked-serial: 0;

    /// Liga ou desliga o Wi-Fi.
    callback set-wifi(bool);
    /// Procura redes de novo.
    callback rescan();
    /// Conecta a uma rede (senha vazia para rede aberta ou já salva).
    callback connect-wifi(string /* ssid */, string /* senha */);
    /// Conecta a uma rede oculta (que não anuncia o nome); senha vazia = aberta.
    callback connect-hidden(string /* ssid */, string /* senha */);
    /// Posição da rede `ssid` na lista (-1 se não está). A lista vai como
    /// argumento para a ligação ser refeita quando ela muda.
    /// Esquece uma rede salva (apaga o perfil; desconecta se for a atual).
    callback forget-wifi(string /* ssid */);
    pure callback network-index([WifiNetwork], string /* ssid */) -> int;

    // --- Som (PipeWire/WirePlumber) ---

    /// O `wpctl` respondeu e há uma saída de som.
    in property <bool> sound-available: false;
    /// Nome da saída padrão ("Alto-falantes internos"...).
    in property <string> sound-output: "";
    /// Volume da saída padrão, 0.0–1.0.
    in-out property <float> volume: 0.5;
    /// Saída sem som.
    in-out property <bool> muted: false;

    callback set-volume(float);
    callback set-muted(bool);

    /// Saídas de som (alto-falantes, fone, HDMI do monitor...) e os nomes
    /// delas na mesma ordem (para a lista suspensa); índice da padrão (-1).
    in property <[SoundDevice]> sound-outputs: [];
    in property <[string]> sound-output-names: [];
    in property <int> sound-output-index: -1;
    /// Entradas (microfones), do mesmo jeito.
    in property <[SoundDevice]> sound-inputs: [];
    in property <[string]> sound-input-names: [];
    in property <int> sound-input-index: -1;
    /// Torna padrão a saída ou entrada com esse id do PipeWire.
    callback set-sound-default(int /* id */);
    /// Teste de alto-falantes na saída padrão: "left", "right" ou "both".
    callback sound-test(string);

    /// Há uma entrada padrão (microfone).
    in property <bool> mic-available: false;
    in-out property <float> mic-volume: 0.5;
    in-out property <bool> mic-muted: false;
    callback set-mic-volume(float);
    callback set-mic-muted(bool);

    // --- Brilho da tela (notebooks: /sys/class/backlight) ---

    /// Há uma tela com brilho ajustável (some no PC de mesa e na VM).
    in property <bool> brightness-available: false;
    /// Brilho, 0.0–1.0.
    in-out property <float> brightness: 1.0;
    callback set-brightness(float);

    // --- Energia e usuário ---

    /// Carga da bateria ("78%") ou "Sem bateria".
    in property <string> battery: @tr("No battery");
    /// Carregando (ligado na tomada).
    in property <bool> charging: false;
    /// Login do usuário (`$USER`).
    in property <string> login: "user";
    /// O usuário pode administrar o sistema (grupo `sudo`).
    in property <bool> admin: true;
    /// Existe um adaptador Bluetooth.
    in property <bool> bluetooth-present: false;

    // --- Bluetooth (BlueZ, `src/settings/bluetooth.rs`) ---
    /// O BlueZ respondeu e há um controlador.
    in property <bool> bt-available: false;
    in-out property <bool> bt-powered: false;
    /// Pareados primeiro (conectados no topo), depois os encontrados.
    in property <[BtDevice]> bt-devices: [];
    /// Nome do aparelho conectado ("" = nenhum), para o painel rápido.
    in property <string> bt-connected: "";
    /// Procurando aparelhos.
    in property <bool> bt-scanning: false;
    /// Aparelho sendo pareado/conectado ("" = nenhum).
    in property <string> bt-busy-mac: "";
    /// Resultado da última ação ou o código de pareamento.
    in-out property <string> bt-message: "";
    callback set-bt(bool);
    callback bt-scan();
    /// Pareia (se `pareado` for falso), confia e conecta.
    callback bt-connect(string /* mac */, string /* nome */, bool /* pareado */);
    callback bt-disconnect(string /* mac */);
    callback bt-forget(string /* mac */);
    /// Quantos aparelhos pareados há no começo da lista.
    pure callback bt-paired-count([BtDevice]) -> int;

    /// "suspend" ou "reboot" (desligar usa `Shell.power-off`).
    callback power-action(string);

    // --- Monitores (wlr-randr, `src/settings/displays.rs`) ---

    /// O `wlr-randr` respondeu e há pelo menos um monitor.
    in property <bool> displays-available: false;
    in property <[DisplayOutput]> displays: [];
    /// Escalas oferecidas (mesma ordem de `SCALES` no Rust).
    out property <[string]> display-scales: ["50%", "75%", "100%", "125%", "150%", "175%", "200%"];
    out property <[float]> display-scale-values: [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0];
    /// Rotações (mesma ordem de `TRANSFORMS` no Rust).
    out property <[string]> display-rotations: ["Normal", @tr("90° (portrait)"), @tr("180° (upside down)"), @tr("270° (portrait)")];
    /// Uma mudança foi aplicada e espera "Manter" (senão volta sozinha).
    in property <bool> display-confirm: false;
    /// Segundos até voltar à configuração anterior.
    in property <int> display-countdown: 0;
    /// Resultado da última ação ("Configuração do monitor salva.").
    in property <string> display-message: "";
    /// Área do desenho do arranjo (px lógicos): fica parada enquanto se
    /// arrasta, com folga em volta para mover os monitores.
    in property <int> display-bounds-x: 0;
    in property <int> display-bounds-y: 0;
    in property <int> display-bounds-w: 1;
    in property <int> display-bounds-h: 1;
    /// Os monitores foram arrastados e a posição ainda não foi aplicada.
    in property <bool> display-arranged: false;
    /// Monitor `índice` solto em (x, y) no arranjo (o Rust encaixa nas bordas).
    callback move-display(int, int, int);
    /// Aplica as posições arrastadas (com a confirmação de 15 s).
    callback apply-arrangement();
    /// Mostra o número de cada monitor na tela dele por 3 s.
    callback identify-displays();
    /// Torna o monitor `índice` o principal (barra e dock).
    callback set-primary-display(int);
    /// Aplica no monitor `índice`: resolução, taxa, escala, rotação e ligado.
    callback apply-display(int, int, int, int, int, bool);
    /// Confirma a mudança aplicada (grava em monitores.conf).
    callback keep-display();
    /// Volta à configuração anterior.
    callback revert-display();

    // --- Idioma e região (src/settings/region.rs) ---
    /// Idiomas, cada um no próprio idioma ("English", "Português (Brasil)").
    in property <[string]> languages: ["English", "Português (Brasil)"];
    in property <int> language-index: 0;
    /// O idioma escolhido não é o da sessão: vale depois de sair e entrar.
    in property <bool> language-pending: false;
    in property <[string]> keyboard-layouts: [@tr("English (US)")];
    /// Layout atual (-1 = um que não está na lista).
    in property <int> keyboard-index: 0;
    in property <string> keyboard-message: "";
    callback set-language(int);

    // --- Compartilhamento (src/settings/sharing.rs) ---
    /// Samba e o script de compartilhamento instalados (sessão real).
    in property <bool> sharing-available: false;
    in-out property <bool> sharing-enabled: false;
    /// Esperando a senha do administrador ou o Samba.
    in property <bool> sharing-busy: false;
    /// Visitantes entram sem senha (só leitura).
    in-out property <bool> sharing-guest: true;
    /// Nome do computador na rede ("kalango").
    in property <string> sharing-name: "kalango";
    in property <[SharedFolder]> sharing-folders: [
        { name: "Public", path: "~/Public", shared: true },
        { name: "Documents", path: "~/Documents", shared: false },
        { name: "Pictures", path: "~/Pictures", shared: false },
        { name: "Music", path: "~/Music", shared: false },
        { name: "Videos", path: "~/Videos", shared: false },
        { name: "Downloads", path: "~/Downloads", shared: false },
    ];
    in-out property <string> sharing-message: "";
    in property <[NetComputer]> computers: [];
    in property <bool> computers-busy: false;
    callback set-sharing(bool);
    callback set-sharing-guest(bool);
    callback toggle-shared-folder(int);
    callback sharing-password();
    callback refresh-computers();
    callback open-computer(int);
    callback browse-network();
    /// Abre um endereço digitado ("192.168.0.10", "\\\\pc\\pasta", "sftp://...").
    callback connect-server(string);
    callback set-keyboard(int);

    // --- Atalhos de teclado (src/settings/shortcuts.rs) ---
    in property <[ShortcutItem]> shortcuts: [];
    in property <string> shortcut-message: "";
    /// Conta as gravações que deram certo (a página fecha o editor).
    in-out property <int> shortcut-saved: 0;
    /// Troca a tecla de um atalho padrão: id, modificadores (1 Super, 2 Ctrl,
    /// 4 Alt, 8 Shift) e o nome da tecla.
    callback set-shortcut(string, int, string);
    callback reset-shortcut(string);
    /// Atalho próprio: nome, comando, modificadores e tecla.
    callback add-shortcut(string, string, int, string);
    callback remove-shortcut(string);

    // --- Firewall (src/settings/firewall.rs) ---
    /// ufw e o script do firewall instalados (sessão real).
    in property <bool> firewall-available: false;
    in-out property <bool> firewall-enabled: false;
    /// Esperando a senha do administrador ou o ufw.
    in property <bool> firewall-busy: false;
    in property <[FirewallRule]> firewall-rules: [];
    in property <string> firewall-message: "";
    /// Conta as mudanças que deram certo (a página limpa o formulário).
    in-out property <int> firewall-added: 0;
    callback set-firewall(bool);
    callback remove-firewall-rule(int);
    /// Ativa/desativa a regra `i` sem tirá-la da lista.
    callback set-firewall-rule(int, bool);
    /// Abrir porta(s): nome, porta ou faixa ("8000", "6000-6010"),
    /// protocolo (0 TCP, 1 UDP, 2 os dois) e só da rede local.
    callback add-firewall-rule(string, string, int, bool);
}

/// Energia (Configurações → Energia, `src/settings/power.rs`). As listas são índices
/// das opções da página (minutos em `BLANK_MINUTES`/`SUSPEND_MINUTES`).
export global Power {
    /// `power-profiles-daemon` instalado e rodando.
    in property <bool> profiles-available: false;
    in property <bool> has-performance: false;
    /// 0 economia, 1 equilibrado, 2 desempenho.
    in-out property <int> profile: 1;
    callback set-profile(int);
    /// Apagar a tela depois de (índice) e suspender na bateria/na tomada.
    in-out property <int> blank: 4;
    in-out property <int> suspend-battery: 3;
    in-out property <int> suspend-ac: 0;
    /// Bloquear a tela ao apagar e antes de suspender.
    in-out property <bool> lock-on-blank: true;
    in property <bool> has-battery: false;
    in property <bool> has-lid: false;
    /// Tampa (na bateria e na tomada): 0 suspender, 1 bloquear, 2 nada, 3 desligar.
    in-out property <int> lid-battery: 0;
    in-out property <int> lid-ac: 0;
    /// Botão de ligar: 0 desligar, 1 suspender, 2 nada.
    in-out property <int> power-button: 0;
    /// Pedindo a senha do administrador (tampa e botão).
    in property <bool> system-busy: false;
    in property <string> message: "";
    /// Grava as escolhas da pessoa (`energia.conf`).
    callback save();
    /// Grava tampa e botão no sistema (pkexec).
    callback save-system();
    /// Arquivo de swap: posição em `power::SWAP_GB` (0 = nenhum, 1 = 2 GB...).
    in-out property <int> swap-size: 0;
    /// Resumo da swap que existe (zram e partição antiga).
    in property <string> swap-summary: "";
    in property <bool> swap-busy: false;
    in-out property <string> swap-message: "";
    /// Cria, troca ou remove o arquivo de swap (pkexec).
    callback set-swap(int);
}

/// Uma conta de pessoa (Configurações → Usuários e tela de login).
export struct UserAccount {
    login: string,
    /// Nome exibido (GECOS) ou o próprio login.
    name: string,
    initial: string,
    admin: bool,
    /// É quem está usando agora.
    me: bool,
    /// Tem uma sessão aberta (não pode ser removida).
    signed-in: bool,
}

/// Usuários (Configurações → Usuários, `src/settings/users.rs`). A própria senha muda
/// pelo `passwd`; o resto (contas de outras pessoas) pelo
/// `pkexec /usr/local/sbin/kalango-usuarios`, com a senha do administrador.
export global Accounts {
    /// A conta de quem está usando.
    in property <UserAccount> me;
    /// As outras contas de pessoas.
    in property <[UserAccount]> others;
    /// Quem está usando é administrador (pode criar e mudar contas).
    in property <bool> can-manage: false;
    /// Formulário aberto: "" nenhum, "password" (a própria senha), "add"
    /// (nova conta) ou "edit" (a conta `editing`). O Rust fecha ("") ao concluir.
    in-out property <string> form: "";
    in-out property <string> editing: "";
    /// Esperando o `passwd` ou a senha do administrador.
    in property <bool> busy: false;
    /// Resultado da última ação (erro em vermelho).
    in-out property <string> message: "";
    in property <bool> message-error: false;
    /// Muda a própria senha (atual, nova).
    callback change-own-password(string, string);
    /// Cria uma conta (nome, login, senha, administrador).
    callback create(string, string, string, bool);
    /// Muda a conta `login`: tipo, nome e (se não vazia) a senha.
    callback update(string /* login */, string /* nome */, bool /* admin */, string /* senha */);
    /// Remove a conta; `delete-files` apaga também a pasta pessoal.
    callback remove(string, bool);
    /// PIN de login e desbloqueio de quem está usando (`kalango-pin estado`):
    /// "" = recurso ausente (protótipo, sistema antigo), "sem", "ativo" ou
    /// "bloqueado" (5 PINs errados; volta ao entrar com a senha).
    in property <string> pin-state: "";
    /// Define ou troca o próprio PIN (senha atual, PIN).
    callback set-pin(string, string);
    /// Remove o próprio PIN.
    callback remove-pin();
    /// Login sugerido a partir do nome ("Maria Silva" → "maria").
    pure callback suggest-login(string) -> string;
    /// Login válido e livre ("" = ok; senão, o motivo).
    pure callback check-login(string) -> string;
}

/// Uma impressora instalada (fila do CUPS).
export struct Printer {
    /// Nome da fila no CUPS.
    name: string,
    /// Descrição (modelo) para mostrar.
    info: string,
    /// Estado em texto ("Pronta", "Imprimindo", "Parada").
    state: string,
    stopped: bool,
    is-default: bool,
    /// Trabalhos na fila.
    jobs: int,
    /// Rede (true) ou cabo USB.
    network: bool,
}

/// Um aparelho encontrado para adicionar (`lpinfo -v`).
export struct PrinterDevice {
    uri: string,
    name: string,
    /// "USB" ou "Rede".
    kind: string,
}

/// Impressoras (Configurações → Impressoras, `src/settings/printers.rs`).
export global Printers {
    /// O CUPS está instalado e respondendo.
    in property <bool> available: false;
    in property <[Printer]> list;
    /// Aparelhos encontrados que ainda não são impressoras.
    in property <[PrinterDevice]> found;
    in property <bool> searching: false;
    in property <bool> busy: false;
    in-out property <string> message: "";
    in property <bool> message-error: false;
    /// Painel "Adicionar impressora" aberto.
    in-out property <bool> adding: false;
    callback search();
    callback add(string /* uri */, string /* nome */);
    /// Adiciona pelo endereço (IP ou nome na rede).
    callback add-address(string);
    callback set-default(string);
    callback test-page(string);
    callback cancel-jobs(string);
    callback remove(string);
    /// Abre o system-config-printer (drivers e opções que a página não tem).
    callback advanced();
}

/// Uma atualização disponível.
export struct UpdateItem {
    name: string,
    /// "1.2 → 1.3".
    version: string,
    /// Sistema (apt) ou app (Flatpak).
    app: bool,
    /// Novidades da versão nova, uma por linha (só nos pacotes do KalangOS,
    /// que as trazem na descrição: `distro/pacotes/novidades`).
    notes: string,
}

/// Atualizações (Configurações → Atualizações, `src/settings/updates.rs`).
export global Updates {
    in property <[UpdateItem]> list;
    /// "idle", "checking", "installing", "done" ou "error".
    in property <string> state: "idle";
    /// 0 a 1 enquanto instala.
    in property <float> progress: 0;
    /// O que está fazendo agora ("Baixando firefox-esr...").
    in property <string> status;
    in property <string> message;
    /// Quando a lista foi atualizada pela última vez ("hoje às 08:12").
    in property <string> last-check;
    /// Alguma atualização pede reiniciar (kernel, systemd, glibc).
    in property <bool> reboot-needed: false;
    callback check();
    callback install();
    callback reboot();
}
