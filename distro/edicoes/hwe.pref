# KalangOS, edição HWE (Hardware Enablement, como o kernel HWE do Ubuntu):
# kernel, Mesa (vídeo) e firmware vêm do
# trixie-backports (versões recentes, assinadas pelo Debian, também com Secure
# Boot). O resto do sistema continua no Debian 13 estável.
# Gerado pelo distro/build.sh com KALANGO_EDICAO=hwe.
Package: linux-image-* linux-headers-* linux-modules-* linux-binary-* linux-base linux-base-* linux-kbuild-* linux-libc-dev linux-sysctl-defaults firmware-* mesa-* libgl1-mesa-dri libegl-mesa0 libglx-mesa0 libgbm1
Pin: release n=trixie-backports
Pin-Priority: 990
