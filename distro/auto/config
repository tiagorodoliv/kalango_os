#!/bin/sh
# Configuração do live-build para a ISO do Kalango OS.
# Roda dentro do chroot "builder" (Debian trixie), chamado por distro/build.sh.
set -e

# noeject: ao desligar, não para pedindo "remova a mídia e aperte ENTER".
# user-fullname: nome exibido no login e no menu (o padrão é "Debian Live user").
# Idioma e teclado padrão: inglês (en_US) e us, para servir a qualquer país;
# o pt_BR também é gerado, para quem troca em Configurações → Idioma e região
# ou instala em português (o Calamares deixa escolher idioma, fuso e teclado).

lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free-firmware" \
	--mirror-bootstrap "${KALANGO_MIRROR:-http://deb.debian.org/debian/}" \
	--mirror-binary "http://deb.debian.org/debian/" \
	--binary-image iso-hybrid \
	--debian-installer none \
	--memtest none \
	--image-name kalango-os \
	--iso-application "Kalango OS" \
	--iso-publisher "Kalango OS" \
	--iso-volume "KALANGO_OS" \
	--bootappend-live "boot=live components noeject quiet splash username=user user-fullname=User hostname=kalango locales=en_US.UTF-8,pt_BR.UTF-8 keyboard-layouts=us timezone=Etc/UTC" \
	"${@}"
