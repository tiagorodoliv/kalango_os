# Executado pelo labwc ao iniciar a sessão.
# Cria ~/Documents, ~/Pictures etc. na primeira sessão (nomes no idioma do
# sistema: ~/Documentos, ~/Imagens em português).
xdg-user-dirs-update
# Janela de senha do administrador (polkit): a Loja instala apps por ela.
lxpolkit &
# Saída do shell vai para o journal: journalctl -t kalango-shell
systemd-cat -t kalango-shell kalango-shell-sessao &
