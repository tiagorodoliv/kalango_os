#!/bin/sh
# Inicia a sessão gráfica do Kalango OS (chamado pelo greetd).
#
# Em máquina virtual, o labwc (wlroots) desenhando com OpenGL na GPU virtual
# deixa blocos pretos e restos de imagem na tela (atualização parcial errada).
# Compor a tela por software (pixman) e desenhar o cursor por software
# resolve; os apps continuam usando a GPU virtual para desenhar a si mesmos.
if systemd-detect-virt -q; then
	export WLR_RENDERER=pixman
	export WLR_NO_HARDWARE_CURSORS=1
fi
# Assento (vídeo, teclado, mouse) sempre pelo logind. O seatd também vem
# instalado, e a libseat usa ele para quem está no grupo video: aí a tela de
# login (logind) e as sessões das pessoas (seatd) brigavam pelo vídeo, e a
# sessão aberta por "Trocar de usuário" caía na hora. Só o logind sabe ter
# várias sessões abertas no mesmo computador.
export LIBSEAT_BACKEND=logind
# O labwc só procura a pasta de configuração do usuário ao iniciar: sem ela,
# o rc.xml que o shell grava depois (margens da dock, src/shell/labwc.rs) nunca é
# lido, nem com `labwc --reconfigure`. Vazia, não muda nada: cada arquivo que
# falta continua vindo de /etc/xdg/labwc.
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/labwc"
# Apps do Flatpak (Flathub) no menu e na Loja: o /etc/profile.d/flatpak.sh
# acrescenta as pastas deles ao XDG_DATA_DIRS (o greetd não roda um shell de
# login, então ele não seria lido sozinho).
if [ -r /etc/profile.d/flatpak.sh ]; then
	. /etc/profile.d/flatpak.sh
fi
# Variáveis da sessão. Ficam aqui, e não em /etc/xdg/labwc/environment: o
# labwc lê um só arquivo "environment", e o ~/.config/labwc/environment que
# o shell grava ao trocar o teclado (src/settings/region.rs) esconderia o do sistema.
# Liga o modo real do kalango-shell: abre os apps instalados (src/shell/session.rs).
export KALANGO_SESSION=1
# Tema escuro nos apps libadwaita (Loja, Agenda). Eles só leem a preferência
# pelo portal de configurações, que a sessão labwc não tem.
export ADW_DEBUG_COLOR_SCHEME=prefer-dark
# Apps GTK/Qt/Firefox nativos em Wayland.
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
# Idioma e teclado (/usr/local/lib/kalango/regiao.sh): inglês e teclado us
# por padrão, ou o que o sistema e o usuário escolheram.
. /usr/local/lib/kalango/regiao.sh
kalango_regiao
# Os serviços da sessão iniciados pelo D-Bus/systemd --user (gvfs do Arquivos,
# portais...) herdam o idioma do login, não o daqui: atualiza os dois.
dbus-update-activation-environment --systemd LANG LANGUAGE 2>/dev/null || true
# Erros do labwc no journal (`journalctl -t labwc`): sem isso iam para o VT,
# e uma sessão que não abre não deixava rastro.
exec systemd-cat -t labwc labwc
