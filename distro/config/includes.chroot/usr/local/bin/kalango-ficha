#!/bin/sh
# Ficha do sistema do KalangOS: o ícone ao lado das informações (fastfetch).
#
# O ícone é desenhado pelo chafa: no foot sai como imagem de verdade (sixel),
# no tamanho certo para a fonte; pela SSH, imagem se o terminal de quem
# conecta mostrar sixel (pergunta a ele), senão símbolos coloridos. O
# fastfetch escreve as informações ao lado, com um logotipo "vazio" da mesma
# largura. Sem o chafa (ou fora de um terminal), o logotipo em blocos do
# config.jsonc.
#
# Uso:
#   kalango-ficha            mostra a ficha
#   kalango-ficha --uma-vez  só no primeiro terminal de cada sessão (entrar no
#                            sistema, cada conexão SSH); é o que o ~/.zshrc usa
# Para nunca aparecer ao abrir o terminal: touch ~/.config/kalango/sem-fastfetch

ICONE=/usr/share/kalango/fastfetch/kalango.png
COLUNAS=20  # largura do ícone em caracteres
LINHAS=10   # altura máxima do ícone em linhas

if [ "$1" = --uma-vez ]; then
	shift
	[ -e "$HOME/.config/kalango/sem-fastfetch" ] && exit 0
	# Marca por sessão do logind (a gráfica e cada SSH têm a sua); a pasta
	# do XDG_RUNTIME_DIR some ao sair. Sem sessão, vale por boot.
	sessao=${XDG_SESSION_ID:-$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)}
	pasta=${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}
	marca="$pasta/kalango-ficha.$sessao"
	[ -e "$marca" ] && exit 0
	mkdir -p "$pasta" 2>/dev/null && : >"$marca" 2>/dev/null
fi

command -v fastfetch >/dev/null 2>&1 || exit 0
if ! command -v chafa >/dev/null 2>&1 || [ ! -r "$ICONE" ] || [ ! -t 1 ]; then
	exec fastfetch "$@"
fi

# Pela SSH o TERM chega como "xterm-256color" e o chafa não sabe se o terminal
# de quem conecta mostra imagens: pergunta a ele (Primary Device Attributes,
# ESC [ c; o "4" na resposta é sixel), esperando no máximo 0,3 s.
formato=
terminal_tem_sixel() {
	[ -t 0 ] || return 1
	antes=$(stty -g 2>/dev/null) || return 1
	stty raw -echo min 0 time 3 2>/dev/null
	printf '\033[c'
	resposta=$(dd bs=128 count=1 2>/dev/null)
	stty "$antes" 2>/dev/null
	# "ESC [ ? 62 ; 4 ; 22 c" → ";62;4;22;"
	params=";$(printf '%s' "$resposta" | sed -n 's/.*\[?\([0-9;]*\)c.*/\1/p');"
	case "$params" in *";4;"*) return 0 ;; esac
	return 1
}
if [ -n "$SSH_CONNECTION" ] && terminal_tem_sixel; then
	formato=--format=sixels
fi

# Abre espaço antes (se a tela precisar rolar, rola agora) e volta para o
# começo dele: assim o cursor guardado é o canto de cima do ícone.
i=0
while [ "$i" -le "$LINHAS" ]; do printf '\n'; i=$((i + 1)); done
printf '\033[%dA' "$LINHAS"
printf '\0337'
chafa $formato --size="${COLUNAS}x${LINHAS}" --animate=off --polite=on "$ICONE" 2>/dev/null
printf '\0338'
# Logotipo "vazio" de COLUNAS espaços: o fastfetch mede a largura pelo
# conteúdo (o --logo-width não vale para data-raw).
exec fastfetch --logo-type data-raw --logo "$(printf "%${COLUNAS}s" '')" \
	--logo-padding-top 0 --logo-padding-left 0 "$@"
