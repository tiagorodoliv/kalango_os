#!/bin/sh
# Teclas de mídia do KalangOS (volume, brilho, player), ligadas no rc.xml do
# labwc. Volume, microfone e brilho aparecem no aviso flutuante acima da dock
# (kalango-shell --osd=..., src/shell/osd.rs); sem ele, no centro da barra
# (arquivo $XDG_RUNTIME_DIR/kalango-aviso).
#
#   kalango-midia volume-mais | volume-menos | mudo | microfone
#   kalango-midia brilho-mais | brilho-menos
#   kalango-midia tocar | proxima | anterior | parar
set -u

SAIDA=@DEFAULT_AUDIO_SINK@
ENTRADA=@DEFAULT_AUDIO_SOURCE@

# Português se a sessão estiver em português.
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in pt*) PT=1 ;; *) PT= ;; esac
t() { if [ -n "$PT" ]; then echo "$2"; else echo "$1"; fi; }

# Segurando a tecla, o labwc repete o atalho várias vezes por segundo: se o
# aperto anterior ainda está rodando, este é descartado (sem fila de processos).
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
	exec 9>"$XDG_RUNTIME_DIR/kalango-midia.lock"
	flock -n 9 || exit 0
fi

avisar() {
	[ -n "${XDG_RUNTIME_DIR:-}" ] && printf '%s' "$1" >"$XDG_RUNTIME_DIR/kalango-aviso"
}

# Lê o volume: NIVEL (0–100) e MUDO (1/0). Sempre com LC_ALL=C: com os
# formatos em português (LC_NUMERIC=pt_BR, o padrão do instalador no Brasil) o
# awk lia "0.45" como 0 e o aviso mostrava 0% ou 100%.
ler_volume() {
	v=$(LC_ALL=C wpctl get-volume "$1" 2>/dev/null) || return 1
	NIVEL=$(printf '%s\n' "$v" | LC_ALL=C awk '{ printf "%d", $2 * 100 + 0.5 }')
	case "$v" in *MUTED*) MUDO=1 ;; *) MUDO=0 ;; esac
}

# Aviso flutuante (TIPO NÍVEL [MUDO]); sem ele, o texto na barra. O "9>&-"
# fecha a trava no processo do aviso, que fica aberto depois deste script.
mostrar() {
	if [ "${3:-0}" = 1 ]; then pedido="$1:mudo:$2"; else pedido="$1:$2"; fi
	kalango-shell --osd="$pedido" 9>&- 2>/dev/null && return
	case "$1" in
	volume) nome=$(t Volume Volume) ;;
	microfone) nome=$(t Microphone Microfone) ;;
	*) nome=$(t Brightness Brilho) ;;
	esac
	if [ "${3:-0}" = 1 ]; then avisar "$nome $(t muted mudo)"; else avisar "$nome $2%"; fi
}

volume() {
	ler_volume "$SAIDA" && mostrar volume "$NIVEL" "$MUDO"
}

brilho() {
	b=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%')
	[ -n "$b" ] && mostrar brilho "$b"
}

case "${1:-}" in
volume-mais)
	# Tira o mudo junto (em paralelo): subir o volume mudo não faria som.
	wpctl set-mute "$SAIDA" 0 &
	wpctl set-volume -l 1.0 "$SAIDA" 5%+
	wait
	volume
	;;
volume-menos)
	wpctl set-volume "$SAIDA" 5%-
	volume
	;;
mudo)
	wpctl set-mute "$SAIDA" toggle
	volume
	;;
microfone)
	wpctl set-mute "$ENTRADA" toggle
	ler_volume "$ENTRADA" && mostrar microfone "$NIVEL" "$MUDO"
	;;
brilho-mais)
	brightnessctl -q set 5%+ && brilho
	;;
brilho-menos)
	# Nunca apaga a tela de todo (mínimo de 1%).
	brightnessctl -q -n1 set 5%- && brilho
	;;
tocar) playerctl play-pause ;;
proxima) playerctl next ;;
anterior) playerctl previous ;;
parar) playerctl stop ;;
*)
	echo "uso: kalango-midia volume-mais|volume-menos|mudo|microfone|brilho-mais|brilho-menos|tocar|proxima|anterior|parar" >&2
	exit 1
	;;
esac
exit 0
