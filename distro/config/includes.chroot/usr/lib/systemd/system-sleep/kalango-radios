#!/bin/sh
# Wi-Fi e Bluetooth de volta depois de suspender/hibernar (Kalango OS).
#
# Em algumas placas combo (ex.: Intel Wireless 3160/7260 em notebooks HP), ao
# voltar da suspensão o driver lê o rádio como bloqueado por hardware
# ("RF_KILL bit toggled to disable radio"), que o botão de Wi-Fi não desfaz, e
# a parte Bluetooth (USB) some do barramento. Antes de dormir este script
# guarda como estavam os rádios; ao voltar, só mexe no que quebrou:
#   1. Wi-Fi bloqueado por hardware (e antes não estava) ou sumido: recarrega o
#      driver; se continuar, tira o dispositivo PCI e procura de novo.
#   2. Bluetooth que existia e sumiu: recarrega o btusb; se continuar, religa
#      o hub USB onde ele estava.
# Tudo vai para o journal: journalctl -t kalango-radios
#
# Argumentos do systemd-sleep: $1 = pre|post, $2 = suspend|hibernate|...

ESTADO=/run/kalango-radios
log() { logger -t kalango-radios "$*"; }

# Dispositivo PCI e driver de cada placa Wi-Fi: "pci driver".
placas_wifi() {
    for phy in /sys/class/ieee80211/*; do
        [ -e "$phy/device" ] || continue
        dev=$(readlink -f "$phy/device")
        drv=$(basename "$(readlink -f "$dev/driver")")
        echo "$(basename "$dev") $drv"
    done
}

# Bloqueio por hardware dos rádios Wi-Fi (1 se algum estiver bloqueado).
wifi_bloqueado() {
    for r in /sys/class/rfkill/*; do
        [ "$(cat "$r/type" 2>/dev/null)" = wlan ] || continue
        [ "$(cat "$r/hard" 2>/dev/null)" = 1 ] && { echo 1; return; }
    done
    echo 0
}

# Hubs USB onde estão os adaptadores Bluetooth (pasta em /sys/bus/usb/devices).
hubs_bluetooth() {
    for h in /sys/class/bluetooth/hci*; do
        # hci0:256... são conexões (mouse, teclado), não adaptadores.
        case "$(basename "$h")" in *:*) continue ;; esac
        [ -e "$h/device" ] || continue
        intf=$(readlink -f "$h/device")
        case "$intf" in */usb*) ;; *) continue ;; esac
        # .../1-1/1-1.7/1-1.7:1.0 → hub 1-1
        basename "$(dirname "$(dirname "$intf")")"
    done
}

conta_bluetooth() { ls -d /sys/class/bluetooth/hci* 2>/dev/null | grep -c 'hci[0-9]*$'; }

recarregar_driver() {
    case "$1" in
        iwlwifi) modprobe -r iwlmvm iwldvm iwlwifi 2>/dev/null; modprobe iwlwifi ;;
        *) modprobe -r "$1" 2>/dev/null; modprobe "$1" ;;
    esac
}

antes() {
    mkdir -p "$ESTADO"
    placas_wifi >"$ESTADO/wifi"
    wifi_bloqueado >"$ESTADO/bloqueado"
    hubs_bluetooth | sort -u >"$ESTADO/hubs"
    conta_bluetooth >"$ESTADO/bluetooth"
}

consertar_wifi() {
    [ -s "$ESTADO/wifi" ] || return 0
    [ "$(cat "$ESTADO/bloqueado")" = 0 ] || return 0
    sleep 2
    [ "$(wifi_bloqueado)" = 0 ] && [ -n "$(placas_wifi)" ] && return 0
    while read -r pci drv; do
        log "Wi-Fi bloqueado ou sumido depois de $1: recarregando $drv ($pci)"
        recarregar_driver "$drv"
        sleep 3
        [ "$(wifi_bloqueado)" = 0 ] && [ -n "$(placas_wifi)" ] && { log "Wi-Fi de volta"; continue; }
        log "ainda bloqueado: procurando o dispositivo PCI $pci de novo"
        [ -e "/sys/bus/pci/devices/$pci/remove" ] && echo 1 >"/sys/bus/pci/devices/$pci/remove"
        sleep 1
        echo 1 >/sys/bus/pci/rescan
        sleep 3
        if [ "$(wifi_bloqueado)" = 0 ] && [ -n "$(placas_wifi)" ]; then
            log "Wi-Fi de volta"
        else
            log "Wi-Fi continua bloqueado por hardware (tecla de modo avião/BIOS?)"
        fi
    done <"$ESTADO/wifi"
}

consertar_bluetooth() {
    antes_bt=$(cat "$ESTADO/bluetooth" 2>/dev/null || echo 0)
    [ "$antes_bt" -gt 0 ] || return 0
    sleep 2
    [ "$(conta_bluetooth)" -ge "$antes_bt" ] && return 0
    log "Bluetooth sumiu depois de $1: recarregando btusb"
    modprobe -r btusb 2>/dev/null
    modprobe btusb
    sleep 3
    [ "$(conta_bluetooth)" -ge "$antes_bt" ] && { log "Bluetooth de volta"; return 0; }
    while read -r hub; do
        a="/sys/bus/usb/devices/$hub/authorized"
        [ -e "$a" ] || continue
        log "religando o hub USB $hub"
        echo 0 >"$a"
        sleep 1
        echo 1 >"$a"
    done <"$ESTADO/hubs"
    sleep 3
    if [ "$(conta_bluetooth)" -ge "$antes_bt" ]; then
        log "Bluetooth de volta"
    else
        log "Bluetooth continua sumido"
    fi
}

case "$1" in
    pre) antes ;;
    post)
        [ -d "$ESTADO" ] || exit 0
        consertar_wifi "$2"
        consertar_bluetooth "$2"
        ;;
esac
exit 0
