# Padrões do KalangOS. Compilado pelo hook 0100-kalango-schemas.hook.chroot.
#
# Tema GTK 3 "Kalango", ícones "Kalango-Ciano" (o shell troca a variante junto
# com a cor de destaque) e, nos apps libadwaita (Loja, Agenda), o tema escuro.
[org.gnome.desktop.interface]
color-scheme='prefer-dark'
gtk-theme='Kalango'
icon-theme='Kalango-Ciano'
font-name='Inter 10'
monospace-font-name='JetBrains Mono 10'

# Botões das janelas que desenham a própria barra (GTK 4/libadwaita: Loja,
# Agenda): minimizar, maximizar e fechar, como nas outras janelas.
[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'

# Mousepad (texto simples): mesmas cores do editor de código e do sistema.
[org.xfce.mousepad.preferences.view]
color-scheme='kalango'
show-line-numbers=true
highlight-current-line=true
match-braces=true
use-default-monospace-font=false
font-name='JetBrains Mono 11'
tab-width=4
