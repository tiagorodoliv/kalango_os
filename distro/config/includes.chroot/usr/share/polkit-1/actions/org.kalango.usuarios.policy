<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Configurações → Usuários: criar, remover e mudar contas de outras pessoas
     (/usr/local/sbin/kalango-usuarios). Senha do administrador, lembrada por alguns minutos. -->
<policyconfig>
  <vendor>KalangOS</vendor>
  <action id="org.kalango.usuarios">
    <description>Manage user accounts</description>
    <description xml:lang="pt_BR">Gerenciar contas de usuário</description>
    <message>Authentication is required to change user accounts</message>
    <message xml:lang="pt_BR">É preciso autenticar para mudar as contas de usuário</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/kalango-usuarios</annotate>
  </action>
</policyconfig>
