<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Configurações → Energia: o que a tampa e o botão de ligar fazem
     (systemd-logind, vale para todos). Senha do administrador, lembrada por alguns minutos. -->
<policyconfig>
  <vendor>KalangOS</vendor>
  <action id="org.kalango.energia">
    <description>Change what the lid and the power button do</description>
    <description xml:lang="pt_BR">Mudar o que a tampa e o botão de ligar fazem</description>
    <message>Authentication is required to change the power settings</message>
    <message xml:lang="pt_BR">É preciso autenticar para mudar as configurações de energia</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/kalango-energia</annotate>
  </action>
</policyconfig>
