<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Configurações → Impressoras, para quem não está no grupo lpadmin
     (/usr/local/sbin/kalango-impressoras). Senha do administrador, lembrada por alguns minutos. -->
<policyconfig>
  <vendor>KalangOS</vendor>
  <action id="org.kalango.impressoras">
    <description>Manage printers</description>
    <description xml:lang="pt_BR">Gerenciar impressoras</description>
    <message>Authentication is required to change the printers</message>
    <message xml:lang="pt_BR">É preciso autenticar para mudar as impressoras</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/kalango-impressoras</annotate>
  </action>
</policyconfig>
