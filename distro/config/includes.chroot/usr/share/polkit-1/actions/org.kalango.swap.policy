<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Configurações → Energia → Memória de troca (/usr/local/sbin/kalango-swap).
     Senha do administrador, lembrada por alguns minutos. -->
<policyconfig>
  <vendor>KalangOS</vendor>
  <action id="org.kalango.swap">
    <description>Change the swap file</description>
    <description xml:lang="pt_BR">Mudar o arquivo de swap</description>
    <message>Authentication is required to change the swap file</message>
    <message xml:lang="pt_BR">É preciso autenticar para mudar o arquivo de swap</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/kalango-swap</annotate>
  </action>
</policyconfig>
