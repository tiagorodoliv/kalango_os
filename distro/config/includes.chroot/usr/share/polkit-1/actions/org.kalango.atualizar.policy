<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Configurações → Atualizações (/usr/local/sbin/kalango-atualizar).
     Senha do administrador, lembrada por alguns minutos. -->
<policyconfig>
  <vendor>Kalango OS</vendor>
  <action id="org.kalango.atualizar">
    <description>Install system updates</description>
    <description xml:lang="pt_BR">Instalar atualizações do sistema</description>
    <message>Authentication is required to update the system</message>
    <message xml:lang="pt_BR">É preciso autenticar para atualizar o sistema</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/kalango-atualizar</annotate>
  </action>
</policyconfig>
