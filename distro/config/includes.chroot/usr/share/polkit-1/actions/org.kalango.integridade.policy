<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Aviso de interface mudada (/usr/local/sbin/kalango-integridade).
     Senha do administrador SEMPRE (sem lembrar): aceitar uma mudança nos
     arquivos da interface tem de ser uma decisão consciente. -->
<policyconfig>
  <vendor>KalangOS</vendor>
  <action id="org.kalango.integridade">
    <description>Accept or undo changes to the KalangOS interface files</description>
    <description xml:lang="pt_BR">Aceitar ou desfazer mudanças nos arquivos da interface do KalangOS</description>
    <message>Authentication is required to accept or undo changes to the KalangOS interface</message>
    <message xml:lang="pt_BR">É preciso a senha do administrador para aceitar ou desfazer mudanças na interface do KalangOS</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/kalango-integridade</annotate>
  </action>
</policyconfig>
