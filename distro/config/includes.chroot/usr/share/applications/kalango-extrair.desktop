[Desktop Entry]
# Dois cliques num arquivo compactado extrai ao lado dele, como no macOS:
# vários arquivos dentro → pasta com o nome do compactado; um só → o arquivo.
# Padrão para os tipos compactados em /etc/xdg/mimeapps.list; para abrir sem
# extrair: botão direito → Abrir com "Gerenciador de compactados".
Type=Application
Name=Extract here
Name[pt_BR]=Extrair aqui
Comment=Extract the archive next to it
Comment[pt_BR]=Extrai o arquivo compactado ao lado dele
Exec=file-roller --extract-here %F
Icon=org.gnome.FileRoller
NoDisplay=true
Terminal=false
MimeType=application/zip;application/x-zip-compressed;application/x-tar;application/gzip;application/x-gzip;application/x-compressed-tar;application/x-bzip2;application/x-bzip;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/x-lzma;application/x-lzma-compressed-tar;application/zstd;application/x-zstd-compressed-tar;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;
