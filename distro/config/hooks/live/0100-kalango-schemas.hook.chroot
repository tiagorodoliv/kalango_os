#!/bin/sh
# Recompila os schemas do GSettings para valer o override do Kalango OS
# (usr/share/glib-2.0/schemas/90_kalango.gschema.override) e gera o índice dos
# temas de ícones: o live-build copia os includes depois de instalar os
# pacotes, sem recompilar.
set -e
glib-compile-schemas /usr/share/glib-2.0/schemas

# Índice dos temas de ícones do Kalango (abre as pastas mais rápido).
if command -v gtk-update-icon-cache >/dev/null; then
	for tema in /usr/share/icons/Flat-Remix-* /usr/share/icons/Kalango-*; do
		gtk-update-icon-cache -f -t "$tema"
	done
fi
