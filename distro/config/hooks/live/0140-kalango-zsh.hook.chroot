#!/bin/sh
# KalangOS: zsh com o prompt no estilo do Kali (/etc/skel/.zshrc) é o shell
# padrão de quem for criado depois: o usuário da ISO live (live-config usa o
# adduser), o do instalador (Calamares, módulo users) e o useradd.
set -e

# adduser (live-config e "adduser fulano")
if [ -f /etc/adduser.conf ]; then
	sed -i 's|^#\?DSHELL=.*|DSHELL=/bin/zsh|' /etc/adduser.conf
fi

# useradd
if grep -q '^SHELL=' /etc/default/useradd 2>/dev/null; then
	sed -i 's|^SHELL=.*|SHELL=/bin/zsh|' /etc/default/useradd
else
	echo 'SHELL=/bin/zsh' >> /etc/default/useradd
fi

# Calamares (calamares-settings-debian). Desde o Calamares 3.3 o shell vem
# SÓ de `user:` → `shell:`; a chave antiga `userShell` é ignorada (o 3.3.14 do
# trixie criava o usuário com /bin/bash e o prompt do Kali nunca aparecia na
# instalação limpa). A antiga fica também, para versões anteriores.
USERS=/etc/calamares/modules/users.conf
if [ -f "$USERS" ]; then
	if grep -q '^userShell:' "$USERS"; then
		sed -i 's|^userShell:.*|userShell: /bin/zsh|' "$USERS"
	else
		echo 'userShell: /bin/zsh' >> "$USERS"
	fi
	if grep -q '^user:' "$USERS"; then
		# Já existe o mapa `user:` (só ele tem a chave shell indentada).
		if grep -q '^[[:space:]]\+shell:' "$USERS"; then
			sed -i 's|^\([[:space:]]\+\)shell:.*|\1shell: /bin/zsh|' "$USERS"
		else
			sed -i 's|^user:.*|user:\n  shell: /bin/zsh|' "$USERS"
		fi
	else
		printf 'user:\n  shell: /bin/zsh\n' >> "$USERS"
	fi
fi
