# Pacotes da imagem do KalangOS (Debian trixie).

# Live: boot pela ISO e criação do usuário "user" no boot
live-boot
live-config
live-config-systemd
user-setup
sudo

# Sessão gráfica: greetd (login) -> labwc (compositor Wayland) -> kalango-shell
greetd
labwc
xwayland
dbus-user-session

# Gráficos e bibliotecas usadas pelo kalango-shell (Slint, backend winit; o
# renderer padrão é o de software, o OpenGL só com KALANGO_RENDERER=gl)
libgl1-mesa-dri
libegl1
libwayland-egl1
libxkbcommon0
libfontconfig1

# Memória comprimida (zram) no lugar do swap em disco: metade da RAM, até
# 4 GB (padrão do pacote). Faz muita diferença em máquina com 2–4 GB.
systemd-zram-generator

# Apps reais abertos pela dock e pelo menu (ver src/shell/session.rs)
thunar
# Miniaturas de fotos e vídeos no Thunar
tumbler
foot
# Terminal no estilo do Kali: zsh (shell padrão, hook 0140) com sugestões e
# destaque de sintaxe; o ㉿ do prompt vem da fonte Droid Sans Fallback
zsh
zsh-autosuggestions
zsh-syntax-highlighting
fonts-droid-fallback
firefox-esr
firefox-esr-l10n-pt-br
mousepad
# Editor de código ("Código" da dock), com o tema Dark Modern do VS Code
geany
ristretto
htop
parole
xdg-user-dirs

# Agente do polkit: a janela que pede a senha do administrador (Loja,
# atualizações, apps que usam pkexec). Iniciado no autostart do labwc.
lxpolkit

# Bloqueio de tela (Super+L): protocolo ext-session-lock do Wayland
swaylock
# Tela de bloqueio com relógio, usuário e senha (kalango-bloquear); o swaylock
# fica de reserva
gtklock
# Energia (src/settings/power.rs): apagar a tela e suspender sozinho (swayidle + wlopm)
# e modo de energia (economia/equilibrado/desempenho).
swayidle
wlopm
power-profiles-daemon
gtklock-userinfo-module
# nome e foto do usuário na tela de bloqueio (e nas Configurações → Usuários)
accountsservice

# Loja (GNOME Software via PackageKit) e Agenda. Com o plugin flatpak, a Loja
# mostra também os apps do Flathub (configurado pelo hook 0110).
gnome-software
gnome-software-plugin-flatpak
flatpak
gnome-calendar
# Abrir arquivos recentes no app padrão (xdg-open)
xdg-utils

# Instalador (só usado na ISO live; removido do sistema instalado)
calamares
calamares-settings-debian

# Rede e som (Wi-Fi da barra abre o nmtui; volume abre o pavucontrol)
network-manager
# VPN: OpenVPN e WireGuard pelo NetworkManager (Configurações → Rede → VPN);
# wireguard-tools gera as chaves e o zenity abre a janela de escolher arquivo
network-manager-openvpn
wireguard-tools
zenity
# gdbus: cria a conexão WireGuard pelo D-Bus (o nmcli import já a ligaria)
libglib2.0-bin
# Bluetooth (Configurações → Bluetooth e o painel rápido); o som dos fones
# vem do libspa-0.2-bluetooth (PipeWire)
bluez
libspa-0.2-bluetooth
pipewire-audio
wireplumber
pavucontrol

# Monitores (Configurações → Monitores): resolução, escala e rotação
wlr-randr
# Traz para a frente uma janela já aberta (Configurações abertas de novo pelo
# menu): o protocolo wlr-foreign-toplevel do labwc (session::raise).
wlrctl

# Idioma e fontes (as fontes do shell já vão embutidas no binário)
locales
keyboard-configuration
fonts-inter
fonts-jetbrains-mono

# Rede local (Configurações → Compartilhamento e "Rede" no Arquivos):
# gvfs-backends dá ao Thunar smb://, sftp://, a pasta "Rede" e celulares
# (MTP); avahi + libnss-mdns acham e resolvem os computadores (nome.local);
# avahi-utils lista os compartilhamentos achados (avahi-browse).
gvfs-backends
gvfs-fuse
avahi-daemon
avahi-utils
libnss-mdns
smbclient
# Compartilhar pastas (começa desligado; ver hook 0120 e
# /usr/local/sbin/kalango-compartilhar): Samba e o wsdd2, que faz o
# computador aparecer na "Rede" do Windows 10/11.
samba
wsdd2

# Impressoras (Configurações → Impressoras, src/settings/printers.rs): CUPS;
# cups-browsed e ipp-usb fazem as impressoras de rede e as USB modernas
# aparecerem sozinhas, sem driver (IPP Everywhere). Drivers das marcas comuns
# para as USB antigas; system-config-printer = "Opções avançadas".
cups
cups-browsed
ipp-usb
system-config-printer
hplip
printer-driver-escpr
printer-driver-brlaser
printer-driver-gutenprint

# Apps padrão (2026-11-15): PDF, compactados (dois cliques extrai, como no
# macOS: /usr/share/applications/kalango-extrair.desktop) e Office.
evince
file-roller
thunar-archive-plugin
7zip
unar
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gtk3
libreoffice-l10n-pt-br
fonts-crosextra-carlito
fonts-crosextra-caladea
